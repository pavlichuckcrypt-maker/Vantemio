+QString GatewayService::handleContentProfile(const QString &requestId, const QJsonObject &params) const
+{
+    // ПОДСКАЗКИ (не рамки!): рекомендуемые диапазоны под тип материала. Мозг свободно
+    // выходит за них — это лишь ускоряет решения для разнородного контента.
+    const QString type = params.value(QStringLiteral("type")).toString();
+    QJsonObject hints;
+    if (type == QStringLiteral("foto") || type == QStringLiteral("photo")) {
+        hints = QJsonObject{
+            {QStringLiteral("clip_duration_sec"), QJsonArray{4, 12}},
+            {QStringLiteral("ken_burns_zoom"), QJsonArray{1.0, 1.15}},
+            {QStringLiteral("suggested_effects"), QJsonArray{QStringLiteral("avfilter.colortemperature"), QStringLiteral("avfilter.unsharp"), QStringLiteral("apply_lut")}},
+            {QStringLiteral("transition"), QStringLiteral("dissolve 0.5-1.0s")},
+        };
+    } else if (type == QStringLiteral("blender")) {
+        hints = QJsonObject{
+            {QStringLiteral("import_as"), QStringLiteral("video")},
+            {QStringLiteral("clip_duration_sec"), QJsonArray{2, 30}},
+            {QStringLiteral("suggested_effects"), QJsonArray{QStringLiteral("avfilter.colorbalance")}},
+            {QStringLiteral("note"), QStringLiteral("Готовый рендер Blender — обычно без Ken Burns.")},
+        };
+    } else if (type == QStringLiteral("ai_video") || type == QStringLiteral("vishka")) {
+        hints = QJsonObject{
+            {QStringLiteral("import_as"), QStringLiteral("video")},
+            {QStringLiteral("trim"), QStringLiteral("часто нужен trim_clip лучшего куска")},
+            {QStringLiteral("clip_duration_sec"), QJsonArray{2, 10}},
+            {QStringLiteral("suggested_effects"), QJsonArray{QStringLiteral("avfilter.colorcorrect"), QStringLiteral("apply_lut")}},
+        };
+    } else if (type == QStringLiteral("documentary") || type == QStringLiteral("doc")) {
+        hints = QJsonObject{
+            {QStringLiteral("clip_duration_sec"), QJsonArray{8, 60}},
+            {QStringLiteral("subtitles"), true},
+            {QStringLiteral("audio_duck_level"), 0.25},
+            {QStringLiteral("suggested_effects"), QJsonArray{QStringLiteral("avfilter.colorbalance"), QStringLiteral("avfilter.exposure")}},
+        };
+    } else {
+        return GatewayProtocol::successResponse(QStringLiteral("content_profile"), requestId, projectId(), timelineRevision(),
+            QJsonObject{{QStringLiteral("known_types"), QJsonArray{QStringLiteral("foto"), QStringLiteral("blender"), QStringLiteral("ai_video"), QStringLiteral("documentary")}},
+                        {QStringLiteral("note"), QStringLiteral("Передай type. Это подсказки, не обязательная рамка.")}});
+    }
+    return GatewayProtocol::successResponse(QStringLiteral("content_profile"), requestId, projectId(), timelineRevision(),
+        QJsonObject{{QStringLiteral("type"), type}, {QStringLiteral("hints"), hints}, {QStringLiteral("note"), QStringLiteral("Подсказки, не рамки — мозг свободно меняет.")}});
+}
