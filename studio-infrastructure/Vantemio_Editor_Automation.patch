+QString GatewayService::handleQtInvoke(const QString &requestId, const QJsonObject &params)
+{
+    QObject *o = gw_resolveObject(params.value(QStringLiteral("id")).toString());
+    const QString method = params.value(QStringLiteral("method")).toString();
+    const QJsonArray jsonArgs = params.value(QStringLiteral("args")).toArray();
+    if (o == nullptr || method.isEmpty()) {
+        return GatewayProtocol::errorResponse(QStringLiteral("qt_invoke"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("object_not_found"), QStringLiteral("qt_invoke requires a valid id and method."));
+    }
+    if (jsonArgs.size() > 4) {
+        return GatewayProtocol::errorResponse(QStringLiteral("qt_invoke"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("too_many_arguments"), QStringLiteral("qt_invoke supports up to 4 arguments."));
+    }
+    // БЕЗОПАСНОСТЬ: не давать через универсальный слой дёргать разрушающие/жизненно-опасные
+    // слоты — они рушат объекты, по которым потом пройдётся event loop, или гасят приложение.
+    static const QSet<QString> gwBlockedMethods{
+        QStringLiteral("deleteLater"), QStringLiteral("close"), QStringLiteral("quit"),
+        QStringLiteral("terminate"), QStringLiteral("kill"), QStringLiteral("setParent"),
+        QStringLiteral("moveToThread"), QStringLiteral("removeEventFilter"), QStringLiteral("event")
+    };
+    if (gwBlockedMethods.contains(method) || method.startsWith(QStringLiteral("delete"))) {
+        return GatewayProtocol::errorResponse(QStringLiteral("qt_invoke"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("method_blocked"), QStringLiteral("Метод запрещён в qt_invoke (разрушающий/опасный): ") + method);
+    }
+    // Найти метод по имени и числу аргументов.
+    const QMetaObject *mo = o->metaObject();
+    QMetaMethod chosen;
+    bool found = false;
+    for (int i = 0; i < mo->methodCount(); ++i) {
+        const QMetaMethod m = mo->method(i);
+        if (QString::fromUtf8(m.name()) == method && m.parameterCount() == jsonArgs.size()) {
+            chosen = m;
+            found = true;
+            break;
+        }
+    }
+    if (!found) {
+        return GatewayProtocol::errorResponse(QStringLiteral("qt_invoke"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("method_not_found"), QStringLiteral("No method matched the requested name and argument count."));
+    }
+    // Преобразовать аргументы к типам параметров метода.
+    QVariant vargs[4];
+    QGenericArgument gargs[4];
+    for (int i = 0; i < jsonArgs.size(); ++i) {
+        vargs[i] = gw_jsonToVariant(jsonArgs.at(i));
+        const int paramType = chosen.parameterType(i);
+        // БЕЗОПАСНОСТЬ: constData() ниже трактуется методом как объект типа paramType.
+        // Если QVariant фактически НЕ приведён к этому типу, метод прочитает чужую память
+        // → segfault всего Kdenlive. Поэтому: тип обязан быть известен И конверсия обязана
+        // реально пройти (проверяем bool-возврат convert и итоговый metaType), иначе отказ.
+        if (paramType == QMetaType::UnknownType) {
+            return GatewayProtocol::errorResponse(QStringLiteral("qt_invoke"), requestId, projectId(), timelineRevision(),
+                QStringLiteral("unsupported_param_type"),
+                QStringLiteral("Тип параметра %1 метода не поддерживается qt_invoke.").arg(i));
+        }
+        if (vargs[i].metaType().id() != paramType) {
+            if (!vargs[i].convert(QMetaType(paramType)) || vargs[i].metaType().id() != paramType) {
+                return GatewayProtocol::errorResponse(QStringLiteral("qt_invoke"), requestId, projectId(), timelineRevision(),
+                    QStringLiteral("argument_type_mismatch"),
+                    QStringLiteral("Аргумент %1 нельзя привести к типу параметра метода.").arg(i));
+            }
+        }
+        gargs[i] = QGenericArgument(vargs[i].typeName(), vargs[i].constData());
+    }
+    const bool ok = chosen.invoke(o, Qt::DirectConnection, gargs[0], gargs[1], gargs[2], gargs[3]);
+    ++m_timelineRevision;
+    if (!ok) {
+        return GatewayProtocol::errorResponse(QStringLiteral("qt_invoke"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("method_invoke_failed"), QStringLiteral("Qt failed to invoke the requested method."));
+    }
+    return GatewayProtocol::successResponse(QStringLiteral("qt_invoke"), requestId, projectId(), timelineRevision(),
+        QJsonObject{{QStringLiteral("method"), method}, {QStringLiteral("signature"), QString::fromUtf8(chosen.methodSignature())}});
+}
