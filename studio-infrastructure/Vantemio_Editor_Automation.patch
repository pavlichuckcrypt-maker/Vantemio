+QString GatewayService::handleActivate(const QString &requestId, const QJsonObject &params)
+{
+    const QString key = params.value(QStringLiteral("key")).toString().trimmed();
+    if (key.isEmpty()) {
+        return GatewayProtocol::errorResponse(QStringLiteral("activate"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("missing_key"), QStringLiteral("activate требует params.key."));
+    }
+    // Онлайн-активация делегируется скрипту (curl к серверу → пишет локальный license.json).
+    const QByteArray envScript = qgetenv("VIDRA_LICENSE_SCRIPT");
+    const QString script = !envScript.isEmpty() ? QString::fromUtf8(envScript)
+                                                 : QDir::homePath() + QStringLiteral("/AIMmontag/vidra_license.sh");
+    if (QFileInfo::exists(script)) {
+        QProcess p;
+        p.start(QStringLiteral("/bin/zsh"), QStringList{script, QStringLiteral("activate"), key});
+        waitProcessPumped(p, 30000, QStringLiteral("activate"));
+    }
+    QJsonObject info;
+    const bool ok = gw_isActivated(info);
+    info.insert(QStringLiteral("hw_id"), gw_hwId());
+    if (!ok) {
+        info.insert(QStringLiteral("error"), QStringLiteral("activation_failed"));
+        return GatewayProtocol::errorResponse(QStringLiteral("activate"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("activation_failed"), QStringLiteral("Активация не удалась (неверный/отозванный ключ или сервер недоступен)."));
+    }
+    return GatewayProtocol::successResponse(QStringLiteral("activate"), requestId, projectId(), timelineRevision(), info);
+}
