+// transaction — begin (чекпоинт) / rollback (откат) / commit (зафиксировать). Поверх чекпоинтов.
+QString GatewayService::handleTransaction(const QString &requestId, const QJsonObject &params)
+{
+    const QString op = params.value(QStringLiteral("op")).toString();
+    QString name = params.value(QStringLiteral("name")).toString().trimmed();
+    if (name.isEmpty()) name = QStringLiteral("txn");
+    QString cpKey = QStringLiteral("__txn_");
+    cpKey += name;
+    QJsonObject cpName;
+    cpName.insert(QStringLiteral("name"), cpKey);
+    if (op == QStringLiteral("begin")) {
+        return handleCheckpoint(requestId, cpName);
+    }
+    if (op == QStringLiteral("rollback")) {
+        return handleRestoreCheckpoint(requestId, cpName);
+    }
+    if (op == QStringLiteral("commit")) {
+        QFile::remove(gw_checkpointDir() + QStringLiteral("/__txn_") + name + QStringLiteral(".kdenlive"));
+        return GatewayProtocol::successResponse(QStringLiteral("transaction"), requestId, projectId(), timelineRevision(),
+            QJsonObject{{QStringLiteral("op"), QStringLiteral("commit")}, {QStringLiteral("name"), name}});
+    }
+    return GatewayProtocol::errorResponse(QStringLiteral("transaction"), requestId, projectId(), timelineRevision(),
+        QStringLiteral("bad_op"), QStringLiteral("op: begin | commit | rollback."));
+}
