+// ============================================================================
+// Визуальная обратная связь: сохранить текущий кадр монитора в файл, чтобы
+// внешний «мозг» мог его прочитать и оценить результат (замкнутый цикл).
+// ============================================================================
+QString GatewayService::handleScreenshotMonitor(const QString &requestId, const QJsonObject &params)
+{
+    if (m_core == nullptr || m_core->monitorManager() == nullptr) {
+        return GatewayProtocol::errorResponse(QStringLiteral("screenshot_monitor"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("no_monitor"), QStringLiteral("Monitor manager is not available."));
+    }
+    const QString which = params.value(QStringLiteral("which")).toString();
+    Monitor *mon = (which == QStringLiteral("clip"))
+        ? m_core->monitorManager()->clipMonitor()
+        : m_core->monitorManager()->projectMonitor();
+    if (mon == nullptr) {
+        return GatewayProtocol::errorResponse(QStringLiteral("screenshot_monitor"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("no_monitor"), QStringLiteral("Requested monitor is not available."));
+    }
+    QString path = params.value(QStringLiteral("path")).toString();
+    if (path.isEmpty()) {
+        path = QDir::tempPath() + QStringLiteral("/vidra_frame_%1.png").arg(timelineRevision());
+    }
+    mon->extractFrame(path);
+    return GatewayProtocol::successResponse(QStringLiteral("screenshot_monitor"), requestId, projectId(), timelineRevision(),
+        QJsonObject{
+            {QStringLiteral("which"), which.isEmpty() ? QStringLiteral("project") : which},
+            {QStringLiteral("path"), path},
+            {QStringLiteral("note"), QStringLiteral("Кадр сохраняется в файл (может быть асинхронно — читать через ~200-500мс).")}
+        });
+}
