+// analyze_audio — огибающая громкости, пики, участки тишины (для умной нарезки).
+QString GatewayService::handleAnalyzeAudio(const QString &requestId, const QJsonObject &params)
+{
+    const QString path = params.value(QStringLiteral("path")).toString();
+    if (path.isEmpty() || !QFileInfo::exists(path)) {
+        return GatewayProtocol::errorResponse(QStringLiteral("analyze_audio"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("file_not_found"), QStringLiteral("analyze_audio требует существующий path."));
+    }
+    const QJsonObject r = QJsonDocument::fromJson(gw_runAudioTool(QStringLiteral("analyze"), path).toUtf8()).object();
+    if (!r.value(QStringLiteral("ok")).toBool()) {
+        return GatewayProtocol::errorResponse(QStringLiteral("analyze_audio"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("analyze_failed"), QStringLiteral("Не удалось проанализировать аудио (нет звука/ffmpeg?)."));
+    }
+    return GatewayProtocol::successResponse(QStringLiteral("analyze_audio"), requestId, projectId(), timelineRevision(), r);
