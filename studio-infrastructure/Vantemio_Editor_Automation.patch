+QWidget *findNamedUiControl(QObject *root, const QString &controlName)
+{
+    if (root == nullptr || controlName.trimmed().isEmpty()) {
+        return nullptr;
+    }
+    const auto widgets = root->findChildren<QWidget *>(QString(), Qt::FindChildrenRecursively);
+    for (QWidget *widget : widgets) {
+        if (widget == nullptr) {
+            continue;
+        }
+        if (!supportedUiControlType(widget).isEmpty()) {
+            if (widget->objectName() == controlName || automationIdForObject(widget) == controlName) {
+                return widget;
+            }
+        }
+    }
+    return nullptr;
