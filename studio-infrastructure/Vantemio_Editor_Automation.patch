+namespace {
+
+// Ссылка на результат предыдущей команды batch: "$N.key.subkey".
+// Авто-вход в объект "result". Пример: "$0.clip_id" -> results[0].result.clip_id.
+QJsonValue gw_resolveRef(const QString &ref, const QJsonArray &results)
+{
+    QStringList parts = ref.mid(1).split(QLatin1Char('.'));
+    bool ok = false;
+    const int idx = parts.first().toInt(&ok);
+    if (!ok || idx < 0 || idx >= results.size()) {
+        return QJsonValue();
+    }
+    parts.removeFirst();
+    QJsonValue cur = results.at(idx);
+    if (cur.isObject() && cur.toObject().contains(QStringLiteral("result")) && (parts.isEmpty() || parts.first() != QStringLiteral("result"))) {
+        cur = cur.toObject().value(QStringLiteral("result"));
+    }
+    for (const QString &p : parts) {
+        if (!cur.isObject()) {
+            return QJsonValue();
+        }
+        cur = cur.toObject().value(p);
+    }
+    return cur;
+}
+
+QJsonValue gw_substituteRefs(const QJsonValue &v, const QJsonArray &results)
+{
+    if (v.isString()) {
+        const QString s = v.toString();
+        if (s.size() > 1 && s.at(0) == QLatin1Char('$') && s.at(1).isDigit()) {
+            return gw_resolveRef(s, results);
+        }
+        return v;
+    }
+    if (v.isObject()) {
+        const QJsonObject o = v.toObject();
+        QJsonObject out;
+        for (auto it = o.constBegin(); it != o.constEnd(); ++it) {
+            out.insert(it.key(), gw_substituteRefs(it.value(), results));
+        }
+        return out;
+    }
+    if (v.isArray()) {
+        const QJsonArray a = v.toArray();
+        QJsonArray out;
+        for (const QJsonValue &e : a) {
+            out.append(gw_substituteRefs(e, results));
+        }
+        return out;
+    }
+    return v;
+}
+
+} // namespace
+
+QString GatewayService::handleBatch(const QString &requestId, const QJsonObject &params)
+{
+    const QJsonArray commands = params.value(QStringLiteral("commands")).toArray();
+    const bool stopOnError = params.value(QStringLiteral("stop_on_error")).toBool(false);
+    QJsonArray results;
+    int okCount = 0;
+    for (const QJsonValue &cv : commands) {
+        if (!cv.isObject()) {
+            continue;
+        }
+        // Подставить ссылки $N.key на результаты предыдущих команд.
+        const QJsonObject resolved = gw_substituteRefs(cv.toObject(), results).toObject();
+        const QString sub = QString::fromUtf8(QJsonDocument(resolved).toJson(QJsonDocument::Compact));
+        const QString resp = handleCommand(sub);
+        const QJsonDocument rd = QJsonDocument::fromJson(resp.toUtf8());
+        results.append(rd.isObject() ? rd.object() : QJsonObject{{QStringLiteral("raw"), resp}});
+        const bool ok = rd.isObject() && rd.object().value(QStringLiteral("status")).toString() == QStringLiteral("ok");
+        if (ok) {
+            ++okCount;
+        } else if (stopOnError) {
+            break;
+        }
+    }
+    return GatewayProtocol::successResponse(QStringLiteral("batch"), requestId, projectId(), timelineRevision(),
+        QJsonObject{{QStringLiteral("count"), results.size()}, {QStringLiteral("ok_count"), okCount}, {QStringLiteral("results"), results}});
