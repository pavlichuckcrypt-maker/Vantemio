+// import_media — импортировать файл в bin БЕЗ вставки на таймлайн (вернёт bin_id).
+QString GatewayService::handleImportMedia(const QString &requestId, const QJsonObject &params)
+{
+    const QString path = params.value(QStringLiteral("path")).toString();
+    const QFileInfo f(path);
+    if (path.isEmpty() || !f.exists()) {
+        return GatewayProtocol::errorResponse(QStringLiteral("import_media"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("file_not_found"), QStringLiteral("import_media требует существующий path."));
+    }
+    const QStringList existing = m_core->projectItemModel()->getClipByUrl(f);
+    if (!existing.isEmpty()) {
+        return GatewayProtocol::successResponse(QStringLiteral("import_media"), requestId, projectId(), timelineRevision(),
+            QJsonObject{{QStringLiteral("bin_id"), existing.constFirst()}, {QStringLiteral("already"), true}});
+    }
+    Fun undo = []() { return true; };
+    Fun redo = []() { return true; };
+    const auto root = m_core->projectItemModel()->getRootFolder();
+    const QString rootId = root ? root->clipId() : QStringLiteral("-1");
+    const std::function<void(const QString &)> cb = [](const QString &) {};
+    const QString newId = ClipCreator::createClipFromFile(f.absoluteFilePath(), rootId, m_core->projectItemModel(), undo, redo, cb, false);
+    if (newId == QStringLiteral("-1") || newId.isEmpty()) {
+        return GatewayProtocol::errorResponse(QStringLiteral("import_media"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("import_failed"), QStringLiteral("Не удалось импортировать."));
+    }
+    m_core->pushUndo(undo, redo, QStringLiteral("Import media (gateway)"));
+    return GatewayProtocol::successResponse(QStringLiteral("import_media"), requestId, projectId(), timelineRevision(),
+        QJsonObject{{QStringLiteral("bin_id"), newId}, {QStringLiteral("path"), f.absoluteFilePath()}});
+}
