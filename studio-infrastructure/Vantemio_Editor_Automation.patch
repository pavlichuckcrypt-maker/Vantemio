+QString GatewayService::handleOpenProject(const QString &requestId, const QString &projectPath)
+{
+    if (projectPath.trimmed().isEmpty()) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("open_project"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("missing_project_path"),
+            QStringLiteral("open_project requires params.project_path.")
+        );
+    }
+
+    QFileInfo projectFile(projectPath);
+    if (!projectFile.exists() || !projectFile.isFile()) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("open_project"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("project_not_found"),
+            QStringLiteral("Project file does not exist.")
+        );
+    }
+
+    if (m_core == nullptr || m_core->projectManager() == nullptr) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("open_project"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("project_manager_unavailable"),
+            QStringLiteral("ProjectManager is not available.")
+        );
+    }
+
+    // Сбрасываем флаг "изменён" текущего проекта, чтобы openFile не показал
+    // блокирующий диалог "Сохранить изменения?" (в автоматизации некому нажать).
+    if (m_core->currentDoc() != nullptr) {
+        m_core->currentDoc()->setModified(false);
+    }
+    m_core->projectManager()->openFile(QUrl::fromLocalFile(projectFile.absoluteFilePath()));
+    ++m_timelineRevision;
+    return GatewayProtocol::successResponse(
+        QStringLiteral("open_project"),
+        requestId,
+        projectFile.absoluteFilePath(),
+        timelineRevision(),
+        QJsonObject{
+            {QStringLiteral("project_path"), projectFile.absoluteFilePath()},
+            {QStringLiteral("status"), QStringLiteral("open_requested")},
+        }
+    );
+}
+
+QString GatewayService::handleCreateProject(const QString &requestId, const QJsonObject &params)
+{
+    if (m_core == nullptr || m_core->projectManager() == nullptr) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("create_project"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("project_manager_unavailable"),
+            QStringLiteral("ProjectManager is not available.")
+        );
+    }
+
+    // profile — путь/имя профиля MLT (напр. atsc_1080p_30). Пусто = дефолт из настроек.
+    // project_path — если задан, новый проект сразу сохраняется по этому пути (.kdenlive).
+    const QString profile = params.value(QStringLiteral("profile")).toString().trimmed();
+    const QString savePath = params.value(QStringLiteral("project_path")).toString().trimmed();
+    const QString rid = requestId;
+
+    // Гейт реентрантности (см. m_createProjectBusy в gatewayservice.h): handleCommand уже
+    // отбивает мутирующие команды, пока флаг взведён, но проверяем и здесь в глубину —
+    // на случай прямого вызова обработчика в обход диспетчера.
+    if (m_createProjectBusy) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("create_project"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("gateway_busy"),
+            QStringLiteral("create_project уже выполняется. Дождись события project.created/project.failed.")
+        );
+    }
+    m_createProjectBusy = true;
+
+    // АСИНХРОННО: newFile() трогает GUI/мониторы и может крутить event loop —
+    // выполняем через единую очередь мутаций (строго по одному, с верхнего уровня),
+    // итог отдаём push-событием project.created / project.failed. Сразу "pending".
+    enqueueJob([this, profile, savePath, rid]() {
+        QString errCode;
+        QString errDetail;
+        // Сбрасываем флаг "изменён", чтобы closeCurrentDocument() внутри newFile()
+        // не показал блокирующий диалог "Сохранить изменения?" (в автоматизации
+        // некому нажать). Несохранённые правки осознанно отбрасываются.
+        if (m_core->currentDoc() != nullptr) {
+            m_core->currentDoc()->setModified(false);
+        }
+        if (profile.isEmpty()) {
+            m_core->projectManager()->newFile(false);
+        } else {
+            m_core->projectManager()->newFile(profile, false);
+        }
+        // Дать документу/таймлайну инициализироваться, не блокируя поток.
+        QElapsedTimer t;
+        t.start();
+        while (m_core->currentDoc() == nullptr && t.elapsed() < 10000) {
+            QCoreApplication::processEvents(QEventLoop::ExcludeSocketNotifiers,50);
+        }
+        if (m_core->currentDoc() == nullptr) {
+            errCode = QStringLiteral("project_create_failed");
+            errDetail = QStringLiteral("ProjectManager::newFile(profile='%1') did not produce a KdenliveDoc within 10s.").arg(profile);
+        }
+        // Дождаться ГОТОВНОСТИ таймлайна (есть треки), чтобы мозг сразу после
+        // project.created мог list_tracks/observe без гонки и ретраев.
+        if (errCode.isEmpty()) {
+            QElapsedTimer tt; tt.start();
+            bool tracksReady = false;
+            while (tt.elapsed() < 8000) {
+                auto m = currentTimelineModel();
+                if (m && m->getTracksCount() > 0) { tracksReady = true; break; }
+                QCoreApplication::processEvents(QEventLoop::ExcludeSocketNotifiers,50);
+            }
+            if (!tracksReady) {
+                errCode = QStringLiteral("timeline_not_ready");
+                errDetail = QStringLiteral("Timeline model had 0 tracks after 8s wait following newFile().");
+            }
+        }
+
+        QString effectivePath;
+        if (errCode.isEmpty() && !savePath.isEmpty()) {
+            if (m_core->projectManager()->saveFileAs(savePath, true, false)) {
+                effectivePath = savePath;
+            } else {
+                errCode = QStringLiteral("save_failed");
+                errDetail = QStringLiteral("ProjectManager::saveFileAs('%1') returned false.").arg(savePath);
+            }
+        }
+        ++m_timelineRevision;
+
+        QJsonObject ev{
+            {QStringLiteral("kind"), QStringLiteral("event")},
+            {QStringLiteral("request_id"), rid},
+        };
+        if (errCode.isEmpty()) {
+            ev[QStringLiteral("event")] = QStringLiteral("project.created");
+            ev[QStringLiteral("project_id")] = projectId();
+            if (!effectivePath.isEmpty()) {
+                ev[QStringLiteral("project_path")] = effectivePath;
+            }
+            if (m_core->currentDoc() != nullptr) {
+                ev[QStringLiteral("active_timeline_uuid")] =
+                    m_core->currentDoc()->activeUuid.toString(QUuid::WithoutBraces);
+            }
+        } else {
+            ev[QStringLiteral("event")] = QStringLiteral("project.failed");
+            ev[QStringLiteral("error")] = errCode;
+            if (!errDetail.isEmpty()) {
+                ev[QStringLiteral("error_detail")] = errDetail;
+            }
+        }
+        // Снять гейт ДО pushEvent — симметрично m_buildMontageBusy: как только подписчик
+        // получит project.created/project.failed, он вправе сразу слать следующую команду
+        // (list_tracks, insert_clip, build_montage), и gateway должен быть готов её принять
+        // немедленно, а не оставаться "busy" ещё один цикл событий.
+        m_createProjectBusy = false;
+        pushEvent(ev);
+    });
+
+    return GatewayProtocol::successResponse(
+        QStringLiteral("create_project"),
+        requestId,
+        projectId(),
+        timelineRevision(),
+        QJsonObject{
+            {QStringLiteral("status_detail"), QStringLiteral("pending")},
+            {QStringLiteral("profile"), profile.isEmpty() ? KdenliveSettings::default_profile() : profile},
+            {QStringLiteral("note"), QStringLiteral("Создание проекта асинхронно. Подпишись (subscribe_events) и жди project.created (с project_id) или project.failed. После — save_project / insert_clip.")}
+        }
+    );
+}
