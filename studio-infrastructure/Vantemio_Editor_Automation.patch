+// chroma_key — хромакей (зелёнка/синька) одной командой. params: clip_id, color
+// (green|blue|red|#rrggbb), variance (0-1, мягкость края).
+QString GatewayService::handleChromaKey(const QString &requestId, const QJsonObject &params)
+{
+    auto tl = currentTimelineModel();
+    const int clipId = params.value(QStringLiteral("clip_id")).toInt(-1);
