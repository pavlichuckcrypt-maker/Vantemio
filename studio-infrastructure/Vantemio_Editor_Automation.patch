+QList<UiGeneratorToolSpec> uiGeneratorToolSpecs()
+{
+    const QStringList generatorFolders =
+        QStandardPaths::locateAll(QStandardPaths::AppDataLocation, QStringLiteral("generators"), QStandardPaths::LocateDirectory);
+    const QStringList filters{QStringLiteral("*.xml")};
+    const QStringList producers = KdenliveSettings::producerslist();
+    QStringList parsedGenerators;
+    QList<UiGeneratorToolSpec> result;
+
+    for (const QString &folder : generatorFolders) {
+        QDir directory(folder);
+        const QStringList fileNames = directory.entryList(filters, QDir::Files);
+        for (const QString &fileName : fileNames) {
+            if (parsedGenerators.contains(fileName)) {
+                continue;
+            }
+            parsedGenerators << fileName;
+            const QString filePath = directory.absoluteFilePath(fileName);
+            const QPair<QString, QString> parsed = Generators::parseGenerator(filePath, producers);
+            if (parsed.first.isEmpty() || parsed.second.isEmpty()) {
+                continue;
+            }
+
+            const QString toolId = sanitizeAutomationToken(QFileInfo(fileName).completeBaseName());
+            result.push_back({toolId,
+                              parsed.first,
+                              QStringLiteral("Open the generator dialog for %1.").arg(parsed.first),
+                              QStringLiteral("generator_dialog_%1").arg(toolId),
+                              parsed.second});
+        }
+    }
+
+    return result;
+}
