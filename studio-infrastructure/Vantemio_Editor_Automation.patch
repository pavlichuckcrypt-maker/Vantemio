+QString GatewayService::handleListTracks(const QString &requestId) const
+{
+    auto timelineModel = currentTimelineModel();
+    if (!timelineModel) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("list_tracks"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("timeline_unavailable"),
+            QStringLiteral("Active timeline is not available.")
+        );
+    }
+
+    QJsonArray tracks;
+    const QList<int> videoTracks = timelineModel->getTracksIds(false);
+    const QList<int> audioTracks = timelineModel->getTracksIds(true);
+    for (int trackId : videoTracks) {
+        tracks.push_back(QJsonObject{
+            {QStringLiteral("track_id"), trackId},
+            {QStringLiteral("kind"), QStringLiteral("video")},
+            {QStringLiteral("position"), timelineModel->getTrackPosition(trackId)},
+            {QStringLiteral("mlt_index"), timelineModel->getTrackMltIndex(trackId)},
+            {QStringLiteral("tag"), timelineModel->getTrackTagById(trackId)},
+            {QStringLiteral("clips_count"), timelineModel->getTrackClipsCount(trackId)},
+            {QStringLiteral("compositions_count"), timelineModel->getTrackCompositionsCount(trackId)},
+            {QStringLiteral("locked"), timelineModel->trackIsLocked(trackId)}
+        });
+    }
+    for (int trackId : audioTracks) {
+        tracks.push_back(QJsonObject{
+            {QStringLiteral("track_id"), trackId},
+            {QStringLiteral("kind"), QStringLiteral("audio")},
+            {QStringLiteral("position"), timelineModel->getTrackPosition(trackId)},
+            {QStringLiteral("mlt_index"), timelineModel->getTrackMltIndex(trackId)},
+            {QStringLiteral("tag"), timelineModel->getTrackTagById(trackId)},
+            {QStringLiteral("clips_count"), timelineModel->getTrackClipsCount(trackId)},
+            {QStringLiteral("compositions_count"), timelineModel->getTrackCompositionsCount(trackId)},
+            {QStringLiteral("locked"), timelineModel->trackIsLocked(trackId)}
+        });
+    }
+
+    return GatewayProtocol::successResponse(
+        QStringLiteral("list_tracks"),
+        requestId,
+        projectId(),
+        timelineRevision(),
+        QJsonObject{{QStringLiteral("tracks"), tracks}}
+    );
+}
+
+// ============================================================================
+// ХЕЛПЕРЫ АВТОМАТИЗАЦИИ: высокоуровневые команды для монтажного мозга.
+// ============================================================================
+
+// Полный снимок таймлайна: все треки и все клипы с геометрией. Даёт мозгу
+// ситуационную осведомлённость одним вызовом (get_project_state даёт лишь счётчики).
+QString GatewayService::handleGetTimelineSummary(const QString &requestId) const
+{
+    auto tl = currentTimelineModel();
+    if (!tl) {
+        return GatewayProtocol::errorResponse(QStringLiteral("get_timeline_summary"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("timeline_unavailable"), QStringLiteral("Active timeline is not available."));
+    }
+    const double fps = m_core ? m_core->getCurrentFps() : 25.0;
+    QJsonArray tracksArr;
+    int totalClips = 0;
+    int projectEnd = 0;
+    const QList<int> vids = tl->getTracksIds(false);
+    const QList<int> auds = tl->getTracksIds(true);
+    QList<int> allTracks = vids;
+    allTracks.append(auds);
+    for (int trackId : allTracks) {
+        const bool isAudio = tl->isAudioTrack(trackId);
+        QJsonArray clipsArr;
+        std::unordered_set<int> items = tl->getItemsInRange(trackId, 0, -1, false);
+        QList<int> sorted(items.begin(), items.end());
+        std::sort(sorted.begin(), sorted.end(), [tl](int a, int b){ return tl->getClipPosition(a) < tl->getClipPosition(b); });
+        for (int clipId : sorted) {
+            if (!tl->isClip(clipId)) {
+                continue;
+            }
+            const int pos = tl->getClipPosition(clipId);
+            const int dur = tl->getClipPlaytime(clipId);
+            projectEnd = qMax(projectEnd, pos + dur);
+            ++totalClips;
+            clipsArr.append(QJsonObject{
+                {QStringLiteral("clip_id"), clipId},
+                {QStringLiteral("bin_id"), tl->getClipBinId(clipId)},
+                {QStringLiteral("position"), pos},
+                {QStringLiteral("duration"), dur},
+                {QStringLiteral("in"), tl->getClipIn(clipId)},
+                {QStringLiteral("end"), pos + dur},
+                {QStringLiteral("position_sec"), pos / fps},
+                {QStringLiteral("duration_sec"), dur / fps},
+            });
+        }
+        tracksArr.append(QJsonObject{
+            {QStringLiteral("track_id"), trackId},
+            {QStringLiteral("kind"), isAudio ? QStringLiteral("audio") : QStringLiteral("video")},
+            {QStringLiteral("tag"), tl->getTrackTagById(trackId)},
+            {QStringLiteral("position"), tl->getTrackPosition(trackId)},
+            {QStringLiteral("locked"), tl->trackIsLocked(trackId)},
+            {QStringLiteral("clips_count"), clipsArr.size()},
+            {QStringLiteral("clips"), clipsArr},
+        });
+    }
+    return GatewayProtocol::successResponse(QStringLiteral("get_timeline_summary"), requestId, projectId(), timelineRevision(),
+        QJsonObject{
+            {QStringLiteral("fps"), fps},
+            {QStringLiteral("tracks_count"), tracksArr.size()},
+            {QStringLiteral("clips_count"), totalClips},
+            {QStringLiteral("project_end_frames"), projectEnd},
+            {QStringLiteral("project_end_sec"), projectEnd / fps},
+            {QStringLiteral("tracks"), tracksArr},
+        });
+}
