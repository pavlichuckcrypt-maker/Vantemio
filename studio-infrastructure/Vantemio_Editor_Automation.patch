+QString GatewayService::handleOpenUiTimeremapTool(const QString &requestId, const QJsonObject &params)
+{
+    if (m_core == nullptr || m_core->window() == nullptr) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("open_ui_timeremap_tool"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("timeremap_unavailable"),
+            QStringLiteral("MainWindow is not available.")
+        );
+    }
+
+    const QString toolId = params.value(QStringLiteral("tool_id")).toString();
+    if (toolId.trimmed().isEmpty()) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("open_ui_timeremap_tool"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("invalid_parameters"),
+            QStringLiteral("open_ui_timeremap_tool requires tool_id.")
+        );
+    }
+
+    const std::optional<UiTimeremapToolSpec> spec = findUiTimeremapToolSpec(toolId);
+    if (!spec.has_value()) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("open_ui_timeremap_tool"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("timeremap_tool_not_found"),
+            QStringLiteral("Requested timeremap tool was not found.")
+        );
+    }
+
+    MainWindow *window = m_core->window();
+    KDDockWidgets::QtWidgets::DockWidget *dock = nullptr;
+    TimeRemap *widget = findTimeRemapWidget(m_core, window);
+    RemapView *view = findTimeRemapView(widget);
+    bool performed = false;
+
+    auto requireActiveClip = [&]() -> bool {
+        return widget != nullptr && !widget->currentClip().isEmpty();
+    };
+
+    if (spec->kind == QStringLiteral("dock")) {
+        dock = findNamedUiDock(window, spec->targetName);
+        if (dock == nullptr) {
+            return GatewayProtocol::errorResponse(
+                QStringLiteral("open_ui_timeremap_tool"),
+                requestId,
+                projectId(),
+                timelineRevision(),
+                QStringLiteral("timeremap_dock_unavailable"),
+                QStringLiteral("Time Remapping dock was not found.")
+            );
+        }
+        const bool open = params.contains(QStringLiteral("open")) ? params.value(QStringLiteral("open")).toBool() : true;
+        if (open) {
+            dock->open();
+        } else {
+            dock->close();
+        }
+        if (open && params.value(QStringLiteral("focus")).toBool(false)) {
+            dock->open();
+            dock->setAsCurrentTab();
+            dock->setFocus(Qt::OtherFocusReason);
+        }
+        performed = true;
+    } else {
+        if (widget == nullptr || view == nullptr) {
+            return GatewayProtocol::errorResponse(
+                QStringLiteral("open_ui_timeremap_tool"),
+                requestId,
+                projectId(),
+                timelineRevision(),
+                QStringLiteral("timeremap_widget_unavailable"),
+                QStringLiteral("Time Remap widget is not available.")
+            );
+        }
+
+        if (spec->toolId == QStringLiteral("toggle_pitch_compensation")) {
+            if (!requireActiveClip()) {
+                return GatewayProtocol::errorResponse(
+                    QStringLiteral("open_ui_timeremap_tool"),
+                    requestId,
+                    projectId(),
+                    timelineRevision(),
+                    QStringLiteral("timeremap_clip_unavailable"),
+                    QStringLiteral("No active time remap clip is currently selected.")
+                );
+            }
+            QCheckBox *control = widget->findChild<QCheckBox *>(QStringLiteral("pitch_compensate"));
+            if (control == nullptr) {
+                return GatewayProtocol::errorResponse(QStringLiteral("open_ui_timeremap_tool"), requestId, projectId(), timelineRevision(),
+                                                      QStringLiteral("timeremap_control_unavailable"), QStringLiteral("Pitch compensation control was not found."));
+            }
+            const bool checked = params.contains(QStringLiteral("checked")) ? params.value(QStringLiteral("checked")).toBool() : !control->isChecked();
+            control->setChecked(checked);
+            performed = true;
+        } else if (spec->toolId == QStringLiteral("toggle_frame_blending")) {
+            if (!requireActiveClip()) {
+                return GatewayProtocol::errorResponse(
+                    QStringLiteral("open_ui_timeremap_tool"),
+                    requestId,
+                    projectId(),
+                    timelineRevision(),
+                    QStringLiteral("timeremap_clip_unavailable"),
+                    QStringLiteral("No active time remap clip is currently selected.")
+                );
+            }
+            QCheckBox *control = widget->findChild<QCheckBox *>(QStringLiteral("frame_blending"));
+            if (control == nullptr) {
+                return GatewayProtocol::errorResponse(QStringLiteral("open_ui_timeremap_tool"), requestId, projectId(), timelineRevision(),
+                                                      QStringLiteral("timeremap_control_unavailable"), QStringLiteral("Frame blending control was not found."));
+            }
+            const bool checked = params.contains(QStringLiteral("checked")) ? params.value(QStringLiteral("checked")).toBool() : !control->isChecked();
+            control->setChecked(checked);
+            performed = true;
+        } else if (spec->toolId == QStringLiteral("toggle_preserve_next_speed")) {
+            QCheckBox *control = widget->findChild<QCheckBox *>(QStringLiteral("move_next"));
+            if (control == nullptr) {
+                return GatewayProtocol::errorResponse(QStringLiteral("open_ui_timeremap_tool"), requestId, projectId(), timelineRevision(),
+                                                      QStringLiteral("timeremap_control_unavailable"), QStringLiteral("Preserve next speed control was not found."));
+            }
+            const bool checked = params.contains(QStringLiteral("checked")) ? params.value(QStringLiteral("checked")).toBool() : !control->isChecked();
+            control->setChecked(checked);
+            performed = true;
+        } else if (spec->toolId == QStringLiteral("delete_remap")) {
+            if (!requireActiveClip()) {
+                return GatewayProtocol::errorResponse(
+                    QStringLiteral("open_ui_timeremap_tool"),
+                    requestId,
+                    projectId(),
+                    timelineRevision(),
+                    QStringLiteral("timeremap_clip_unavailable"),
+                    QStringLiteral("No active time remap clip is currently selected.")
+                );
+            }
+            if (!params.value(QStringLiteral("confirm")).toBool(false)) {
+                return GatewayProtocol::errorResponse(
+                    QStringLiteral("open_ui_timeremap_tool"),
+                    requestId,
+                    projectId(),
+                    timelineRevision(),
+                    QStringLiteral("confirmation_required"),
+                    QStringLiteral("delete_remap requires confirm=true.")
+                );
+            }
+            QAbstractButton *button = widget->findChild<QAbstractButton *>(QStringLiteral("button_del"));
+            if (button == nullptr) {
+                return GatewayProtocol::errorResponse(QStringLiteral("open_ui_timeremap_tool"), requestId, projectId(), timelineRevision(),
+                                                      QStringLiteral("timeremap_control_unavailable"), QStringLiteral("Delete remap button was not found."));
+            }
+            button->click();
+            performed = true;
+        } else if (spec->toolId == QStringLiteral("next_keyframe") || spec->toolId == QStringLiteral("previous_keyframe") ||
+                   spec->toolId == QStringLiteral("add_or_remove_keyframe") || spec->toolId == QStringLiteral("center_output_keyframe") ||
+                   spec->toolId == QStringLiteral("center_source_keyframe") || spec->toolId == QStringLiteral("set_source_cursor_position") ||
+                   spec->toolId == QStringLiteral("set_output_cursor_position")) {
+            if (!requireActiveClip()) {
+                return GatewayProtocol::errorResponse(
+                    QStringLiteral("open_ui_timeremap_tool"),
+                    requestId,
+                    projectId(),
+                    timelineRevision(),
+                    QStringLiteral("timeremap_clip_unavailable"),
+                    QStringLiteral("No active time remap clip is currently selected.")
+                );
+            }
+            if (spec->toolId == QStringLiteral("next_keyframe")) {
+                view->goNext();
+            } else if (spec->toolId == QStringLiteral("previous_keyframe")) {
+                view->goPrev();
+            } else if (spec->toolId == QStringLiteral("add_or_remove_keyframe")) {
+                view->addKeyframe();
+            } else if (spec->toolId == QStringLiteral("center_output_keyframe")) {
+                view->centerCurrentKeyframe();
+            } else if (spec->toolId == QStringLiteral("center_source_keyframe")) {
+                view->centerCurrentTopKeyframe();
+            } else if (spec->toolId == QStringLiteral("set_source_cursor_position")) {
+                if (!params.contains(QStringLiteral("frame"))) {
+                    return GatewayProtocol::errorResponse(
+                        QStringLiteral("open_ui_timeremap_tool"),
+                        requestId,
+                        projectId(),
+                        timelineRevision(),
+                        QStringLiteral("invalid_parameters"),
+                        QStringLiteral("set_source_cursor_position requires frame.")
+                    );
+                }
+                view->slotSetPosition(params.value(QStringLiteral("frame")).toInt());
+            } else if (spec->toolId == QStringLiteral("set_output_cursor_position")) {
+                if (!params.contains(QStringLiteral("frame"))) {
+                    return GatewayProtocol::errorResponse(
+                        QStringLiteral("open_ui_timeremap_tool"),
+                        requestId,
+                        projectId(),
+                        timelineRevision(),
+                        QStringLiteral("invalid_parameters"),
+                        QStringLiteral("set_output_cursor_position requires frame.")
+                    );
+                }
+                view->slotSetBottomPosition(params.value(QStringLiteral("frame")).toInt());
+            }
+            performed = true;
+        }
+    }
+
+    QCoreApplication::processEvents(QEventLoop::ExcludeSocketNotifiers);
+    dock = findNamedUiDock(window, QStringLiteral("timeremap"));
+    widget = findTimeRemapWidget(m_core, window);
+    view = findTimeRemapView(widget);
+    ++m_timelineRevision;
+    QJsonObject result = serializeUiTimeremapTool(*spec, nullptr, dock);
+    result.insert(QStringLiteral("performed"), performed);
+    result.insert(QStringLiteral("simulated"), false);
+    if (dock != nullptr) {
+        result.insert(QStringLiteral("dock"), serializeUiDock(QStringLiteral("timeremap"), dock->windowTitle(), dock->toggleAction(), dock));
+    }
+    const QJsonObject state = serializeTimeremapState(widget, view, dock);
+    for (auto it = state.begin(); it != state.end(); ++it) {
+        result.insert(it.key(), it.value());
+    }
+    return GatewayProtocol::successResponse(
+        QStringLiteral("open_ui_timeremap_tool"),
+        requestId,
+        projectId(),
+        timelineRevision(),
+        result
+    );
+}
