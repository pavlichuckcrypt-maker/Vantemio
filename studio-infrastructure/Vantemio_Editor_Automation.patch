+// delete_range — удалить участок дорожки. ripple=true закрывает дыру, иначе оставляет.
+QString GatewayService::handleDeleteRange(const QString &requestId, const QJsonObject &params)
+{
+    auto tl = currentTimelineModel();
+    if (!tl) {
+        return GatewayProtocol::errorResponse(QStringLiteral("delete_range"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("timeline_unavailable"), QStringLiteral("Active timeline is not available."));
+    }
+    const double fps = m_core ? m_core->getCurrentFps() : 25.0;
+    const int trackId = params.value(QStringLiteral("track_id")).toInt(-1);
+    const int in = params.contains(QStringLiteral("in")) ? params.value(QStringLiteral("in")).toInt() : int(params.value(QStringLiteral("start_sec")).toDouble() * fps);
+    const int out = params.contains(QStringLiteral("out")) ? params.value(QStringLiteral("out")).toInt() : int(params.value(QStringLiteral("end_sec")).toDouble() * fps);
+    const bool ripple = params.value(QStringLiteral("ripple")).toBool(false);
+    QVector<int> tracks;
+    if (tl->isTrack(trackId)) tracks.append(trackId);
+    else { for (int t : tl->getTracksIds(false)) tracks.append(t); for (int t : tl->getTracksIds(true)) tracks.append(t); }
+    // liftOnly=true → оставить дыру; extract (ripple) → liftOnly=false
+    const bool ok = TimelineFunctions::extractZone(tl, tracks, QPoint(in, out), !ripple);
+    if (!ok) {
+        return GatewayProtocol::errorResponse(QStringLiteral("delete_range"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("delete_range_failed"), QStringLiteral("Не удалось удалить участок."));
+    }
+    ++m_timelineRevision;
+    return GatewayProtocol::successResponse(QStringLiteral("delete_range"), requestId, projectId(), timelineRevision(),
+        QJsonObject{{QStringLiteral("in"), in}, {QStringLiteral("out"), out}, {QStringLiteral("ripple"), ripple}});
+}
