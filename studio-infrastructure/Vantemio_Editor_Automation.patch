+QString GatewayService::handleUpdateSubtitle(const QString &requestId, int subtitleId, const QString &text, int startFrame, int endFrame)
+{
+    auto subtitleModel = currentSubtitleModel(false);
+    const double fps = m_core != nullptr ? m_core->getCurrentFps() : 25.0;
+    if (!subtitleModel || subtitleId < 0 || !subtitleModel->hasSubtitle(subtitleId)) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("update_subtitle"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("subtitle_not_found"),
+            QStringLiteral("Subtitle item does not exist.")
+        );
+    }
+
+    if (!text.isNull() && text != subtitleModel->getText(subtitleId) && !subtitleModel->editSubtitle(subtitleId, text)) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("update_subtitle"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("subtitle_text_update_failed"),
+            QStringLiteral("Subtitle text update failed.")
+        );
+    }
+
+    if (startFrame >= 0 && startFrame != subtitleModel->getStartPosForId(subtitleId).frames(fps)) {
+        subtitleModel->requestSubtitleMove(subtitleId, subtitleModel->getLayerForId(subtitleId), GenTime(startFrame, fps));
+    }
+    if (endFrame >= 0) {
+        const int start = subtitleModel->getStartPosForId(subtitleId).frames(fps);
+        const int size = endFrame - start;
+        if (size <= 0 || !subtitleModel->requestResize(subtitleId, size, true)) {
+            return GatewayProtocol::errorResponse(
+                QStringLiteral("update_subtitle"),
+                requestId,
+                projectId(),
+                timelineRevision(),
+                QStringLiteral("subtitle_resize_failed"),
+                QStringLiteral("Subtitle timing update failed.")
+            );
+        }
+    }
+
+    ++m_timelineRevision;
+    return GatewayProtocol::successResponse(
+        QStringLiteral("update_subtitle"),
+        requestId,
+        projectId(),
+        timelineRevision(),
+        QJsonObject{
+            {QStringLiteral("subtitle_id"), subtitleId},
+            {QStringLiteral("text"), subtitleModel->getText(subtitleId)},
+            {QStringLiteral("start_frame"), subtitleModel->getStartPosForId(subtitleId).frames(fps)},
+            {QStringLiteral("end_frame"), subtitleModel->getStartPosForId(subtitleId).frames(fps) + subtitleModel->getSubtitlePlaytime(subtitleId)}
+        }
+    );
+}
