+QString GatewayService::handleListUiDocks(const QString &requestId) const
+{
+    if (m_core == nullptr || m_core->window() == nullptr) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("list_ui_docks"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("ui_root_unavailable"),
+            QStringLiteral("MainWindow is not available.")
+        );
+    }
+
+    QJsonArray docks;
+    QSet<QString> seenDockNames;
+    const auto runtimeDocks = collectRuntimeUiDocks(m_core->window());
+    for (KDDockWidgets::QtWidgets::DockWidget *dock : runtimeDocks) {
+        if (dock == nullptr || dock->objectName().trimmed().isEmpty()) {
+            continue;
+        }
+        seenDockNames.insert(dock->objectName());
+        docks.push_back(serializeUiDock(dock->objectName(), dock->windowTitle(), dock->toggleAction(), dock));
+    }
+
+    const QList<QAction *> runtimeActions = collectRuntimeUiActions(m_core->window());
+    for (QAction *action : runtimeActions) {
+        if (!isUiDockToggleAction(action)) {
+            continue;
+        }
+        const QString dockName = dockNameFromAction(action);
+        if (dockName.trimmed().isEmpty() || seenDockNames.contains(dockName)) {
+            continue;
+        }
+        docks.push_back(serializeUiDock(dockName, dockTitleFromAction(action), action, nullptr));
+        seenDockNames.insert(dockName);
+    }
+    for (const auto &dock : builtinUiDockManifest()) {
+        if (seenDockNames.contains(dock.first)) {
+            continue;
+        }
+        docks.push_back(serializeUiDock(dock.first, dock.second, nullptr, nullptr));
+        seenDockNames.insert(dock.first);
+    }
+
+    return GatewayProtocol::successResponse(
+        QStringLiteral("list_ui_docks"),
+        requestId,
+        projectId(),
+        timelineRevision(),
+        QJsonObject{{QStringLiteral("docks"), docks}}
+    );
+}
