+    // процесс). Симметрично m_buildMontageBusy.
+    bool m_createProjectBusy = false;
+
+    // Анти-заморозка главного Qt-потока для СИНХРОННЫХ дочерних процессов (ffmpeg/
+    // ffprobe/python-помощники: probe_media, get_thumbnail_strip, analyze_audio и др.).
+    // Раньше они звали QProcess::waitForFinished() и вешали весь event loop на 15-30с —
+    // gateway молчал, watchdog/луп считали его мёртвым и делали слепой pkill посреди
+    // работы (первопричина «постоянно сыпется»). Теперь ожидание идёт через
+    // waitProcessPumped(): качаем event loop (ping/интроспекция живы), а m_gwBusy через
+    // тот же гейт, что и m_buildMontageBusy, отбивает МУТИРУЮЩИЕ команды (gateway_busy).
+    mutable bool m_gwBusy = false;
+    mutable QString m_gwBusyAction;
+    bool waitProcessPumped(QProcess &proc, int timeoutMs, const QString &opName) const;
+
+    // Heartbeat-файл: таймер раз в секунду пишет метку времени. Таймер тикает во время
+    // ЛЮБОГО processEvents-pump (build_montage/render/waitProcessPumped), поэтому «занят,
+    // но жив» (сборка минуты, ping в блэкауте) отличается от «реально завис». Watchdog
+    // смотрит свежесть heartbeat и НЕ убивает живой движок посреди долгой сборки.
+    QString m_heartbeatPath;
+
+    // ЕДИНАЯ ОЧЕРЕДЬ АСИНХРОННЫХ МУТАЦИЙ (корень болезни «гонка вставки/track_not_found/
+    // краш ~5мин»). Раньше insert_clip/insert_sequence/build_montage/create_project/
+    // restore_checkpoint откладывались через invokeMethod(QueuedConnection) — но posted
+    // MetaCall-события НЕ исключаются processEvents(ExcludeSocketNotifiers), поэтому
+    // ЛЮБОЙ pump (ожидание продюсера, waitSync, читатели кадров) исполнял чужие
+    // отложенные мутации ВЛОЖЕННО посреди текущей операции: клипы молча терялись,
+    // треки «исчезали», модель ломалась под итерацией → сегфолт. Теперь мутации
+    // сериализуются: drainJobs() исполняет строго по одной и ТОЛЬКО с верхнего уровня
+    // event loop (никогда из вложенного pump — см. гейты в drainJobs).
+    QList<std::function<void()>> m_jobQueue;
+    bool m_jobActive = false;      // job исполняется: мутирующие команды → gateway_busy
+    QTimer *m_jobTimer = nullptr;  // тикает, пока очередь непуста; на верхнем уровне сливает
+    // true пока dispatchSocket разбирает команды из TCP-буфера. Повторная доставка
+    // readyRead во время pump (canReadNotification/posted QEvent) больше НЕ вызывает
+    // handleCommand рекурсивно: сокет помечается «грязным» и разбирается после.
+    bool m_dispatchBusy = false;
+    QHash<QTcpSocket *, std::shared_ptr<QByteArray>> m_gwBuffers;
+    QSet<QTcpSocket *> m_dirtySockets;
+    void enqueueJob(std::function<void()> job);
+    void drainJobs(bool fromDispatch = false);
+    void dispatchSocket(QTcpSocket *sock, const std::shared_ptr<QByteArray> &buffer);
+    // Тело вставки клипа (общая часть sync/async путей). Возвращает событие
+    // clip.inserted / clip.failed; pushEvent делает сам.
+    QJsonObject gw_doInsertClip(const QString &absPath, int trackId, int position, const QString &rid);
+};
