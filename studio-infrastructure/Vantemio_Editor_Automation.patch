+// ken_burns — авто пан/зум на клип (живой эффект движения для статичных фото/кадров).
+// params: clip_id, zoom (1.0-2.0, по умолч 1.15), direction ("in"|"out").
+QString GatewayService::handleKenBurns(const QString &requestId, const QJsonObject &params)
+{
+    auto tl = currentTimelineModel();
+    const int clipId = params.value(QStringLiteral("clip_id")).toInt(-1);
+    if (!tl || !tl->isClip(clipId)) {
+        return GatewayProtocol::errorResponse(QStringLiteral("ken_burns"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("clip_not_found"), QStringLiteral("Нет клипа с таким clip_id."));
+    }
+    double zoom = params.value(QStringLiteral("zoom")).toDouble(1.15);
+    if (zoom < 1.0) zoom = 1.0;
+    if (zoom > 3.0) zoom = 3.0;
+    const QString dir = params.value(QStringLiteral("direction")).toString(QStringLiteral("in"));
+    const int W = m_core ? m_core->getCurrentProfile()->width() : 1920;
+    const int H = m_core ? m_core->getCurrentProfile()->height() : 1080;
+    const int dur = qMax(1, tl->getClipPlaytime(clipId));
+    // qtblend rect — прямоугольник кадра на холсте. Зум = увеличиваем рект и центрируем.
+    const int zx = int(-W * (zoom - 1.0) / 2.0);
+    const int zy = int(-H * (zoom - 1.0) / 2.0);
+    const int zw = int(W * zoom);
+    const int zh = int(H * zoom);
+    const QString full = QStringLiteral("0 0 %1 %2 1").arg(W).arg(H);
+    const QString zoomed = QStringLiteral("%1 %2 %3 %4 1").arg(zx).arg(zy).arg(zw).arg(zh);
+    const QString kf = (dir == QStringLiteral("out"))
+        ? QStringLiteral("0=%1;%2=%3").arg(zoomed).arg(dur).arg(full)
+        : QStringLiteral("0=%1;%2=%3").arg(full).arg(dur).arg(zoomed);
+    const int row = gw_addEffectWithParams(clipId, QStringLiteral("qtblend"), {{QStringLiteral("rect"), kf}});
+    if (row < 0) {
+        return GatewayProtocol::errorResponse(QStringLiteral("ken_burns"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("ken_burns_failed"), QStringLiteral("Не удалось применить эффект движения."));
+    }
+    return GatewayProtocol::successResponse(QStringLiteral("ken_burns"), requestId, projectId(), timelineRevision(),
+        QJsonObject{{QStringLiteral("clip_id"), clipId}, {QStringLiteral("effect_row"), row},
+                    {QStringLiteral("zoom"), zoom}, {QStringLiteral("direction"), dir}, {QStringLiteral("duration_frames"), dur}});
+}
+
+// apply_look — именованный кино-грейд одним вызовом (фирменные образы VidRA).
+QString GatewayService::handleApplyLook(const QString &requestId, const QJsonObject &params)
+{
+    auto tl = currentTimelineModel();
+    const int clipId = params.value(QStringLiteral("clip_id")).toInt(-1);
+    const QString look = params.value(QStringLiteral("look")).toString().toLower();
+    if (!tl || !tl->isClip(clipId)) {
+        return GatewayProtocol::errorResponse(QStringLiteral("apply_look"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("clip_not_found"), QStringLiteral("Нет клипа с таким clip_id."));
+    }
+    // Каждый образ = avfilter.eq (контраст/насыщ./гамма) + опц. lift_gamma_gain (тон).
+    // contrast, brightness, saturation, gamma — параметры av.* у avfilter.eq.
+    QList<QPair<QString, QString>> eq;   // av.contrast / av.saturation / av.gamma / av.brightness
+    QList<QPair<QString, QString>> lgg;  // тонирование тенями/светами
+    if (look == QStringLiteral("noir") || look == QStringLiteral("bw")) {
+        eq = {{QStringLiteral("av.saturation"), QStringLiteral("0")}, {QStringLiteral("av.contrast"), QStringLiteral("1.25")}};
+    } else if (look == QStringLiteral("cinematic")) {
+        eq = {{QStringLiteral("av.contrast"), QStringLiteral("1.12")}, {QStringLiteral("av.saturation"), QStringLiteral("1.05")}, {QStringLiteral("av.gamma"), QStringLiteral("0.95")}};
+        lgg = {{QStringLiteral("lift_b"), QStringLiteral("0.04")}, {QStringLiteral("gain_r"), QStringLiteral("1.06")}};
+    } else if (look == QStringLiteral("teal_orange") || look == QStringLiteral("blockbuster")) {
+        eq = {{QStringLiteral("av.contrast"), QStringLiteral("1.1")}, {QStringLiteral("av.saturation"), QStringLiteral("1.15")}};
+        lgg = {{QStringLiteral("lift_b"), QStringLiteral("0.06")}, {QStringLiteral("lift_g"), QStringLiteral("0.02")}, {QStringLiteral("gain_r"), QStringLiteral("1.08")}, {QStringLiteral("gain_b"), QStringLiteral("0.94")}};
+    } else if (look == QStringLiteral("warm")) {
+        eq = {{QStringLiteral("av.saturation"), QStringLiteral("1.1")}};
+        lgg = {{QStringLiteral("gain_r"), QStringLiteral("1.08")}, {QStringLiteral("gain_b"), QStringLiteral("0.95")}};
+    } else if (look == QStringLiteral("cold")) {
+        eq = {{QStringLiteral("av.saturation"), QStringLiteral("1.05")}};
+        lgg = {{QStringLiteral("gain_b"), QStringLiteral("1.08")}, {QStringLiteral("gain_r"), QStringLiteral("0.95")}};
+    } else if (look == QStringLiteral("vivid")) {
+        eq = {{QStringLiteral("av.saturation"), QStringLiteral("1.35")}, {QStringLiteral("av.contrast"), QStringLiteral("1.1")}};
+    } else if (look == QStringLiteral("flat") || look == QStringLiteral("log")) {
+        eq = {{QStringLiteral("av.contrast"), QStringLiteral("0.85")}, {QStringLiteral("av.saturation"), QStringLiteral("0.85")}, {QStringLiteral("av.gamma"), QStringLiteral("1.1")}};
+    } else {
+        return GatewayProtocol::errorResponse(QStringLiteral("apply_look"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("unknown_look"), QStringLiteral("look: noir, cinematic, teal_orange, warm, cold, vivid, flat."));
+    }
+    const int r1 = gw_addEffectWithParams(clipId, QStringLiteral("avfilter.eq"), eq);
+    int r2 = -1;
+    if (!lgg.isEmpty()) {
+        r2 = gw_addEffectWithParams(clipId, QStringLiteral("lift_gamma_gain"), lgg);
+    }
+    if (r1 < 0 && r2 < 0) {
+        return GatewayProtocol::errorResponse(QStringLiteral("apply_look"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("apply_look_failed"), QStringLiteral("Не удалось применить грейд."));
+    }
+    return GatewayProtocol::successResponse(QStringLiteral("apply_look"), requestId, projectId(), timelineRevision(),
+        QJsonObject{{QStringLiteral("clip_id"), clipId}, {QStringLiteral("look"), look},
+                    {QStringLiteral("eq_row"), r1}, {QStringLiteral("grade_row"), r2}});
+}
+
+// set_transform — ВЫСОКОУРОВНЕВАЯ камера/трансформ одной командой: позиция(x,y px),
+// зум(scale), поворот(rotation°), прозрачность(opacity 0-1) — кейфреймами. Строит
+// qtblend rect+rotation за мозг (не надо вручную лепить rect-строки).
+// params: clip_id, keyframes:[{frame,x,y,scale,rotation,opacity}]  ИЛИ статично x/y/scale/rotation/opacity.
+QString GatewayService::handleSetTransform(const QString &requestId, const QJsonObject &params)
+{
+    auto tl = currentTimelineModel();
+    const int clipId = params.value(QStringLiteral("clip_id")).toInt(-1);
+    if (!tl || !tl->isClip(clipId)) {
+        return GatewayProtocol::errorResponse(QStringLiteral("set_transform"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("clip_not_found"), QStringLiteral("Нет клипа с таким clip_id."));
+    }
+    const double W = m_core && m_core->getCurrentProfile() ? m_core->getCurrentProfile()->width() : 1920.0;
+    const double H = m_core && m_core->getCurrentProfile() ? m_core->getCurrentProfile()->height() : 1080.0;
+    QStringList rectParts, rotParts;
+    bool hasRot = false;
+    auto buildKf = [&](int frame, double x, double y, double scale, double rot, double op) {
+        double sc = scale <= 0 ? 1.0 : scale;
+        int w = int(qRound(W * sc)), h = int(qRound(H * sc));
+        int X = int(qRound((W - w) / 2.0 + x)), Y = int(qRound((H - h) / 2.0 + y));
+        rectParts << QStringLiteral("%1=%2 %3 %4 %5 %6").arg(frame).arg(X).arg(Y).arg(w).arg(h).arg(op, 0, 'g', 3);
+        if (qAbs(rot) > 0.001) hasRot = true;
+        rotParts << QStringLiteral("%1=%2").arg(frame).arg(rot, 0, 'g', 4);
+    };
+    const QJsonArray kfs = params.value(QStringLiteral("keyframes")).toArray();
+    if (!kfs.isEmpty()) {
+        for (const QJsonValue &v : kfs) {
+            const QJsonObject k = v.toObject();
+            buildKf(k.value(QStringLiteral("frame")).toInt(0), k.value(QStringLiteral("x")).toDouble(0),
+                    k.value(QStringLiteral("y")).toDouble(0), k.value(QStringLiteral("scale")).toDouble(1.0),
+                    k.value(QStringLiteral("rotation")).toDouble(0),
+                    k.contains(QStringLiteral("opacity")) ? k.value(QStringLiteral("opacity")).toDouble(1.0) : 1.0);
+        }
+    } else {
+        buildKf(0, params.value(QStringLiteral("x")).toDouble(0), params.value(QStringLiteral("y")).toDouble(0),
+                params.value(QStringLiteral("scale")).toDouble(1.0), params.value(QStringLiteral("rotation")).toDouble(0),
+                params.contains(QStringLiteral("opacity")) ? params.value(QStringLiteral("opacity")).toDouble(1.0) : 1.0);
+    }
+    QList<QPair<QString, QString>> kv;
+    kv << qMakePair(QStringLiteral("rect"), rectParts.join(QStringLiteral(";")));
+    kv << qMakePair(QStringLiteral("compositing"), QStringLiteral("0"));
+    if (hasRot) kv << qMakePair(QStringLiteral("rotation"), rotParts.join(QStringLiteral(";")));
+    const int row = gw_addEffectWithParams(clipId, QStringLiteral("qtblend"), kv);
+    if (row < 0) {
+        return GatewayProtocol::errorResponse(QStringLiteral("set_transform"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("transform_failed"), QStringLiteral("Не удалось применить трансформ."));
+    }
+    return GatewayProtocol::successResponse(QStringLiteral("set_transform"), requestId, projectId(), timelineRevision(),
+        QJsonObject{{QStringLiteral("clip_id"), clipId}, {QStringLiteral("effect_row"), row},
+                    {QStringLiteral("keyframes"), int(rectParts.size())}, {QStringLiteral("rotation"), hasRot}});
+}
+
+// color_correct — ЦВЕТОКОРРЕКЦИЯ одной командой: brightness/contrast/saturation/gamma +
+// temperature(K) + 3-way lift/gamma/gain (RGB). Строит avfilter.eq + colortemperature +
+// lift_gamma_gain — мозгу не надо цеплять эффекты по одному. Все параметры опциональны.
+QString GatewayService::handleColorCorrect(const QString &requestId, const QJsonObject &params)
+{
+    auto tl = currentTimelineModel();
+    const int clipId = params.value(QStringLiteral("clip_id")).toInt(-1);
+    if (!tl || !tl->isClip(clipId)) {
+        return GatewayProtocol::errorResponse(QStringLiteral("color_correct"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("clip_not_found"), QStringLiteral("Нет клипа с таким clip_id."));
+    }
+    QList<QPair<QString, QString>> eq;
+    auto addEq = [&](const char *key, const char *avname) {
+        if (params.contains(QString::fromLatin1(key)))
+            eq << qMakePair(QString::fromLatin1(avname), QString::number(params.value(QString::fromLatin1(key)).toDouble()));
+    };
+    addEq("brightness", "av.brightness"); addEq("contrast", "av.contrast");
+    addEq("saturation", "av.saturation"); addEq("gamma", "av.gamma");
+    QList<QPair<QString, QString>> lgg;
+    for (const char *k : {"lift_r","lift_g","lift_b","gamma_r","gamma_g","gamma_b","gain_r","gain_g","gain_b"}) {
+        if (params.contains(QString::fromLatin1(k)))
+            lgg << qMakePair(QString::fromLatin1(k), QString::number(params.value(QString::fromLatin1(k)).toDouble()));
+    }
+    int rEq = -1, rTemp = -1, rLgg = -1, applied = 0;
+    if (!eq.isEmpty()) { rEq = gw_addEffectWithParams(clipId, QStringLiteral("avfilter.eq"), eq); if (rEq >= 0) ++applied; }
+    if (params.contains(QStringLiteral("temperature"))) {
+        const double mix = params.contains(QStringLiteral("temperature_mix")) ? params.value(QStringLiteral("temperature_mix")).toDouble() : 1.0;
+        rTemp = gw_addEffectWithParams(clipId, QStringLiteral("avfilter.colortemperature"),
+            {{QStringLiteral("av.temperature"), QString::number(params.value(QStringLiteral("temperature")).toDouble())},
+             {QStringLiteral("av.mix"), QString::number(mix)}});
+        if (rTemp >= 0) ++applied;
+    }
+    if (!lgg.isEmpty()) { rLgg = gw_addEffectWithParams(clipId, QStringLiteral("lift_gamma_gain"), lgg); if (rLgg >= 0) ++applied; }
+    if (applied == 0) {
+        return GatewayProtocol::errorResponse(QStringLiteral("color_correct"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("no_params"), QStringLiteral("Задай хотя бы один: brightness/contrast/saturation/gamma/temperature/lift_*/gamma_*/gain_*."));
+    }
+    return GatewayProtocol::successResponse(QStringLiteral("color_correct"), requestId, projectId(), timelineRevision(),
+        QJsonObject{{QStringLiteral("clip_id"), clipId}, {QStringLiteral("applied_effects"), applied},
+                    {QStringLiteral("eq_row"), rEq}, {QStringLiteral("temp_row"), rTemp}, {QStringLiteral("grade_row"), rLgg}});
+}
