+QList<KDDockWidgets::QtWidgets::DockWidget *> collectRuntimeUiDocks(const MainWindow *window)
+{
+    if (window == nullptr) {
+        return {};
+    }
+    return window->findChildren<KDDockWidgets::QtWidgets::DockWidget *>(QString(), Qt::FindChildrenRecursively);
+}
+
+QList<QDialog *> collectRuntimeUiDialogs()
+{
+    QList<QDialog *> result;
+    const QWidgetList topLevelWidgets = QApplication::topLevelWidgets();
+    for (QWidget *widget : topLevelWidgets) {
+        QDialog *dialog = qobject_cast<QDialog *>(widget);
+        if (dialog == nullptr) {
+            continue;
+        }
+        if (!dialog->isVisible()) {
+            continue;
+        }
+        result.push_back(dialog);
+    }
+    return result;
+}
+
+QString dockNameFromAction(const QAction *action)
+{
+    if (action == nullptr) {
+        return {};
+    }
+    const QString data = action->data().toString();
+    const int separator = data.lastIndexOf(QLatin1Char('#'));
+    if (separator >= 0 && separator + 1 < data.size()) {
+        return data.mid(separator + 1);
+    }
+    return action->objectName();
+}
+
+QString dockTitleFromAction(const QAction *action)
+{
+    if (action == nullptr) {
+        return {};
+    }
+    const QString data = action->data().toString();
+    const int separator = data.lastIndexOf(QLatin1Char('#'));
+    if (separator > 0) {
+        return data.left(separator);
+    }
+    return normalizedActionText(action->text());
+}
+
+bool isUiDockToggleAction(const QAction *action)
+{
+    if (action == nullptr) {
+        return false;
+    }
+    const QString data = action->data().toString();
+    return data.contains(QLatin1Char('#')) && !dockNameFromAction(action).trimmed().isEmpty();
+}
