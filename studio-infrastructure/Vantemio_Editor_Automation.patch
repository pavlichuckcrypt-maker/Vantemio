+QString GatewayService::handleActivateUiDialog(const QString &requestId, const QJsonObject &params)
+{
+    const QString dialogName = params.value(QStringLiteral("dialog_name")).toString();
+    const QString buttonName = params.value(QStringLiteral("button_name")).toString();
+    const QString buttonRole = params.value(QStringLiteral("button_role")).toString().trimmed().toLower();
+    const QString action = params.value(QStringLiteral("action")).toString().trimmed().toLower();
+    if (dialogName.trimmed().isEmpty()) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("activate_ui_dialog"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("invalid_parameters"),
+            QStringLiteral("activate_ui_dialog requires dialog_name.")
+        );
+    }
+
+    QDialog *dialog = findNamedUiDialog(dialogName);
+    if (dialog == nullptr) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("activate_ui_dialog"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("dialog_not_found"),
+            QStringLiteral("Requested UI dialog was not found.")
+        );
+    }
+
+    if (!buttonName.trimmed().isEmpty() || !buttonRole.isEmpty()) {
+        QAbstractButton *button = findNamedUiDialogButton(dialog, buttonName, buttonRole);
+        if (button == nullptr) {
+            return GatewayProtocol::errorResponse(
+                QStringLiteral("activate_ui_dialog"),
+                requestId,
+                projectId(),
+                timelineRevision(),
+                QStringLiteral("dialog_button_not_found"),
+                QStringLiteral("Requested dialog button was not found.")
+            );
+        }
+        if (!button->isEnabled()) {
+            return GatewayProtocol::errorResponse(
+                QStringLiteral("activate_ui_dialog"),
+                requestId,
+                projectId(),
+                timelineRevision(),
+                QStringLiteral("dialog_button_disabled"),
+                QStringLiteral("Requested dialog button is currently disabled.")
+            );
+        }
+        button->click();
+    } else if (action == QStringLiteral("accept")) {
+        dialog->accept();
+    } else if (action == QStringLiteral("reject")) {
+        dialog->reject();
+    } else if (action == QStringLiteral("close")) {
+        dialog->close();
+    } else {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("activate_ui_dialog"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("invalid_parameters"),
+            QStringLiteral("activate_ui_dialog requires button_name, button_role, or action.")
+        );
+    }
+
+    ++m_timelineRevision;
+    return GatewayProtocol::successResponse(
+        QStringLiteral("activate_ui_dialog"),
+        requestId,
+        projectId(),
+        timelineRevision(),
+        serializeUiDialog(dialog)
+    );
+}
