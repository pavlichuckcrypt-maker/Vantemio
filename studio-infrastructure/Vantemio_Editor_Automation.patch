+
+QString GatewayService::gw_runAudioTool(const QString &mode, const QString &path) const
+{
+    const QByteArray envScript = qgetenv("VIDRA_AUDIO_SCRIPT");
+    const QString script = !envScript.isEmpty() ? QString::fromUtf8(envScript)
+                                                 : QDir::homePath() + QStringLiteral("/AIMmontag/vidra_audio.py");
+    QProcess p; // python3 системный (DYLD для ffmpeg задаёт сам скрипт)
+    p.start(QStringLiteral("/usr/bin/python3"), QStringList{script, mode, path, KdenliveSettings::ffmpegpath()});
+    if (!waitProcessPumped(p, 30000, QStringLiteral("analyze_audio"))) { return QString(); }
+    return QString::fromUtf8(p.readAllStandardOutput()).trimmed();
+}
