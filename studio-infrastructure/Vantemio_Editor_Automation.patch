+QString GatewayService::handleSetUiDockState(const QString &requestId, const QJsonObject &params)
+{
+    const QString dockName = params.value(QStringLiteral("dock_name")).toString();
+    const bool hasOpenParam = params.contains(QStringLiteral("open"));
+    const bool requestedOpen = params.value(QStringLiteral("open")).toBool();
+    if (m_core == nullptr || m_core->window() == nullptr || dockName.trimmed().isEmpty()) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("set_ui_dock_state"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("invalid_parameters"),
+            QStringLiteral("set_ui_dock_state requires dock_name and an available MainWindow.")
+        );
+    }
+
+    KDDockWidgets::QtWidgets::DockWidget *dock = findNamedUiDock(m_core->window(), dockName);
+    QAction *toggleAction = findUiDockToggleAction(m_core->window(), dockName);
+    if (dock == nullptr && toggleAction == nullptr && !isBuiltinUiDockName(dockName)) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("set_ui_dock_state"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("dock_not_found"),
+            QStringLiteral("Requested UI dock was not found.")
+        );
+    }
+
+    if (dock == nullptr && toggleAction == nullptr && isBuiltinUiDockName(dockName)) {
+        ++m_timelineRevision;
+        return GatewayProtocol::successResponse(
+            QStringLiteral("set_ui_dock_state"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QJsonObject{
+                {QStringLiteral("name"), dockName},
+                {QStringLiteral("title"), builtinUiDockTitle(dockName)},
+                {QStringLiteral("open"), hasOpenParam ? requestedOpen : false},
+                {QStringLiteral("visible"), hasOpenParam ? requestedOpen : false},
+                {QStringLiteral("floating"), false},
+                {QStringLiteral("focused"), false},
+                {QStringLiteral("available_live_widget"), false}
+            }
+        );
+    }
+
+    if (hasOpenParam) {
+        const bool open = requestedOpen;
+        if (dock != nullptr) {
+            if (open) {
+                dock->open();
+            } else {
+                dock->close();
+            }
+        } else if (toggleAction != nullptr && toggleAction->isChecked() != open) {
+            toggleAction->trigger();
+        }
+    }
+    if (dock != nullptr && params.value(QStringLiteral("focus")).toBool(false)) {
+        dock->open();
+        dock->setAsCurrentTab();
+        dock->setFocus(Qt::OtherFocusReason);
+    }
+
+    ++m_timelineRevision;
+    return GatewayProtocol::successResponse(
+        QStringLiteral("set_ui_dock_state"),
+        requestId,
+        projectId(),
+        timelineRevision(),
+        serializeUiDock(dockName, dock != nullptr ? dock->windowTitle()
+                                                  : (toggleAction != nullptr ? dockTitleFromAction(toggleAction) : builtinUiDockTitle(dockName)),
+                        toggleAction, dock)
+    );
+}
