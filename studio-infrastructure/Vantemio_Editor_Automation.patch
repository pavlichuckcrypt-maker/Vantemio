+QJsonArray jsonArrayFromIntSet(const std::unordered_set<int> &values)
+{
+    QList<int> ordered;
+    ordered.reserve(int(values.size()));
+    for (int value : values) {
+        ordered.push_back(value);
+    }
+    std::sort(ordered.begin(), ordered.end());
+
+    QJsonArray result;
+    for (int value : ordered) {
+        result.push_back(value);
+    }
+    return result;
+}
+
+QJsonArray jsonArrayFromVariantList(const QVariantList &values)
+{
+    QJsonArray result;
+    for (const QVariant &value : values) {
+        result.push_back(QJsonValue::fromVariant(value));
+    }
+    return result;
+}
+
+QString clipStateString(PlaylistState::ClipState state)
+{
+    switch (state) {
+    case PlaylistState::VideoOnly:
+        return QStringLiteral("video_only");
+    case PlaylistState::AudioOnly:
+        return QStringLiteral("audio_only");
+    case PlaylistState::Disabled:
+        return QStringLiteral("disabled");
+    default:
+        return QStringLiteral("unknown");
+    }
+}
+
+QString normalizedActionText(QString text)
+{
+    text.replace(QLatin1Char('&'), QString());
+    const int tabPos = text.indexOf(QLatin1Char('\t'));
+    if (tabPos >= 0) {
+        text = text.left(tabPos);
+    }
+    text.replace(QStringLiteral("..."), QStringLiteral(" "));
+    text.replace(QChar(0x2026), QLatin1Char(' '));
+    return text.trimmed();
+}
+
+QString sanitizeAutomationToken(QString text)
+{
+    text = normalizedActionText(text).toLower();
+    QString result;
+    result.reserve(text.size());
+    bool previousUnderscore = false;
+    for (const QChar ch : text) {
+        if (ch.isLetterOrNumber()) {
+            result.append(ch);
+            previousUnderscore = false;
+            continue;
+        }
+        if (!previousUnderscore) {
+            result.append(QLatin1Char('_'));
+            previousUnderscore = true;
+        }
+    }
+    while (result.startsWith(QLatin1Char('_'))) {
+        result.remove(0, 1);
+    }
+    while (result.endsWith(QLatin1Char('_'))) {
+        result.chop(1);
+    }
+    return result;
+}
+
+QString automationObjectLabel(const QObject *object)
+{
+    if (object == nullptr) {
+        return QStringLiteral("null");
+    }
+    if (!object->objectName().trimmed().isEmpty()) {
+        return object->objectName().trimmed();
+    }
+    if (const auto *action = qobject_cast<const QAction *>(object)) {
+        const QString text = sanitizeAutomationToken(action->text());
+        if (!text.isEmpty()) {
+            return text;
+        }
+        const QString toolTip = sanitizeAutomationToken(action->toolTip());
+        if (!toolTip.isEmpty()) {
+            return toolTip;
+        }
+    }
+    if (const auto *menu = qobject_cast<const QMenu *>(object)) {
+        const QString title = sanitizeAutomationToken(menu->title());
+        if (!title.isEmpty()) {
+            return title;
+        }
+    }
+    if (const auto *widget = qobject_cast<const QWidget *>(object)) {
+        const QString accessibleName = sanitizeAutomationToken(widget->accessibleName());
+        if (!accessibleName.isEmpty()) {
+            return accessibleName;
+        }
+        const QString windowTitle = sanitizeAutomationToken(widget->windowTitle());
+        if (!windowTitle.isEmpty()) {
+            return windowTitle;
+        }
+        const QString toolTip = sanitizeAutomationToken(widget->toolTip());
+        if (!toolTip.isEmpty()) {
+            return toolTip;
+        }
+        if (const auto *button = qobject_cast<const QAbstractButton *>(widget)) {
+            const QString text = sanitizeAutomationToken(button->text());
+            if (!text.isEmpty()) {
+                return text;
+            }
+        }
+        if (const auto *lineEdit = qobject_cast<const QLineEdit *>(widget)) {
+            const QString placeholder = sanitizeAutomationToken(lineEdit->placeholderText());
+            if (!placeholder.isEmpty()) {
+                return placeholder;
+            }
+        }
+    }
+    return sanitizeAutomationToken(QString::fromUtf8(object->metaObject()->className()));
+}
+
+int automationSiblingIndex(const QObject *object)
+{
+    if (object == nullptr || object->parent() == nullptr) {
+        return 0;
+    }
+    const QString className = QString::fromUtf8(object->metaObject()->className());
+    const QString label = automationObjectLabel(object);
+    int index = 0;
+    const QObjectList siblings = object->parent()->children();
+    for (QObject *sibling : siblings) {
+        if (sibling == nullptr) {
+            continue;
+        }
+        if (QString::fromUtf8(sibling->metaObject()->className()) == className && automationObjectLabel(sibling) == label) {
+            if (sibling == object) {
+                return index;
+            }
+            ++index;
+        }
+    }
+    return index;
+}
+
+QString automationIdForObject(const QObject *object)
+{
+    if (object == nullptr) {
+        return {};
+    }
+    if (!object->objectName().trimmed().isEmpty()) {
+        return object->objectName().trimmed();
+    }
+
+    QStringList segments;
+    const QObject *current = object;
+    while (current != nullptr) {
+        const QString classToken = sanitizeAutomationToken(QString::fromUtf8(current->metaObject()->className()));
+        const QString labelToken = automationObjectLabel(current);
+        const int siblingIndex = automationSiblingIndex(current);
+        segments.push_front(classToken + QLatin1Char('_') + labelToken + QLatin1Char('_') + QString::number(siblingIndex));
+        current = current->parent();
+        if (qobject_cast<const MainWindow *>(current) != nullptr) {
+            segments.push_front(QStringLiteral("mainwindow"));
+            break;
+        }
+    }
+    return segments.join(QStringLiteral("/"));
+}
+
+QList<QAction *> collectRuntimeUiActions(const MainWindow *window)
+{
+    QList<QAction *> result;
+    if (window == nullptr) {
+        return result;
+    }
+
+    QSet<QAction *> seen;
+    auto appendAction = [&](QAction *action) {
+        if (action == nullptr || action->isSeparator() || seen.contains(action)) {
+            return;
+        }
+        if (action->objectName().trimmed().isEmpty() && normalizedActionText(action->text()).isEmpty() && normalizedActionText(action->toolTip()).isEmpty()) {
+            return;
+        }
+        seen.insert(action);
+        result.push_back(action);
+    };
+
+    if (window->actionCollection() != nullptr) {
+        const QList<QAction *> collectionActions = window->actionCollection()->actions();
+        for (QAction *action : collectionActions) {
+            appendAction(action);
+        }
+    }
+
+    const auto objectActions = window->findChildren<QAction *>(QString(), Qt::FindChildrenRecursively);
+    for (QAction *action : objectActions) {
+        appendAction(action);
+    }
+
+    const auto widgets = window->findChildren<QWidget *>(QString(), Qt::FindChildrenRecursively);
+    for (QWidget *widget : widgets) {
+        for (QAction *action : widget->actions()) {
+            appendAction(action);
+        }
+    }
+
+    const auto menus = window->findChildren<QMenu *>(QString(), Qt::FindChildrenRecursively);
+    for (QMenu *menu : menus) {
+        for (QAction *action : menu->actions()) {
+            appendAction(action);
+        }
+    }
+
+    return result;
+}
