+QString GatewayService::handleApplyTransition(const QString &requestId, int clipId, const QString &transitionName, int durationFrames, const QString &transitionParamsJson)
+{
+    auto timelineModel = currentTimelineModel();
+    auto controller = currentController();
+    if (!timelineModel || controller == nullptr || clipId < 0 || transitionName.trimmed().isEmpty() || !timelineModel->isClip(clipId)) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("apply_transition"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("invalid_parameters"),
+            QStringLiteral("apply_transition requires an existing clip_id and transition_name.")
+        );
+    }
+
+    // Валидируем имя перехода ДО применения (избегаем модального диалога/зависания).
+    if (!TransitionsRepository::get()->exists(transitionName)) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("apply_transition"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("transition_not_found"),
+            QStringLiteral("Нет перехода с таким transition_name (см. list_all_transitions).")
+        );
+    }
+
+    const int compositionId = controller->addCompositionToClip(transitionName, clipId, 0);
+    if (compositionId < 0) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("apply_transition"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("transition_insert_failed"),
+            QStringLiteral("Timeline rejected transition insertion.")
+        );
+    }
+    if (durationFrames > 0) {
+        timelineModel->requestItemResize(compositionId, durationFrames, true, true);
+    }
+
+    ++m_timelineRevision;
+    return GatewayProtocol::successResponse(
+        QStringLiteral("apply_transition"),
+        requestId,
+        projectId(),
+        timelineRevision(),
+        QJsonObject{
+            {QStringLiteral("clip_id"), clipId},
+            {QStringLiteral("composition_id"), compositionId},
+            {QStringLiteral("transition_name"), transitionName},
+            {QStringLiteral("duration_frames"), durationFrames},
+            {QStringLiteral("transition_params_json"), transitionParamsJson}
+        }
+    );
+}
