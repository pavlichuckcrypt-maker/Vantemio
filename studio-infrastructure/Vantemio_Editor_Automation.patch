+// ============================================================================
+// Типизированные эффекты (через модель Kdenlive — видно в интерфейсе, с undo).
+// clip_id = id клипа на ТАЙМЛАЙНЕ (из insert_clip/list_tracks).
+// ============================================================================
+QString GatewayService::handleListEffects(const QString &requestId, const QJsonObject &params) const
+{
+    auto tl = currentTimelineModel();
+    if (!tl) {
+        return GatewayProtocol::errorResponse(QStringLiteral("list_effects"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("no_timeline"), QStringLiteral("No active timeline."));
+    }
+    const int clipId = params.value(QStringLiteral("clip_id")).toInt();
+    if (!tl->isClip(clipId)) {
+        return GatewayProtocol::errorResponse(QStringLiteral("list_effects"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("clip_not_found"), QStringLiteral("Нет клипа таймлайна с таким clip_id (см. list_tracks)."));
+    }
+    std::shared_ptr<EffectStackModel> stack = tl->getClipEffectStackModel(clipId);
+    if (!stack) {
+        return GatewayProtocol::errorResponse(QStringLiteral("list_effects"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("no_effect_stack"), QStringLiteral("Clip has no effect stack (проверь clip_id таймлайна)."));
+    }
+    QJsonArray effects;
+    const int rows = stack->rowCount();
+    for (int r = 0; r < rows; ++r) {
+        std::shared_ptr<EffectItemModel> eff = std::dynamic_pointer_cast<EffectItemModel>(stack->getEffectStackRow(r));
+        if (!eff) {
+            continue;
+        }
+        QJsonArray ps;
+        const QVector<QPair<QString, QVariant>> all = eff->getAllParameters();
+        for (const auto &pr : all) {
+            ps.append(QJsonObject{{QStringLiteral("name"), pr.first}, {QStringLiteral("value"), pr.second.toString()}});
+        }
+        // Зона эффекта (на каком участке клипа действует) и вкл/выкл — чтобы мозг
+        // видел картину и мог точечно менять/убирать эффекты по кускам.
+        const QPair<int, int> io = eff->getInOut();
+        const bool zoned = eff->hasForcedInOut();
+        effects.append(QJsonObject{
+            {QStringLiteral("row"), r},
+            {QStringLiteral("effect_id"), eff->getAssetId()},
+            {QStringLiteral("enabled"), eff->isAssetEnabled()},
+            {QStringLiteral("zoned"), zoned},
+            {QStringLiteral("in"), io.first},
+            {QStringLiteral("out"), io.second},
+            {QStringLiteral("params"), ps},
+        });
+    }
+    return GatewayProtocol::successResponse(QStringLiteral("list_effects"), requestId, projectId(), timelineRevision(),
+        QJsonObject{{QStringLiteral("clip_id"), clipId}, {QStringLiteral("count"), effects.size()}, {QStringLiteral("effects"), effects}});
+}
