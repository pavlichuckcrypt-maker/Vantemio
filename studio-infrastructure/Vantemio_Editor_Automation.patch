+QString GatewayService::handleMacroSave(const QString &requestId, const QJsonObject &params)
+{
+    loadMacros();
+    const QString name = params.value(QStringLiteral("name")).toString();
+    const QJsonArray commands = params.value(QStringLiteral("commands")).toArray();
+    if (name.isEmpty() || commands.isEmpty()) {
+        return GatewayProtocol::errorResponse(QStringLiteral("macro_save"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("invalid_parameters"), QStringLiteral("macro_save requires name and non-empty commands array."));
+    }
+    QJsonObject macro;
+    macro.insert(QStringLiteral("description"), params.value(QStringLiteral("description")).toString());
+    macro.insert(QStringLiteral("commands"), commands);
+    macro.insert(QStringLiteral("vars"), params.value(QStringLiteral("vars")).toObject());
+    m_macros.insert(name, macro);
+    saveMacros();
+    return GatewayProtocol::successResponse(QStringLiteral("macro_save"), requestId, projectId(), timelineRevision(),
+        QJsonObject{{QStringLiteral("name"), name}, {QStringLiteral("command_count"), commands.size()}, {QStringLiteral("saved"), true}});
+}
+
+QString GatewayService::handleMacroRun(const QString &requestId, const QJsonObject &params)
+{
+    loadMacros();
+    const QString name = params.value(QStringLiteral("name")).toString();
+    if (!m_macros.contains(name)) {
+        return GatewayProtocol::errorResponse(QStringLiteral("macro_run"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("macro_not_found"), QStringLiteral("No macro/template with that name."));
+    }
+    const QJsonObject macro = m_macros.value(name).toObject();
+    // Слияние дефолтных vars макроса и переданных при запуске.
+    QJsonObject vars = macro.value(QStringLiteral("vars")).toObject();
+    const QJsonObject runVars = params.value(QStringLiteral("vars")).toObject();
+    for (auto it = runVars.constBegin(); it != runVars.constEnd(); ++it) {
+        vars.insert(it.key(), it.value());
+    }
+    const QJsonArray commands = macro.value(QStringLiteral("commands")).toArray();
+    QJsonArray results;
+    int okCount = 0;
+    for (const QJsonValue &cv : commands) {
+        if (!cv.isObject()) {
+            continue;
+        }
+        const QJsonObject substituted = gw_substituteVars(cv.toObject(), vars).toObject();
+        const QString resp = handleCommand(QString::fromUtf8(QJsonDocument(substituted).toJson(QJsonDocument::Compact)));
+        const QJsonDocument rd = QJsonDocument::fromJson(resp.toUtf8());
+        results.append(rd.isObject() ? rd.object() : QJsonObject{{QStringLiteral("raw"), resp}});
+        if (rd.isObject() && rd.object().value(QStringLiteral("status")).toString() == QStringLiteral("ok")) {
+            ++okCount;
+        }
+    }
+    return GatewayProtocol::successResponse(QStringLiteral("macro_run"), requestId, projectId(), timelineRevision(),
+        QJsonObject{{QStringLiteral("name"), name}, {QStringLiteral("count"), results.size()}, {QStringLiteral("ok_count"), okCount}, {QStringLiteral("results"), results}});
+}
+
+QString GatewayService::handleMacroList(const QString &requestId, const QJsonObject &params) const
+{
+    Q_UNUSED(params)
+    const_cast<GatewayService *>(this)->loadMacros();
+    QJsonArray arr;
+    for (auto it = m_macros.constBegin(); it != m_macros.constEnd(); ++it) {
+        const QJsonObject m = it.value().toObject();
+        arr.append(QJsonObject{
+            {QStringLiteral("name"), it.key()},
+            {QStringLiteral("description"), m.value(QStringLiteral("description")).toString()},
+            {QStringLiteral("command_count"), m.value(QStringLiteral("commands")).toArray().size()},
+        });
+    }
+    return GatewayProtocol::successResponse(QStringLiteral("macro_list"), requestId, projectId(), timelineRevision(),
+        QJsonObject{{QStringLiteral("count"), arr.size()}, {QStringLiteral("macros"), arr}});
+}
+
+QString GatewayService::handleMacroGet(const QString &requestId, const QJsonObject &params) const
+{
+    const_cast<GatewayService *>(this)->loadMacros();
+    const QString name = params.value(QStringLiteral("name")).toString();
+    if (!m_macros.contains(name)) {
+        return GatewayProtocol::errorResponse(QStringLiteral("macro_get"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("macro_not_found"), QStringLiteral("No macro/template with that name."));
+    }
+    return GatewayProtocol::successResponse(QStringLiteral("macro_get"), requestId, projectId(), timelineRevision(),
+        QJsonObject{{QStringLiteral("name"), name}, {QStringLiteral("macro"), m_macros.value(name).toObject()}});
+}
+
+QString GatewayService::handleMacroDelete(const QString &requestId, const QJsonObject &params)
+{
+    loadMacros();
+    const QString name = params.value(QStringLiteral("name")).toString();
+    const bool existed = m_macros.contains(name);
+    if (existed) {
+        m_macros.remove(name);
+        saveMacros();
+    }
+    return GatewayProtocol::successResponse(QStringLiteral("macro_delete"), requestId, projectId(), timelineRevision(),
+        QJsonObject{{QStringLiteral("name"), name}, {QStringLiteral("deleted"), existed}});
+}
