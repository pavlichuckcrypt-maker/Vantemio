+// Посегментный рендер: сохраняем копию проекта, генерим shell-скрипт
+// (melt по чанкам + ffmpeg concat) и запускаем его как async-процесс.
+// Свежий melt на каждый кусок => нет накопления памяти => нет краша на длинных.
+QString GatewayService::gw_renderSegmented(const QString &requestId, const QString &outputPath, int totalFrames, int chunkFrames, const QJsonObject &extra)
+{
+    auto shq = [](const QString &s) -> QString { QString r = s; r.replace(QStringLiteral("'"), QStringLiteral("'\\''")); return QStringLiteral("'") + r + QStringLiteral("'"); };
+    auto err = [&](const QString &code, const QString &msg) {
+        m_lastRenderStatus = QStringLiteral("failed"); m_lastRenderError = msg;
+        return GatewayProtocol::errorResponse(QStringLiteral("render_master"), requestId, projectId(), timelineRevision(), code, msg);
+    };
+    if (m_core == nullptr || m_core->projectManager() == nullptr)
+        return err(QStringLiteral("project_unavailable"), QStringLiteral("ProjectManager недоступен."));
+    const QString work = QDir::tempPath();
+    // УНИКАЛЬНЫЕ пути на каждый рендер (revision+pid): фиксированный путь давал ГОНКУ при
+    // быстрых последовательных рендерах — новый saveFileAs перезаписывал .kdenlive, пока melt
+    // прошлого рендера ещё читал его → битый bin-playlist → чанки молча падали (флейк «файл нет»).
+    const QString rtag = QString::number(timelineRevision()) + QLatin1Char('_') + QString::number(QCoreApplication::applicationPid());
+    const QString tmpProj = work + QStringLiteral("/vidra_segrender_") + rtag + QStringLiteral(".kdenlive");
+    // saveACopy=true: сохраняем копию, НЕ меняя текущий проект пользователя
+    if (!m_core->projectManager()->saveFileAs(tmpProj, true, true))
+        return err(QStringLiteral("save_copy_failed"), QStringLiteral("Не удалось сохранить копию проекта для рендера."));
+    const QString melt = KdenliveSettings::meltpath();
+    const QString ff = KdenliveSettings::ffmpegpath();
+    if (melt.isEmpty() || ff.isEmpty())
+        return err(QStringLiteral("renderer_paths_missing"), QStringLiteral("Не заданы пути melt/ffmpeg в настройках."));
+    const QString workDir = work + QStringLiteral("/vidra_seg_") + rtag;
+    QString sc;
+    sc += QStringLiteral("#!/bin/zsh\nsetopt NULL_GLOB 2>/dev/null\n");
+    sc += QStringLiteral("MELT=%1\nFF=%2\n").arg(shq(melt), shq(ff));
+    sc += QStringLiteral("CR=${MELT:h:h}\n");
+    sc += QStringLiteral("export DYLD_LIBRARY_PATH=$CR/lib DYLD_FRAMEWORK_PATH=$CR/lib\n");
+    sc += QStringLiteral("export MLT_REPOSITORY=$CR/plugins/mlt MLT_DATA=$CR/share/mlt MLT_PROFILES_PATH=$CR/share/mlt/profiles\n");
+    sc += QStringLiteral("P=%1\nOUT=%2\nW=%3\nTOTAL=%4\nCH=%5\n")
+            .arg(shq(tmpProj), shq(outputPath), shq(workDir), QString::number(totalFrames), QString::number(chunkFrames));
+    // Масштаб/качество из запроса (обучение = 480p/720p; сегментный путь раньше их ИГНОРИРОВАЛ,
+    // рендер всегда шёл в разрешении проекта). crf по умолчанию 18; width/height 0 = не масштабировать.
+    const int crfVal = extra.value(QStringLiteral("crf")).toInt(18);
+    const int wVal = extra.value(QStringLiteral("width")).toInt(0);
+    const int hVal = extra.value(QStringLiteral("height")).toInt(0);
+    sc += QStringLiteral("CRF=%1\nVW=%2\nVH=%3\n").arg(QString::number(crfVal), QString::number(wVal), QString::number(hVal));
+    // SCALE передаём в melt-consumer как отдельные слова (zsh ${=SCALE} делает word-split)
+    sc += QStringLiteral("SCALE=\"\"; [ $VW -gt 0 ] && [ $VH -gt 0 ] && SCALE=\"width=$VW height=$VH\"\n");
+    sc += QStringLiteral("NCH=$(((TOTAL+CH-1)/CH))\n");
+    sc += QStringLiteral("rm -rf \"$W\"; mkdir -p \"$W\"; : > \"$W/list.txt\"\n");
+    sc += QStringLiteral("i=0; s=0\nwhile [ $s -lt $TOTAL ]; do\n");
+    sc += QStringLiteral("  e=$((s+CH-1)); [ $e -ge $TOTAL ] && e=$((TOTAL-1))\n");
+    sc += QStringLiteral("  o=\"$W/seg_$(printf '%05d' $i).mp4\"\n");
+    sc += QStringLiteral("  ok=0\n");
+    sc += QStringLiteral("  for try in 1 2 3; do\n");
+    sc += QStringLiteral("    \"$MELT\" \"$P\" in=$s out=$e -consumer avformat:\"$o\" vcodec=libx264 crf=$CRF pix_fmt=yuv420p acodec=aac ab=192k ${=SCALE} && [ -s \"$o\" ] && { ok=1; break; }\n");
+    sc += QStringLiteral("    echo \"VIDRA_RETRY $i $try\"; sleep 1\n");
+    sc += QStringLiteral("  done\n");
+    sc += QStringLiteral("  [ $ok -eq 1 ] || exit 7\n");
+    sc += QStringLiteral("  echo \"file '$o'\" >> \"$W/list.txt\"\n");
+    sc += QStringLiteral("  i=$((i+1)); s=$((e+1)); echo \"VIDRA_PROGRESS $i $NCH\"\n");
+    sc += QStringLiteral("done\necho \"VIDRA_PROGRESS_CONCAT\"\n");
+    sc += QStringLiteral("\"$FF\" -y -f concat -safe 0 -i \"$W/list.txt\" -c copy -movflags +faststart \"$OUT\" || exit 8\n");
+    sc += QStringLiteral("rm -rf \"$W\"\n");
+    const QString scriptPath = work + QStringLiteral("/vidra_segrender_") + rtag + QStringLiteral(".sh");
+    QFile f(scriptPath);
+    if (!f.open(QIODevice::WriteOnly | QIODevice::Truncate))
+        return err(QStringLiteral("script_write_failed"), QStringLiteral("Не удалось записать скрипт рендера."));
+    f.write(sc.toUtf8()); f.close();
+    const int chunks = (totalFrames + chunkFrames - 1) / chunkFrames;
+    if (m_renderProc != nullptr) { m_renderProc->deleteLater(); m_renderProc = nullptr; }
+    m_renderProc = new QProcess(this);
+    const QString outForEvent = outputPath;
+    // Прогресс по чанкам: скрипт печатает VIDRA_PROGRESS <done> <total> в stdout,
+    // gateway транслирует мозгу как render.progress (видно % рендера).
+    QProcess *proc = m_renderProc;
+    connect(proc, &QProcess::readyReadStandardOutput, this, [this, proc]() {
+        while (proc->canReadLine()) {
+            const QByteArray ln = proc->readLine().trimmed();
+            if (ln.startsWith("VIDRA_PROGRESS_CONCAT")) {
+                pushEvent(QJsonObject{{QStringLiteral("kind"), QStringLiteral("event")}, {QStringLiteral("event"), QStringLiteral("render.progress")}, {QStringLiteral("phase"), QStringLiteral("concat")}, {QStringLiteral("percent"), 99}});
+            } else if (ln.startsWith("VIDRA_RETRY")) {
+                const QList<QByteArray> p = ln.split(' ');
+                pushEvent(QJsonObject{{QStringLiteral("kind"), QStringLiteral("event")}, {QStringLiteral("event"), QStringLiteral("render.progress")}, {QStringLiteral("phase"), QStringLiteral("retry")},
+                    {QStringLiteral("chunk"), p.size() > 1 ? p.at(1).toInt() : -1}, {QStringLiteral("attempt"), p.size() > 2 ? p.at(2).toInt() : -1}});
+            } else if (ln.startsWith("VIDRA_PROGRESS")) {
+                const QList<QByteArray> p = ln.split(' ');
+                if (p.size() >= 3) {
+                    const int done = p.at(1).toInt();
+                    const int tot = p.at(2).toInt();
+                    pushEvent(QJsonObject{{QStringLiteral("kind"), QStringLiteral("event")}, {QStringLiteral("event"), QStringLiteral("render.progress")}, {QStringLiteral("chunk"), done}, {QStringLiteral("chunks"), tot}, {QStringLiteral("percent"), tot > 0 ? done * 100 / tot : 0}});
+                }
+            }
+        }
+    });
+    connect(m_renderProc, &QProcess::finished, this,
+        [this, outForEvent](int code, QProcess::ExitStatus) {
+            m_lastRenderStatus = (code == 0) ? QStringLiteral("done") : QStringLiteral("failed");
+            pushEvent(QJsonObject{
+                {QStringLiteral("kind"), QStringLiteral("event")},
+                {QStringLiteral("event"), QStringLiteral("render.finished")},
+                {QStringLiteral("output"), outForEvent},
+                {QStringLiteral("exit_code"), code},
+                {QStringLiteral("status"), m_lastRenderStatus},
+                {QStringLiteral("mode"), QStringLiteral("segmented")},
+            });
+        });
+    m_renderProc->start(QStringLiteral("/bin/zsh"), QStringList{scriptPath});
+    const bool ok = m_renderProc->waitForStarted(5000);
+    m_lastRenderStatus = ok ? QStringLiteral("started_async") : QStringLiteral("failed");
+    m_lastRenderOutput = outputPath;
+    m_lastRenderPreset = QStringLiteral("segmented-h264");
+    if (!ok)
+        return err(QStringLiteral("render_start_failed"), QStringLiteral("Процесс рендера не стартовал."));
+    pushEvent(QJsonObject{
+        {QStringLiteral("kind"), QStringLiteral("event")},
+        {QStringLiteral("event"), QStringLiteral("render.started")},
+        {QStringLiteral("output"), outputPath},
+        {QStringLiteral("mode"), QStringLiteral("segmented")},
+        {QStringLiteral("chunks"), chunks},
+    });
+    return GatewayProtocol::successResponse(
+        QStringLiteral("render_master"), requestId, projectId(), timelineRevision(),
+        QJsonObject{
+            {QStringLiteral("output_path"), outputPath},
+            {QStringLiteral("mode"), QStringLiteral("segmented")},
+            {QStringLiteral("chunk_frames"), chunkFrames},
+            {QStringLiteral("total_frames"), totalFrames},
+            {QStringLiteral("chunks"), chunks},
+            {QStringLiteral("async"), true},
+            {QStringLiteral("status"), m_lastRenderStatus},
+        });
+}
+
+QString GatewayService::handleRenderPreview(const QString &requestId, const QString &outputPath, const QString &preset, bool asyncMode)
+{
+    const QString previewPreset = preset.isEmpty() ? QStringLiteral("H.264 (libx264+aac)") : preset;
+    return handleRenderMaster(requestId, outputPath, previewPreset, asyncMode).replace(QStringLiteral("render_master"), QStringLiteral("render_preview"));
+}
