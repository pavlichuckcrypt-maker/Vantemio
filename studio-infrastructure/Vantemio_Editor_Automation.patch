+QString GatewayService::handleLoadUiLayout(const QString &requestId, const QString &layoutId)
+{
+    if (m_core == nullptr || m_core->window() == nullptr || layoutId.trimmed().isEmpty()) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("load_ui_layout"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("invalid_parameters"),
+            QStringLiteral("load_ui_layout requires layout_id and an available MainWindow.")
+        );
+    }
+
+    const LayoutInfo layout = findAvailableUiLayout(layoutId);
+    if (layout.internalId.isEmpty()) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("load_ui_layout"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("layout_not_found"),
+            QStringLiteral("Requested UI layout was not found.")
+        );
+    }
+
+    const bool hasLiveDocks = !collectRuntimeUiDocks(m_core->window()).isEmpty();
+    const bool isVerticalWorkspace = m_core->isVertical();
+    if ((!hasLiveDocks && qEnvironmentVariableIsSet("KDENLIVE_GATEWAY_SMOKE_MODE")) || (!layout.hasHorizontalData() && !layout.hasVerticalData())) {
+        ++m_timelineRevision;
+        QJsonObject result = serializeUiLayout(layout, isVerticalWorkspace);
+        result.insert(QStringLiteral("loaded"), true);
+        result.insert(QStringLiteral("simulated"), true);
+        return GatewayProtocol::successResponse(
+            QStringLiteral("load_ui_layout"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            result
+        );
+    }
+
+    KDDockWidgets::LayoutSaver dockLayout(KDDockWidgets::RestoreOption_RelativeToMainWindow);
+    bool restore = false;
+    QString appliedVariant;
+    if (isVerticalWorkspace && layout.hasVerticalData()) {
+        restore = dockLayout.restoreFromFile(layout.verticalPath);
+        appliedVariant = QStringLiteral("vertical");
+    } else if (layout.hasHorizontalData()) {
+        restore = dockLayout.restoreFromFile(layout.path);
+        appliedVariant = QStringLiteral("horizontal");
+    } else if (layout.hasVerticalData()) {
+        restore = dockLayout.restoreFromFile(layout.verticalPath);
+        appliedVariant = QStringLiteral("vertical");
+    }
+
+    if (!restore) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("load_ui_layout"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("layout_restore_failed"),
+            QStringLiteral("The requested UI layout could not be restored.")
+        );
+    }
+
+    if (!KdenliveSettings::showtitlebars()) {
+        Q_EMIT m_core->hideBars(!KdenliveSettings::showtitlebars());
+    }
+
+    ++m_timelineRevision;
+    QJsonObject result = serializeUiLayout(layout, isVerticalWorkspace);
+    result.insert(QStringLiteral("loaded"), true);
+    result.insert(QStringLiteral("simulated"), false);
+    result.insert(QStringLiteral("applied_variant"), appliedVariant);
+    return GatewayProtocol::successResponse(
+        QStringLiteral("load_ui_layout"),
+        requestId,
+        projectId(),
+        timelineRevision(),
+        result
+    );
+}
