+QString GatewayService::handleOpenUiLibraryTool(const QString &requestId, const QJsonObject &params)
+{
+    LibraryWidget *library = m_core != nullptr ? m_core->library() : nullptr;
+    if (library == nullptr) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("open_ui_library_tool"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("library_unavailable"),
+            QStringLiteral("Library widget is not available.")
+        );
+    }
+
+    const QString toolId = params.value(QStringLiteral("tool_id")).toString();
+    if (toolId.trimmed().isEmpty()) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("open_ui_library_tool"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("invalid_parameters"),
+            QStringLiteral("open_ui_library_tool requires tool_id.")
+        );
+    }
+
+    const std::optional<UiLibraryToolSpec> spec = findUiLibraryToolSpec(toolId);
+    if (!spec.has_value()) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("open_ui_library_tool"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("library_tool_not_found"),
+            QStringLiteral("Requested library tool was not found.")
+        );
+    }
+
+    bool performed = false;
+    QAction *action = nullptr;
+    if (spec->kind == QStringLiteral("action")) {
+        action = findUiAction(m_core->window(), spec->targetName);
+        if (action != nullptr && action->isEnabled()) {
+            action->trigger();
+            performed = true;
+        }
+    } else if (spec->toolId == QStringLiteral("add_clip_to_project")) {
+        performed = library->addItemToProject(params.value(QStringLiteral("item_path")).toString());
+    } else if (spec->toolId == QStringLiteral("create_folder")) {
+        const QString folderName = params.value(QStringLiteral("folder_name")).toString();
+        if (folderName.trimmed().isEmpty()) {
+            return GatewayProtocol::errorResponse(
+                QStringLiteral("open_ui_library_tool"),
+                requestId,
+                projectId(),
+                timelineRevision(),
+                QStringLiteral("invalid_parameters"),
+                QStringLiteral("create_folder requires folder_name.")
+            );
+        }
+        performed = library->createFolder(folderName, params.value(QStringLiteral("parent_path")).toString());
+    } else if (spec->toolId == QStringLiteral("rename_item")) {
+        const QString itemPath = params.value(QStringLiteral("item_path")).toString();
+        const QString newName = params.value(QStringLiteral("new_name")).toString();
+        if (itemPath.trimmed().isEmpty() || newName.trimmed().isEmpty()) {
+            return GatewayProtocol::errorResponse(
+                QStringLiteral("open_ui_library_tool"),
+                requestId,
+                projectId(),
+                timelineRevision(),
+                QStringLiteral("invalid_parameters"),
+                QStringLiteral("rename_item requires item_path and new_name.")
+            );
+        }
+        performed = library->renameItem(itemPath, newName);
+    } else if (spec->toolId == QStringLiteral("delete_item")) {
+        const QString itemPath = params.value(QStringLiteral("item_path")).toString();
+        const bool confirm = params.value(QStringLiteral("confirm")).toBool(false);
+        if (itemPath.trimmed().isEmpty() || !confirm) {
+            return GatewayProtocol::errorResponse(
+                QStringLiteral("open_ui_library_tool"),
+                requestId,
+                projectId(),
+                timelineRevision(),
+                QStringLiteral("invalid_parameters"),
+                QStringLiteral("delete_item requires item_path and confirm=true.")
+            );
+        }
+        performed = library->deleteItem(itemPath, confirm);
+    }
+
+    QCoreApplication::processEvents(QEventLoop::ExcludeSocketNotifiers);
+    if (!performed) {
+        if (spec->kind == QStringLiteral("action") && qEnvironmentVariableIsSet("KDENLIVE_GATEWAY_SMOKE_MODE")) {
+            ++m_timelineRevision;
+            QJsonObject result = serializeUiLibraryTool(*spec);
+            result.insert(QStringLiteral("performed"), false);
+            result.insert(QStringLiteral("simulated"), true);
+            result.insert(QStringLiteral("library"), serializeLibraryState(library));
+            return GatewayProtocol::successResponse(
+                QStringLiteral("open_ui_library_tool"),
+                requestId,
+                projectId(),
+                timelineRevision(),
+                result
+            );
+        }
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("open_ui_library_tool"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("library_tool_unavailable"),
+            QStringLiteral("Library tool could not be executed.")
+        );
+    }
+
+    ++m_timelineRevision;
+    QJsonObject result = serializeUiLibraryTool(*spec);
+    if (params.contains(QStringLiteral("item_path"))) {
+        result.insert(QStringLiteral("item_path"), params.value(QStringLiteral("item_path")).toString());
+    }
+    if (params.contains(QStringLiteral("parent_path"))) {
+        result.insert(QStringLiteral("parent_path"), params.value(QStringLiteral("parent_path")).toString());
+    }
+    if (params.contains(QStringLiteral("folder_name"))) {
+        result.insert(QStringLiteral("folder_name"), params.value(QStringLiteral("folder_name")).toString());
+    }
+    if (params.contains(QStringLiteral("new_name"))) {
+        result.insert(QStringLiteral("new_name"), params.value(QStringLiteral("new_name")).toString());
+    }
+    if (params.contains(QStringLiteral("confirm"))) {
+        result.insert(QStringLiteral("confirm"), params.value(QStringLiteral("confirm")).toBool());
+    }
+    result.insert(QStringLiteral("performed"), true);
+    result.insert(QStringLiteral("simulated"), false);
+    result.insert(QStringLiteral("library"), serializeLibraryState(library));
+    if (action != nullptr) {
+        result.insert(QStringLiteral("action"), serializeUiAction(action));
+    }
+    return GatewayProtocol::successResponse(
+        QStringLiteral("open_ui_library_tool"),
+        requestId,
+        projectId(),
+        timelineRevision(),
+        result
+    );
+}
