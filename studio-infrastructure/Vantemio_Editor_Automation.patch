+            result.insert(QStringLiteral("simulated"), true);
+            return GatewayProtocol::successResponse(
+                QStringLiteral("open_ui_monitor_tool"),
+                requestId,
+                projectId(),
+                timelineRevision(),
+                result
+            );
+        }
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("open_ui_monitor_tool"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("monitor_tool_unavailable"),
+            QStringLiteral("Monitor tool action was not found.")
+        );
+    }
+    if (!action->isEnabled()) {
+        if (qEnvironmentVariableIsSet("KDENLIVE_GATEWAY_SMOKE_MODE")) {
+            ++m_timelineRevision;
+            QJsonObject result = serializeUiMonitorTool(*spec, action);
+            result.insert(QStringLiteral("performed"), false);
+            result.insert(QStringLiteral("simulated"), true);
+            return GatewayProtocol::successResponse(
+                QStringLiteral("open_ui_monitor_tool"),
+                requestId,
+                projectId(),
+                timelineRevision(),
+                result
+            );
+        }
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("open_ui_monitor_tool"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("monitor_tool_disabled"),
+            QStringLiteral("Monitor tool action is currently disabled.")
+        );
+    }
+
+    const bool hasChecked = params.contains(QStringLiteral("checked"));
+    const bool checked = params.value(QStringLiteral("checked")).toBool();
+    if (action->isCheckable() && hasChecked) {
+        if (action->isChecked() != checked) {
+            action->trigger();
+        }
+    } else {
+        action->trigger();
+    }
+    QCoreApplication::processEvents(QEventLoop::ExcludeSocketNotifiers);
+
+    ++m_timelineRevision;
+    QJsonObject result = serializeUiMonitorTool(*spec, action);
+    result.insert(QStringLiteral("performed"), true);
+    result.insert(QStringLiteral("simulated"), false);
+    result.insert(QStringLiteral("action"), serializeUiAction(action));
+    return GatewayProtocol::successResponse(
+        QStringLiteral("open_ui_monitor_tool"),
+        requestId,
+        projectId(),
+        timelineRevision(),
+        result
+    );
+}
