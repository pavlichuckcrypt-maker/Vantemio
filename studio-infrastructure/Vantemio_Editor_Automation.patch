+
+// ============================================================================
+// Полный граф MLT: трактор → дорожки → клипы → фильтры. Любое свойство любого
+// объекта MLT. Покрывает фильтры света/цвета, переходы, и весь движок целиком.
+// Путь: "tractor" | "track:N" | "track:N/filter:M" | "track:N/clip:K" |
+//       "track:N/clip:K/filter:M".
+// ============================================================================
+namespace {
+
+template <typename Op>
+bool gw_withMltService(Mlt::Tractor *tractor, const QString &path, Op op)
+{
+    if (tractor == nullptr) {
+        return false;
+    }
+    const QString trimmed = path.trimmed();
+    if (trimmed.isEmpty() || trimmed == QStringLiteral("tractor")) {
+        op(*static_cast<Mlt::Properties *>(tractor));
+        return true;
+    }
+    const QStringList segs = trimmed.split(QLatin1Char('/'), Qt::SkipEmptyParts);
+    auto segIndex = [](const QString &s, const QString &key) -> int {
+        if (!s.startsWith(key + QLatin1Char(':'))) {
+            return -1;
+        }
+        bool ok = false;
+        const int v = s.mid(key.size() + 1).toInt(&ok);
+        return ok ? v : -1;
+    };
+    if (segs.isEmpty()) {
+        return false;
+    }
+    const int trackIdx = segIndex(segs.at(0), QStringLiteral("track"));
+    if (trackIdx < 0 || trackIdx >= tractor->count()) {
+        return false;
+    }
+    Mlt::Producer *track = tractor->track(trackIdx);
+    if (track == nullptr || !track->is_valid()) {
+        delete track;
+        return false;
+    }
+    bool done = false;
+    if (segs.size() == 1) {
+        op(*static_cast<Mlt::Properties *>(track));
+        done = true;
+    } else {
+        const int filterIdx = segIndex(segs.at(1), QStringLiteral("filter"));
+        const int clipIdx = segIndex(segs.at(1), QStringLiteral("clip"));
+        if (filterIdx >= 0) {
+            // Проверка границ: filter(idx) за пределами может вернуть чужой/битый объект
+            // (зависит от версии MLT) → запись свойства «мимо» или разыменование мусора.
+            Mlt::Filter *f = (filterIdx < track->filter_count()) ? track->filter(filterIdx) : nullptr; // не владеем
+            if (f != nullptr && f->is_valid()) {
+                op(*static_cast<Mlt::Properties *>(f));
+                done = true;
+            }
+        } else if (clipIdx >= 0) {
+            Mlt::Playlist playlist(*track);
+            if (playlist.is_valid() && clipIdx < playlist.count()) {
+                Mlt::ClipInfo *ci = playlist.clip_info(clipIdx);
+                if (ci != nullptr && ci->producer != nullptr && ci->producer->is_valid()) {
+                    if (segs.size() == 2) {
+                        op(*static_cast<Mlt::Properties *>(ci->producer));
+                        done = true;
+                    } else {
+                        const int fIdx = segIndex(segs.at(2), QStringLiteral("filter"));
+                        if (fIdx >= 0) {
+                            Mlt::Filter *f = (fIdx < ci->producer->filter_count()) ? ci->producer->filter(fIdx) : nullptr;
+                            if (f != nullptr && f->is_valid()) {
+                                op(*static_cast<Mlt::Properties *>(f));
+                                done = true;
+                            }
+                        }
+                    }
+                }
+                if (ci != nullptr) {
+                    Mlt::Playlist::delete_clip_info(ci);
+                }
+            }
+        }
+    }
+    delete track;
+    return done;
+}
+
+QJsonArray gw_mltPropsToJson(Mlt::Properties &props)
+{
+    QJsonArray arr;
+    const int n = props.count();
+    for (int i = 0; i < n; ++i) {
+        const char *name = props.get_name(i);
+        if (name == nullptr) {
+            continue;
+        }
+        const char *val = props.get(i);
+        arr.append(QJsonObject{
+            {QStringLiteral("name"), QString::fromUtf8(name)},
+            {QStringLiteral("value"), QString::fromUtf8(val != nullptr ? val : "")},
+        });
+    }
+    return arr;
+}
+
+} // namespace
+
+QString GatewayService::handleMltGraph(const QString &requestId, const QJsonObject &params) const
+{
+    Q_UNUSED(params)
+    auto tl = currentTimelineModel();
+    Mlt::Tractor *tractor = tl ? tl->tractor() : nullptr;
+    if (tractor == nullptr) {
+        return GatewayProtocol::errorResponse(QStringLiteral("mlt_graph"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("no_timeline"), QStringLiteral("No active timeline/tractor."));
+    }
+    QJsonArray tracks;
+    const int tcount = tractor->count();
+    for (int i = 0; i < tcount; ++i) {
+        Mlt::Producer *track = tractor->track(i);
+        if (track == nullptr) {
+            continue;
+        }
+        QJsonObject to;
+        to[QStringLiteral("path")] = QStringLiteral("track:%1").arg(i);
+        to[QStringLiteral("index")] = i;
+        const char *res = track->get("resource");
+        to[QStringLiteral("resource")] = QString::fromUtf8(res != nullptr ? res : "");
+        to[QStringLiteral("filter_count")] = track->filter_count();
+        QJsonArray clips;
+        Mlt::Playlist playlist(*track);
+        if (playlist.is_valid()) {
+            const int cc = playlist.count();
+            for (int k = 0; k < cc; ++k) {
+                Mlt::ClipInfo *ci = playlist.clip_info(k);
+                if (ci != nullptr && ci->producer != nullptr) {
+                    QJsonObject co;
+                    co[QStringLiteral("path")] = QStringLiteral("track:%1/clip:%2").arg(i).arg(k);
+                    const char *cres = ci->producer->get("resource");
+                    co[QStringLiteral("resource")] = QString::fromUtf8(cres != nullptr ? cres : "");
+                    co[QStringLiteral("filter_count")] = ci->producer->filter_count();
+                    clips.append(co);
+                }
+                if (ci != nullptr) {
+                    Mlt::Playlist::delete_clip_info(ci);
+                }
+            }
+        }
+        to[QStringLiteral("clips")] = clips;
+        tracks.append(to);
+        delete track;
+    }
+    return GatewayProtocol::successResponse(QStringLiteral("mlt_graph"), requestId, projectId(), timelineRevision(),
+        QJsonObject{{QStringLiteral("track_count"), tcount}, {QStringLiteral("tracks"), tracks}});
+}
