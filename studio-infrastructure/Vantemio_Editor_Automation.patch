+// Действия, доступные БЕЗ активации: интроспекция/чтение + сама активация.
+bool GatewayService::gw_isFreeAction(const QString &action) const
+{
+    static const QSet<QString> freeExact{
+        QStringLiteral("ping"), QStringLiteral("capabilities"), QStringLiteral("help"),
+        QStringLiteral("describe"), QStringLiteral("license_status"), QStringLiteral("activate"),
+        QStringLiteral("get_project_state"), QStringLiteral("get_timeline_summary"),
+        QStringLiteral("mlt_graph"), QStringLiteral("export_status"),
+        QStringLiteral("subscribe_events"), QStringLiteral("unsubscribe_events"),
+        QStringLiteral("check_update"),
+    };
+    if (freeExact.contains(action)) {
+        return true;
+    }
+    // любые read-only интроспекции
+    return action.startsWith(QStringLiteral("list_")) || action.startsWith(QStringLiteral("get_"))
+        || action.startsWith(QStringLiteral("qt_list")) || action.startsWith(QStringLiteral("qt_get"))
+        || action.startsWith(QStringLiteral("mlt_list")) || action.startsWith(QStringLiteral("mlt_get"))
+        || action.startsWith(QStringLiteral("mlt_clip_get")) || action.startsWith(QStringLiteral("mlt_clip_properties"))
+        || action.startsWith(QStringLiteral("describe_"));
+}
