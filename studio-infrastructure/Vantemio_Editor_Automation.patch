+// ============================================================================
+// ФИРМЕННЫЕ AI-КОМАНДЫ VidRA (нет в обычном Kdenlive).
+// ============================================================================
+
+// Общий хелпер: добавить эффект на клип и проставить параметры. Возвращает row или -1.
+int GatewayService::gw_addEffectWithParams(int clipId, const QString &effectName, const QList<QPair<QString, QString>> &kv)
+{
+    auto tl = currentTimelineModel();
+    auto controller = currentController();
+    if (!tl || controller == nullptr || !tl->isClip(clipId) || !EffectsRepository::get()->exists(effectName)) {
+        return -1;
+    }
+    controller->addEffectToClip(effectName, clipId);
+    std::shared_ptr<EffectStackModel> stack = tl->getClipEffectStackModel(clipId);
+    if (!stack || stack->rowCount() == 0) {
+        return -1;
+    }
+    const int row = stack->rowCount() - 1;
+    std::shared_ptr<EffectItemModel> eff = gw_safeEffectRow(stack, row);
+    if (!eff) {
+        return -1;
+    }
+    for (const auto &p : kv) {
+        eff->setParameter(p.first, p.second, true);
+    }
+    ++m_timelineRevision;
+    return row;
+}
