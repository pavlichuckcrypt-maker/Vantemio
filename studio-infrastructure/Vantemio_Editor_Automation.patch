+            QStringLiteral("clip_not_found"), QStringLiteral("Нет клипа с таким clip_id."));
+    QString col = params.value(QStringLiteral("color")).toString(QStringLiteral("green")).toLower();
+    if (col == QStringLiteral("green")) col = QStringLiteral("#00ff00");
+    else if (col == QStringLiteral("blue")) col = QStringLiteral("#0000ff");
+    else if (col == QStringLiteral("red")) col = QStringLiteral("#ff0000");
+    const double var = params.contains(QStringLiteral("variance")) ? params.value(QStringLiteral("variance")).toDouble() : 0.15;
+    const int row = gw_addEffectWithParams(clipId, QStringLiteral("chroma"),
+        {{QStringLiteral("key"), col}, {QStringLiteral("variance"), QString::number(var)}});
+    if (row < 0)
+        return GatewayProtocol::errorResponse(QStringLiteral("chroma_key"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("chroma_failed"), QStringLiteral("Не удалось применить хромакей."));
+    return GatewayProtocol::successResponse(QStringLiteral("chroma_key"), requestId, projectId(), timelineRevision(),
+        QJsonObject{{QStringLiteral("clip_id"), clipId}, {QStringLiteral("effect_row"), row}, {QStringLiteral("color"), col}});
+}
