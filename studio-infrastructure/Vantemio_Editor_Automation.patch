+QString GatewayService::handleRenderMaster(const QString &requestId, const QString &outputPath, const QString &preset, bool asyncMode, const QJsonObject &extra)
+{
+    // Дать таймлайну «устаканиться» после пачки правок — иначе редкий случай
+    // неполного/почти пустого рендера (продюсеры/MLT-граф ещё не финализированы).
+    {
+        QElapsedTimer settle; settle.start();
+        while (settle.elapsed() < 300) QCoreApplication::processEvents(QEventLoop::ExcludeSocketNotifiers,60);
+    }
+    // Гард от ПАРАЛЛЕЛЬНОГО рендера: один render-процесс за раз (иначе старый осиротеет).
+    if (m_renderProc != nullptr && m_renderProc->state() != QProcess::NotRunning) {
+        if (extra.value(QStringLiteral("force")).toBool(false)) {
+            m_renderProc->kill();
+            m_renderProc->waitForFinished(3000);
+        } else {
+            return GatewayProtocol::errorResponse(QStringLiteral("render_master"), requestId, projectId(), timelineRevision(),
+                QStringLiteral("render_in_progress"),
+                QStringLiteral("Рендер уже идёт. Дождись render.finished или передай force:true чтобы прервать текущий."));
+        }
+    }
+    // === ПОСЕГМЕНТНЫЙ РЕНДЕР для длинных таймлайнов ===
+    // Один проход MLT по длинному тяжёлому таймлайну копит память фильтров и
+    // детерминированно падает (~98с). Рендерим по чанкам (свежий процесс melt на
+    // каждый кусок = чистая память) и склеиваем ffmpeg-ом. Полностью автономно.
+    if (!outputPath.trimmed().isEmpty() && m_core != nullptr && m_core->currentDoc() != nullptr) {
+        int totalFrames = 0;
+        if (auto tl = currentTimelineModel()) {
+            QList<int> tks = tl->getTracksIds(false);
+            tks.append(tl->getTracksIds(true));
+            for (int t : tks) {
+                for (int cid : tl->getItemsInRange(t, 0, -1, false)) {
+                    if (tl->isClip(cid))
+                        totalFrames = qMax(totalFrames, tl->getClipPosition(cid) + tl->getClipPlaytime(cid));
+                }
+            }
+        }
+        const int chunkFrames = extra.value(QStringLiteral("chunk_frames")).toInt(450);
+        const bool wantChunked = extra.contains(QStringLiteral("chunked"))
+            ? extra.value(QStringLiteral("chunked")).toBool()
+            : (totalFrames > 1500); // авто: >50с при 30fps
+        if (wantChunked && totalFrames > chunkFrames) {
+            return gw_renderSegmented(requestId, outputPath, totalFrames, chunkFrames, extra);
+        }
+    }
+    if (outputPath.trimmed().isEmpty()) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("render_master"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("missing_output_path"),
+            QStringLiteral("render_master requires output_path.")
+        );
+    }
+    if (m_core == nullptr || m_core->currentDoc() == nullptr) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("render_master"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("project_unavailable"),
+            QStringLiteral("No active project is loaded.")
+        );
+    }
+
+    RenderRequest renderRequest;
+    renderRequest.setOutputFile(outputPath);
+    QString effectivePreset = preset.isEmpty() ? QStringLiteral("H.264 (libx264+aac)") : preset.trimmed();
+    // АЛИАСЫ исторических имён пресета → реальное имя headless-билда. Все существующие планы/
+    // рецепты/доки мозга используют "MP4-H264/AAC", которого в этом билде НЕТ — без алиаса они
+    // теперь падали бы на preset_not_found. Сохраняем совместимость, без молчаливого GIF.
+    if (effectivePreset == QStringLiteral("MP4-H264/AAC") || effectivePreset == QStringLiteral("H.264/AAC")
+        || effectivePreset.compare(QStringLiteral("mp4"), Qt::CaseInsensitive) == 0
+        || effectivePreset.compare(QStringLiteral("h264"), Qt::CaseInsensitive) == 0) {
+        effectivePreset = QStringLiteral("H.264 (libx264+aac)");
+    }
+    // ВАЛИДАЦИЯ пресета: несуществующее имя раньше МОЛЧА давало GIF без звука
+    // (RenderRequest тихо фолбэчил). Теперь — явная ошибка со списком доступных.
+    const QVector<QString> availablePresets = RenderPresetRepository::get()->getAllPresets();
+    if (!availablePresets.contains(effectivePreset)) {
+        QJsonArray pj;
+        for (const QString &pp : availablePresets) pj.append(pp);
+        m_lastRenderStatus = QStringLiteral("failed");
+        m_lastRenderError = QStringLiteral("preset_not_found: ") + effectivePreset;
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("render_master"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("preset_not_found"),
+            QStringLiteral("Пресет рендера не найден: '%1'. Доступные — в list_render_presets.").arg(effectivePreset));
+    }
+    renderRequest.loadPresetParams(effectivePreset);
+    // Переопределение качества/масштаба (для черновиков и правила 480p). Удобные ключи +
+    // сырой render_params (полный контроль MLT-свойств). Пусто — берётся из пресета как есть.
+    {
+        QStringList ov;
+        if (extra.contains(QStringLiteral("crf")))     ov << QStringLiteral("crf=%1").arg(extra.value(QStringLiteral("crf")).toInt());
+        if (extra.contains(QStringLiteral("bitrate"))) ov << QStringLiteral("vb=%1").arg(extra.value(QStringLiteral("bitrate")).toString());
+        if (extra.contains(QStringLiteral("width")))   ov << QStringLiteral("width=%1").arg(extra.value(QStringLiteral("width")).toInt());
+        if (extra.contains(QStringLiteral("height")))  ov << QStringLiteral("height=%1").arg(extra.value(QStringLiteral("height")).toInt());
+        const QString raw = extra.value(QStringLiteral("render_params")).toString();
+        if (!raw.trimmed().isEmpty()) ov << raw.trimmed();
+        if (!ov.isEmpty()) renderRequest.overridePresetParams(ov.join(QLatin1Char(' ')));
+    }
+
+    const std::vector<RenderRequest::RenderJob> jobs = renderRequest.process();
+    if (!renderRequest.errorMessages().isEmpty() || jobs.empty()) {
+        m_lastRenderStatus = QStringLiteral("failed");
+        m_lastRenderOutput = outputPath;
+        m_lastRenderPreset = preset;
+        m_lastRenderError = renderRequest.errorMessages().join(QLatin1String("; "));
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("render_master"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("render_prepare_failed"),
+            m_lastRenderError.isEmpty() ? QStringLiteral("Render request preparation failed.") : m_lastRenderError
+        );
+    }
+
+    bool ok = true;
+    const QString rendererPath = KdenliveSettings::kdenliverendererpath();
+    // Лениво подключаемся к RenderServer Kdenlive — поток прогресса рендера в %.
+    if (!m_renderSignalsConnected && m_core != nullptr && m_core->window() != nullptr) {
+        RenderServer *rs = m_core->window()->findChild<RenderServer *>();
+        if (rs != nullptr) {
+            connect(rs, &RenderServer::setRenderingProgress, this, [this](const QString &url, int progress, int frame) {
+                pushEvent(QJsonObject{
+                    {QStringLiteral("kind"), QStringLiteral("event")},
+                    {QStringLiteral("event"), QStringLiteral("render.progress")},
+                    {QStringLiteral("output"), url},
+                    {QStringLiteral("percent"), progress},
+                    {QStringLiteral("frame"), frame},
+                });
+            });
+            m_renderSignalsConnected = true;
+        }
+    }
+    if (asyncMode) {
+        // Отслеживаемый процесс рендера: push render.started/finished подписчикам.
+        if (m_renderProc != nullptr) {
+            m_renderProc->deleteLater();
+            m_renderProc = nullptr;
+        }
+        m_renderProc = new QProcess(this);
+        const QString outForEvent = outputPath;
+        connect(m_renderProc, &QProcess::finished, this, [this, outForEvent](int code, QProcess::ExitStatus) {
+            m_lastRenderStatus = (code == 0) ? QStringLiteral("done") : QStringLiteral("failed");
+            pushEvent(QJsonObject{
+                {QStringLiteral("kind"), QStringLiteral("event")},
+                {QStringLiteral("event"), QStringLiteral("render.finished")},
+                {QStringLiteral("output"), outForEvent},
+                {QStringLiteral("exit_code"), code},
+                {QStringLiteral("status"), m_lastRenderStatus},
+            });
+        });
+        m_renderProc->start(rendererPath, RenderRequest::argsByJob(jobs.front(), false));
+        ok = m_renderProc->waitForStarted(5000);
+        if (ok) {
+            pushEvent(QJsonObject{
+                {QStringLiteral("kind"), QStringLiteral("event")},
+                {QStringLiteral("event"), QStringLiteral("render.started")},
+                {QStringLiteral("output"), outputPath},
+            });
+        }
+    } else {
+        for (const auto &job : jobs) {
+            ok = ok && QProcess::execute(rendererPath, RenderRequest::argsByJob(job, true)) == EXIT_SUCCESS;
+            if (!ok) {
+                break;
+            }
+        }
+    }
+
+    m_lastRenderStatus = ok ? (asyncMode ? QStringLiteral("started_async") : QStringLiteral("completed")) : QStringLiteral("failed");
+    m_lastRenderOutput = outputPath;
+    m_lastRenderPreset = preset.isEmpty() ? QStringLiteral("H.264 (libx264+aac)") : preset;
+    m_lastRenderError = ok ? QString() : QStringLiteral("Renderer process failed to start or exited with error.");
+
+    if (!ok) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("render_master"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("render_execution_failed"),
+            m_lastRenderError
+        );
+    }
+
+    return GatewayProtocol::successResponse(
+        QStringLiteral("render_master"),
+        requestId,
+        projectId(),
+        timelineRevision(),
+        QJsonObject{
+            {QStringLiteral("output_path"), outputPath},
+            {QStringLiteral("preset"), m_lastRenderPreset},
+            {QStringLiteral("async"), asyncMode},
+            {QStringLiteral("jobs"), int(jobs.size())},
+            {QStringLiteral("status"), m_lastRenderStatus}
+        }
+    );
+}
