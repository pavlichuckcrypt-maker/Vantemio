+QString GatewayService::handleRemoveTrack(const QString &requestId, const QJsonObject &params)
+{
+    auto tl = currentTimelineModel();
+    if (!tl) {
+        return GatewayProtocol::errorResponse(QStringLiteral("remove_track"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("timeline_unavailable"), QStringLiteral("Active timeline is not available."));
+    }
+    const int trackId = params.value(QStringLiteral("track_id")).toInt(-1);
+    if (!tl->isTrack(trackId)) {
+        return GatewayProtocol::errorResponse(QStringLiteral("remove_track"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("track_not_found"), QStringLiteral("Нет трека с таким track_id."));
+    }
+    const bool ok = tl->requestTrackDeletion(trackId);
+    if (!ok) {
+        return GatewayProtocol::errorResponse(QStringLiteral("remove_track"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("remove_track_failed"), QStringLiteral("Не удалось удалить трек."));
+    }
+    ++m_timelineRevision;
+    return GatewayProtocol::successResponse(QStringLiteral("remove_track"), requestId, projectId(), timelineRevision(),
+        QJsonObject{{QStringLiteral("track_id"), trackId}, {QStringLiteral("removed"), true}});
+}
