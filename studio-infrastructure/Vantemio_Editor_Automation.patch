+QString GatewayService::handleMltClipProperties(const QString &requestId, const QJsonObject &params) const
+{
+    const QString clipId = params.value(QStringLiteral("clip_id")).isString()
+        ? params.value(QStringLiteral("clip_id")).toString()
+        : QString::number(params.value(QStringLiteral("clip_id")).toInt());
+    if (m_core == nullptr || m_core->projectItemModel() == nullptr) {
+        return GatewayProtocol::errorResponse(QStringLiteral("mlt_clip_properties"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("no_project"), QStringLiteral("No project is open."));
+    }
+    std::shared_ptr<ProjectClip> clip = m_core->projectItemModel()->getClipByBinID(clipId);
+    if (!clip) {
+        // clip_id мог быть timeline clip_id (число) — резолвим его в bin-id.
+        auto tl = currentTimelineModel();
+        const QJsonValue cv = params.value(QStringLiteral("clip_id"));
+        const int tlId = cv.isString() ? cv.toString().toInt() : cv.toInt();
+        if (tl && tl->isClip(tlId)) {
+            clip = m_core->projectItemModel()->getClipByBinID(tl->getClipBinId(tlId));
+        }
+    }
+    if (!clip) {
+        return GatewayProtocol::errorResponse(QStringLiteral("mlt_clip_properties"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("clip_not_found"), QStringLiteral("Не найден клип по clip_id (ни bin-id, ни timeline clip_id)."));
+    }
+    std::shared_ptr<Mlt::Producer> prod = clip->originalProducer();
+    if (!prod || !prod->is_valid()) {
+        return GatewayProtocol::errorResponse(QStringLiteral("mlt_clip_properties"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("no_producer"), QStringLiteral("Clip has no valid MLT producer."));
+    }
+    QJsonArray arr;
+    const int n = prod->count();
+    for (int i = 0; i < n; ++i) {
+        const char *name = prod->get_name(i);
+        if (name == nullptr) {
+            continue;
+        }
+        arr.append(QJsonObject{
+            {QStringLiteral("name"), QString::fromUtf8(name)},
+            {QStringLiteral("value"), QString::fromUtf8(prod->get(i) ? prod->get(i) : "")},
+        });
+    }
+    return GatewayProtocol::successResponse(QStringLiteral("mlt_clip_properties"), requestId, projectId(), timelineRevision(),
+        QJsonObject{{QStringLiteral("clip_id"), clipId}, {QStringLiteral("count"), arr.size()}, {QStringLiteral("properties"), arr}});
+}
