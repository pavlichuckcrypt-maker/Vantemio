+namespace {
+// Числовой анализ кадра (как describe_frame), переиспользуемо.
+QJsonObject gw_analyzeImage(const QString &path)
+{
+    QImage img(path);
+    if (img.isNull()) {
+        return QJsonObject{{QStringLiteral("path"), path}, {QStringLiteral("ok"), false}};
+    }
+    const QImage small = img.scaled(160, 90, Qt::KeepAspectRatio, Qt::FastTransformation).convertToFormat(QImage::Format_RGB32);
+    double sumL = 0, sumR = 0, sumG = 0, sumB = 0, sumL2 = 0;
+    qint64 n = 0, black = 0, bright = 0;
+    for (int y = 0; y < small.height(); ++y) {
+        for (int x = 0; x < small.width(); ++x) {
+            const QRgb p = small.pixel(x, y);
+            const double r = qRed(p), g = qGreen(p), b = qBlue(p);
+            const double lum = (0.299 * r + 0.587 * g + 0.114 * b) / 255.0;
+            sumL += lum; sumL2 += lum * lum; sumR += r; sumG += g; sumB += b;
+            if (lum < 0.06) ++black;
+            if (lum > 0.94) ++bright;
+            ++n;
+        }
+    }
+    if (n == 0) n = 1;
+    const double meanL = sumL / n;
+    const double variance = qMax(0.0, sumL2 / n - meanL * meanL);
+    QString verdict = QStringLiteral("ok");
+    if (meanL < 0.18) verdict = QStringLiteral("too_dark");
+    else if (meanL > 0.85) verdict = QStringLiteral("too_bright");
+    else if (double(black) / n > 0.9) verdict = QStringLiteral("mostly_black");
+    return QJsonObject{
+        {QStringLiteral("path"), path}, {QStringLiteral("ok"), true},
+        {QStringLiteral("brightness"), meanL}, {QStringLiteral("contrast"), qSqrt(variance)},
+        {QStringLiteral("avg_rgb"), QJsonArray{int(qRound(sumR / n)), int(qRound(sumG / n)), int(qRound(sumB / n))}},
+        {QStringLiteral("black_ratio"), double(black) / n}, {QStringLiteral("bright_ratio"), double(bright) / n},
+        {QStringLiteral("verdict"), verdict},
+    };
+}
+
+// Средняя абсолютная разница яркости пикселей между двумя кадрами (0..1).
+// ~0 = картинка не меняется (застыло); больше = есть движение. Для датчика движения.
+double gw_frameDiff(const QString &a, const QString &b)
+{
+    QImage ia(a), ib(b);
+    if (ia.isNull() || ib.isNull()) return -1.0;
+    const QImage sa = ia.scaled(160, 90, Qt::IgnoreAspectRatio, Qt::FastTransformation).convertToFormat(QImage::Format_RGB32);
+    const QImage sb = ib.scaled(160, 90, Qt::IgnoreAspectRatio, Qt::FastTransformation).convertToFormat(QImage::Format_RGB32);
+    double sum = 0; qint64 n = 0;
+    for (int y = 0; y < sa.height(); ++y) {
+        for (int x = 0; x < sa.width(); ++x) {
+            const QRgb pa = sa.pixel(x, y), pb = sb.pixel(x, y);
+            const double la = 0.299 * qRed(pa) + 0.587 * qGreen(pa) + 0.114 * qBlue(pa);
+            const double lb = 0.299 * qRed(pb) + 0.587 * qGreen(pb) + 0.114 * qBlue(pb);
+            sum += qAbs(la - lb); ++n;
+        }
+    }
+    return n ? (sum / n) / 255.0 : 0.0;
+}
+} // namespace
