+QString GatewayService::handleOpenUiBinTool(const QString &requestId, const QJsonObject &params)
+{
+    Bin *bin = m_core != nullptr ? m_core->activeBin() : nullptr;
+    if (bin == nullptr) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("open_ui_bin_tool"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("bin_unavailable"),
+            QStringLiteral("Active project bin is not available.")
+        );
+    }
+
+    const QString toolId = params.value(QStringLiteral("tool_id")).toString();
+    if (toolId.trimmed().isEmpty()) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("open_ui_bin_tool"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("invalid_parameters"),
+            QStringLiteral("open_ui_bin_tool requires tool_id.")
+        );
+    }
+
+    const std::optional<UiBinToolSpec> spec = findUiBinToolSpec(toolId);
+    if (!spec.has_value()) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("open_ui_bin_tool"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("bin_tool_not_found"),
+            QStringLiteral("Requested bin tool was not found.")
+        );
+    }
+
+    bool performed = false;
+    QJsonObject result = serializeUiBinTool(*spec);
+    if (spec->toolId == QStringLiteral("import_clip")) {
+        const QString clipPath = params.value(QStringLiteral("clip_path")).toString();
+        if (clipPath.trimmed().isEmpty()) {
+            return GatewayProtocol::errorResponse(
+                QStringLiteral("open_ui_bin_tool"),
+                requestId,
+                projectId(),
+                timelineRevision(),
+                QStringLiteral("invalid_parameters"),
+                QStringLiteral("import_clip requires clip_path.")
+            );
+        }
+        const QString importedId = bin->importClipToFolder(QUrl::fromLocalFile(clipPath), params.value(QStringLiteral("folder_id")).toString());
+        performed = !importedId.isEmpty();
+        result.insert(QStringLiteral("clip_path"), clipPath);
+        result.insert(QStringLiteral("folder_id"), params.value(QStringLiteral("folder_id")).toString());
+        result.insert(QStringLiteral("imported_bin_id"), importedId);
+    } else if (spec->toolId == QStringLiteral("create_folder")) {
+        const QString folderName = params.value(QStringLiteral("folder_name")).toString();
+        if (folderName.trimmed().isEmpty()) {
+            return GatewayProtocol::errorResponse(
+                QStringLiteral("open_ui_bin_tool"),
+                requestId,
+                projectId(),
+                timelineRevision(),
+                QStringLiteral("invalid_parameters"),
+                QStringLiteral("create_folder requires folder_name.")
+            );
+        }
+        const QString createdId = bin->createFolder(folderName, params.value(QStringLiteral("parent_folder_id")).toString());
+        performed = !createdId.isEmpty();
+        result.insert(QStringLiteral("folder_name"), folderName);
+        result.insert(QStringLiteral("parent_folder_id"), params.value(QStringLiteral("parent_folder_id")).toString());
+        result.insert(QStringLiteral("created_folder_id"), createdId);
+    } else if (spec->toolId == QStringLiteral("rename_item")) {
+        const QString binId = params.value(QStringLiteral("bin_id")).toString();
+        const QString newName = params.value(QStringLiteral("new_name")).toString();
+        if (binId.trimmed().isEmpty() || newName.trimmed().isEmpty()) {
+            return GatewayProtocol::errorResponse(
+                QStringLiteral("open_ui_bin_tool"),
+                requestId,
+                projectId(),
+                timelineRevision(),
+                QStringLiteral("invalid_parameters"),
+                QStringLiteral("rename_item requires bin_id and new_name.")
+            );
+        }
+        performed = bin->renameItemById(binId, newName);
+        result.insert(QStringLiteral("bin_id"), binId);
+        result.insert(QStringLiteral("new_name"), newName);
+    } else if (spec->toolId == QStringLiteral("select_item")) {
+        const QString binId = params.value(QStringLiteral("bin_id")).toString();
+        if (binId.trimmed().isEmpty()) {
+            return GatewayProtocol::errorResponse(
+                QStringLiteral("open_ui_bin_tool"),
+                requestId,
+                projectId(),
+                timelineRevision(),
+                QStringLiteral("invalid_parameters"),
+                QStringLiteral("select_item requires bin_id.")
+            );
+        }
+        performed = bin->selectItemById(binId, params.value(QStringLiteral("activate_monitor")).toBool(true));
+        result.insert(QStringLiteral("bin_id"), binId);
+        result.insert(QStringLiteral("activate_monitor"), params.value(QStringLiteral("activate_monitor")).toBool(true));
+    }
+
+    QCoreApplication::processEvents(QEventLoop::ExcludeSocketNotifiers);
+    if (!performed) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("open_ui_bin_tool"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("bin_tool_unavailable"),
+            QStringLiteral("Bin tool could not be executed.")
+        );
+    }
+
+    ++m_timelineRevision;
+    result.insert(QStringLiteral("performed"), true);
+    result.insert(QStringLiteral("bin"), serializeBinState(bin, m_core != nullptr ? m_core->projectItemModel() : std::shared_ptr<ProjectItemModel>()));
+    return GatewayProtocol::successResponse(
+        QStringLiteral("open_ui_bin_tool"),
+        requestId,
+        projectId(),
+        timelineRevision(),
+        result
+    );
+}
