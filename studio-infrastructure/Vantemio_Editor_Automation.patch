+        return GatewayProtocol::errorResponse(QStringLiteral("add_transition_at"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("transition_not_found"), QStringLiteral("Нет перехода с таким transition_name (см. list_all_transitions)."));
