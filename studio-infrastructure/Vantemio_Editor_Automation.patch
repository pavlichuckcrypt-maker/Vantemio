+// get_full_state — ВСЁ за один вызов: профиль, треки, клипы с эффектами/зонами/
+// параметрами, рендер-статус. Единый источник правды для мозга (меньше round-trip).
+QString GatewayService::handleGetFullState(const QString &requestId) const
+{
+    auto tl = currentTimelineModel();
+    const double fps = m_core ? m_core->getCurrentFps() : 25.0;
+    QJsonObject result{
+        {QStringLiteral("project_id"), projectId()},
+        {QStringLiteral("timeline_revision"), timelineRevision()},
+        {QStringLiteral("fps"), fps},
+        {QStringLiteral("render_status"), m_lastRenderStatus},
+        {QStringLiteral("render_output"), m_lastRenderOutput},
+    };
+    if (m_core && m_core->getCurrentProfile()) {
+        result.insert(QStringLiteral("width"), m_core->getCurrentProfile()->width());
+        result.insert(QStringLiteral("height"), m_core->getCurrentProfile()->height());
+    }
+    if (m_core && m_core->currentDoc()) {
+        result.insert(QStringLiteral("project_path"), m_core->currentDoc()->url().toLocalFile());
+    }
+    QJsonArray tracksArr;
+    int totalClips = 0, projectEnd = 0;
+    if (tl) {
+        QList<int> all = tl->getTracksIds(false);
+        all.append(tl->getTracksIds(true));
+        for (int trackId : all) {
+            QJsonArray clipsArr;
+            std::unordered_set<int> items = tl->getItemsInRange(trackId, 0, -1, false);
+            QList<int> sorted(items.begin(), items.end());
+            std::sort(sorted.begin(), sorted.end(), [tl](int a, int b){ return tl->getClipPosition(a) < tl->getClipPosition(b); });
+            for (int clipId : sorted) {
+                if (!tl->isClip(clipId)) continue;
+                const int pos = tl->getClipPosition(clipId);
+                const int dur = tl->getClipPlaytime(clipId);
+                projectEnd = qMax(projectEnd, pos + dur);
+                ++totalClips;
+                QJsonArray effArr;
+                std::shared_ptr<EffectStackModel> stack = tl->getClipEffectStackModel(clipId);
+                if (stack) {
+                    for (int r = 0; r < stack->rowCount(); ++r) {
+                        std::shared_ptr<EffectItemModel> eff = std::dynamic_pointer_cast<EffectItemModel>(stack->getEffectStackRow(r));
+                        if (!eff) continue;
+                        const QPair<int, int> io = eff->getInOut();
+                        effArr.append(QJsonObject{
+                            {QStringLiteral("row"), r}, {QStringLiteral("effect_id"), eff->getAssetId()},
+                            {QStringLiteral("enabled"), eff->isAssetEnabled()}, {QStringLiteral("zoned"), eff->hasForcedInOut()},
+                            {QStringLiteral("in"), io.first}, {QStringLiteral("out"), io.second}});
+                    }
+                }
+                clipsArr.append(QJsonObject{
+                    {QStringLiteral("clip_id"), clipId}, {QStringLiteral("bin_id"), tl->getClipBinId(clipId)},
+                    {QStringLiteral("position"), pos}, {QStringLiteral("duration"), dur}, {QStringLiteral("end"), pos + dur},
+                    {QStringLiteral("position_sec"), pos / fps}, {QStringLiteral("duration_sec"), dur / fps},
+                    {QStringLiteral("effects"), effArr}});
+            }
+            tracksArr.append(QJsonObject{
+                {QStringLiteral("track_id"), trackId}, {QStringLiteral("kind"), tl->isAudioTrack(trackId) ? QStringLiteral("audio") : QStringLiteral("video")},
+                {QStringLiteral("tag"), tl->getTrackTagById(trackId)}, {QStringLiteral("locked"), tl->trackIsLocked(trackId)},
+                {QStringLiteral("clips_count"), clipsArr.size()}, {QStringLiteral("clips"), clipsArr}});
+        }
+    }
+    result.insert(QStringLiteral("tracks_count"), tracksArr.size());
+    result.insert(QStringLiteral("clips_count"), totalClips);
+    result.insert(QStringLiteral("project_end_frames"), projectEnd);
+    result.insert(QStringLiteral("project_end_sec"), projectEnd / fps);
+    result.insert(QStringLiteral("tracks"), tracksArr);
+    result.insert(QStringLiteral("clip_tags"), m_clipTags);
+    return GatewayProtocol::successResponse(QStringLiteral("get_full_state"), requestId, projectId(), timelineRevision(), result);
+}
+
+// get_frames — N кадров за раз: по позициям/секундам, каждый с числовым анализом.
+// Зрячий мозг «видит» весь монтаж дёшево. Файлы PNG читаются по path (через SMB).
+QString GatewayService::handleGetFrames(const QString &requestId, const QJsonObject &params)
+{
+    if (m_core == nullptr || m_core->monitorManager() == nullptr || m_core->monitorManager()->projectMonitor() == nullptr) {
+        return GatewayProtocol::errorResponse(QStringLiteral("get_frames"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("no_monitor"), QStringLiteral("Project monitor unavailable."));
+    }
+    double fps = m_core->getCurrentFps();
+    if (fps <= 0.0) fps = 25.0;   // защита от деления на 0 → seconds=inf → битый JSON
+    QList<int> frames;
+    for (const QJsonValue &v : params.value(QStringLiteral("positions")).toArray()) {
+        frames.append(v.toInt());
+    }
+    for (const QJsonValue &v : params.value(QStringLiteral("seconds")).toArray()) {
+        frames.append(int(qRound(v.toDouble() * fps)));
+    }
+    if (frames.isEmpty()) {
+        return GatewayProtocol::errorResponse(QStringLiteral("get_frames"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("no_positions"), QStringLiteral("get_frames требует positions:[кадры] или seconds:[сек]."));
+    }
+    const QString dir = params.value(QStringLiteral("dir")).toString().isEmpty()
+        ? QDir::tempPath() : params.value(QStringLiteral("dir")).toString();
+    Monitor *mon = m_core->monitorManager()->projectMonitor();
+    QJsonArray out;
+    for (int i = 0; i < frames.size(); ++i) {
+        const int f = frames.at(i);
+        const QString path = QStringLiteral("%1/vidra_f%2_%3.png").arg(dir).arg(f).arg(timelineRevision());
+        QFile::remove(path);
+        mon->requestSeek(f);
+        // дать монитору ОТРИСОВАТЬ новую позицию перед захватом (иначе чёрный/старый кадр).
+        QElapsedTimer settle; settle.start();
+        while (settle.elapsed() < 500) {
+            QCoreApplication::processEvents(QEventLoop::ExcludeSocketNotifiers,60);
+        }
+        mon->extractFrame(path);
+        QElapsedTimer t; t.start();
+        while (!QFileInfo::exists(path) && t.elapsed() < 3000) {
+            QCoreApplication::processEvents(QEventLoop::ExcludeSocketNotifiers,50);
+        }
+        // дочитать файл (extractFrame пишет асинхронно) + повтор, если кадр пустой/чёрный
+        QCoreApplication::processEvents(QEventLoop::ExcludeSocketNotifiers,150);
+        QJsonObject fr = gw_analyzeImage(path);
+        if (fr.value(QStringLiteral("ok")).toBool() && fr.value(QStringLiteral("brightness")).toDouble() < 0.001) {
+            QElapsedTimer s2; s2.start();
+            while (s2.elapsed() < 400) QCoreApplication::processEvents(QEventLoop::ExcludeSocketNotifiers,60);
+            mon->extractFrame(path);
+            s2.restart();
+            while (s2.elapsed() < 400) QCoreApplication::processEvents(QEventLoop::ExcludeSocketNotifiers,60);
+            fr = gw_analyzeImage(path);
+        }
+        fr.insert(QStringLiteral("frame"), f);
+        fr.insert(QStringLiteral("seconds"), f / fps);
+        out.append(fr);
+    }
+    return GatewayProtocol::successResponse(QStringLiteral("get_frames"), requestId, projectId(), timelineRevision(),
+        QJsonObject{{QStringLiteral("count"), out.size()}, {QStringLiteral("frames"), out}});
+}
+
+// find_clip_by_tag — стабильная адресация: вернуть клипы с данной меткой.
+QString GatewayService::handleFindClipByTag(const QString &requestId, const QJsonObject &params) const
+{
+    const QString tag = params.value(QStringLiteral("tag")).toString();
+    if (tag.isEmpty()) {
+        return GatewayProtocol::errorResponse(QStringLiteral("find_clip_by_tag"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("missing_tag"), QStringLiteral("find_clip_by_tag требует params.tag."));
+    }
+    QJsonArray matches;
+    for (auto it = m_clipTags.constBegin(); it != m_clipTags.constEnd(); ++it) {
+        if (it.value().toObject().value(QStringLiteral("tag")).toString() == tag) {
+            matches.append(QJsonObject{{QStringLiteral("clip_id"), it.key()},
+                                       {QStringLiteral("meta"), it.value().toObject().value(QStringLiteral("meta"))}});
+        }
+    }
+    return GatewayProtocol::successResponse(QStringLiteral("find_clip_by_tag"), requestId, projectId(), timelineRevision(),
+        QJsonObject{{QStringLiteral("tag"), tag}, {QStringLiteral("count"), matches.size()}, {QStringLiteral("clips"), matches}});
+}
