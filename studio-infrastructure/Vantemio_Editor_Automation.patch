+// ============================================================================
+// ГРУППА B — ЗНАНИЕ О МЕДИА (probe/list_bin/import/generate). Мозг не «вслепую».
+// ============================================================================
+
+// probe_media — свойства файла через ffprobe (до вставки): длительность/разрешение/fps/звук.
+QString GatewayService::handleProbeMedia(const QString &requestId, const QJsonObject &params)
+{
+    const QString path = params.value(QStringLiteral("path")).toString();
+    if (path.isEmpty() || !QFileInfo::exists(path)) {
+        return GatewayProtocol::errorResponse(QStringLiteral("probe_media"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("file_not_found"), QStringLiteral("probe_media требует существующий path."));
+    }
+    const QString binDir = QFileInfo(KdenliveSettings::ffmpegpath()).absolutePath();
+    QString ffprobe = binDir + QStringLiteral("/ffprobe");
+    if (!QFileInfo::exists(ffprobe)) ffprobe = QStringLiteral("ffprobe");
+    QProcess p;
+    // Бинари CraftRoot грузят либы через DYLD — дочерний процесс его НЕ наследует
+    // от приложения (rpath). Задаём явно, иначе ffprobe не запустится/зависнет.
+    QProcessEnvironment env = QProcessEnvironment::systemEnvironment();
+    const QString craft = binDir + QStringLiteral("/..");
+    env.insert(QStringLiteral("DYLD_LIBRARY_PATH"), craft + QStringLiteral("/lib:") + craft + QStringLiteral("/plugins/mlt"));
+    env.insert(QStringLiteral("DYLD_FRAMEWORK_PATH"), craft + QStringLiteral("/lib"));
+    p.setProcessEnvironment(env);
+    p.start(ffprobe, QStringList{QStringLiteral("-v"), QStringLiteral("quiet"), QStringLiteral("-print_format"), QStringLiteral("json"),
+                                 QStringLiteral("-show_format"), QStringLiteral("-show_streams"), path});
+    if (!waitProcessPumped(p, 15000, QStringLiteral("probe_media"))) {
+        return GatewayProtocol::errorResponse(QStringLiteral("probe_media"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("probe_timeout"), QStringLiteral("ffprobe не ответил."));
+    }
+    const QJsonObject probe = QJsonDocument::fromJson(p.readAllStandardOutput()).object();
+    const QJsonObject fmt = probe.value(QStringLiteral("format")).toObject();
+    QJsonObject result{
+        {QStringLiteral("path"), path},
+        {QStringLiteral("duration_sec"), fmt.value(QStringLiteral("duration")).toString().toDouble()},
+        {QStringLiteral("format"), fmt.value(QStringLiteral("format_name")).toString()},
+        {QStringLiteral("size_bytes"), fmt.value(QStringLiteral("size")).toString().toLongLong()},
+    };
+    bool hasAudio = false, hasVideo = false;
+    for (const QJsonValue &sv : probe.value(QStringLiteral("streams")).toArray()) {
+        const QJsonObject st = sv.toObject();
+        const QString type = st.value(QStringLiteral("codec_type")).toString();
+        if (type == QStringLiteral("video") && !hasVideo) {
+            hasVideo = true;
+            result.insert(QStringLiteral("width"), st.value(QStringLiteral("width")).toInt());
+            result.insert(QStringLiteral("height"), st.value(QStringLiteral("height")).toInt());
+            result.insert(QStringLiteral("video_codec"), st.value(QStringLiteral("codec_name")).toString());
+            const QString rate = st.value(QStringLiteral("r_frame_rate")).toString();
+            double fps = 0; const QStringList rp = rate.split(QLatin1Char('/'));
+            if (rp.size() == 2 && rp[1].toDouble() != 0) fps = rp[0].toDouble() / rp[1].toDouble();
+            result.insert(QStringLiteral("fps"), fps);
+        } else if (type == QStringLiteral("audio") && !hasAudio) {
+            hasAudio = true;
+            result.insert(QStringLiteral("audio_codec"), st.value(QStringLiteral("codec_name")).toString());
+            result.insert(QStringLiteral("sample_rate"), st.value(QStringLiteral("sample_rate")).toString().toInt());
+            result.insert(QStringLiteral("channels"), st.value(QStringLiteral("channels")).toInt());
+        }
+    }
+    result.insert(QStringLiteral("has_video"), hasVideo);
+    result.insert(QStringLiteral("has_audio"), hasAudio);
+    return GatewayProtocol::successResponse(QStringLiteral("probe_media"), requestId, projectId(), timelineRevision(), result);
+}
