+QString GatewayService::handleLicenseStatus(const QString &requestId) const
+{
+    QJsonObject info;
+    gw_isActivated(info);
+    info.insert(QStringLiteral("hw_id"), gw_hwId());
+    return GatewayProtocol::successResponse(QStringLiteral("license_status"), requestId, projectId(), timelineRevision(), info);
+}
