+// lint_timeline — авто-поиск проблем монтажа + предложенные исправления.
+QString GatewayService::handleLintTimeline(const QString &requestId, const QJsonObject &params)
+{
+    auto tl = currentTimelineModel();
+    if (!tl) {
+        return GatewayProtocol::errorResponse(QStringLiteral("lint_timeline"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("timeline_unavailable"), QStringLiteral("Active timeline is not available."));
+    }
+    const double fps = m_core ? m_core->getCurrentFps() : 25.0;
+    const int minLen = params.value(QStringLiteral("min_clip_frames")).toInt(int(fps * 0.4)); // <0.4с = слишком короткий
+    QJsonArray issues;
+    int projEnd = 0, vClips = 0, aClips = 0;
+    for (int trackId : tl->getTracksIds(false)) {
+        QList<int> ids;
+        for (int it : tl->getItemsInRange(trackId, 0, -1, false)) if (tl->isClip(it)) ids.append(it);
+        std::sort(ids.begin(), ids.end(), [tl](int a, int b){ return tl->getClipPosition(a) < tl->getClipPosition(b); });
+        int prevEnd = -1;
+        for (int c : ids) {
+            ++vClips;
+            const int pos = tl->getClipPosition(c), dur = tl->getClipPlaytime(c);
+            projEnd = qMax(projEnd, pos + dur);
+            if (dur < minLen) {
+                issues.append(QJsonObject{{QStringLiteral("type"), QStringLiteral("short_clip")}, {QStringLiteral("clip_id"), c},
+                    {QStringLiteral("detail"), QStringLiteral("%1 кадров").arg(dur)}, {QStringLiteral("suggestion"), QStringLiteral("set_clip_duration или delete_range")}});
+            }
+            if (prevEnd >= 0 && pos > prevEnd) {
+                issues.append(QJsonObject{{QStringLiteral("type"), QStringLiteral("gap")}, {QStringLiteral("track_id"), trackId},
+                    {QStringLiteral("detail"), QStringLiteral("дырка %1→%2").arg(prevEnd).arg(pos)}, {QStringLiteral("suggestion"), QStringLiteral("delete_range{ripple:true} или сдвинуть клип")}});
+            }
+            prevEnd = pos + dur;
+        }
+    }
+    for (int trackId : tl->getTracksIds(true)) {
+        for (int it : tl->getItemsInRange(trackId, 0, -1, false)) if (tl->isClip(it)) ++aClips;
+    }
+    if (vClips > 0 && aClips == 0) {
+        issues.append(QJsonObject{{QStringLiteral("type"), QStringLiteral("no_audio")}, {QStringLiteral("detail"), QStringLiteral("на таймлайне нет аудио-клипов")},
+            {QStringLiteral("suggestion"), QStringLiteral("вставь музыку/озвучку или это норм для немого")}});
+    }
+    // выборочная проверка яркости (3 кадра)
+    if (projEnd > 0) {
+        int darkFound = 0;
+        for (int i = 0; i < 3; ++i) {
+            const int f = projEnd * i / 3 + 1;
+            const QString p = QStringLiteral("%1/vidra_lint_%2.png").arg(QDir::tempPath()).arg(f);
+            gw_captureFrame(f, p);
+            const QString v = gw_analyzeImage(p).value(QStringLiteral("verdict")).toString();
+            if (v == QStringLiteral("too_dark") || v == QStringLiteral("mostly_black")) ++darkFound;
+        }
+        if (darkFound >= 2) {
+            issues.append(QJsonObject{{QStringLiteral("type"), QStringLiteral("dark_video")}, {QStringLiteral("detail"), QStringLiteral("кадры в основном тёмные/чёрные")},
+                {QStringLiteral("suggestion"), QStringLiteral("apply_look{brightness}/avfilter.eq или проверь источники")}});
+        }
+    }
+    return GatewayProtocol::successResponse(QStringLiteral("lint_timeline"), requestId, projectId(), timelineRevision(),
+        QJsonObject{{QStringLiteral("clean"), issues.isEmpty()}, {QStringLiteral("video_clips"), vClips}, {QStringLiteral("audio_clips"), aClips},
+                    {QStringLiteral("project_end_frames"), projEnd}, {QStringLiteral("issues"), issues}});
+}
