+QString GatewayService::handleOpenUiScopeTool(const QString &requestId, const QJsonObject &params)
+{
+    if (m_core == nullptr || m_core->window() == nullptr) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("open_ui_scope_tool"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("scope_unavailable"),
+            QStringLiteral("MainWindow is not available.")
+        );
+    }
+
+    const QString toolId = params.value(QStringLiteral("tool_id")).toString();
+    if (toolId.trimmed().isEmpty()) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("open_ui_scope_tool"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("invalid_parameters"),
+            QStringLiteral("open_ui_scope_tool requires tool_id.")
+        );
+    }
+
+    const std::optional<UiScopeToolSpec> spec = findUiScopeToolSpec(toolId);
+    if (!spec.has_value()) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("open_ui_scope_tool"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("scope_tool_not_found"),
+            QStringLiteral("Requested scope tool was not found.")
+        );
+    }
+
+    const bool requestedOpen = params.contains(QStringLiteral("open")) ? params.value(QStringLiteral("open")).toBool() : true;
+    const bool focus = params.value(QStringLiteral("focus")).toBool(false);
+
+    KDDockWidgets::QtWidgets::DockWidget *dock = findNamedUiDock(m_core->window(), spec->dockName);
+    QAction *toggleAction = findUiDockToggleAction(m_core->window(), spec->dockName);
+    if (dock == nullptr && toggleAction == nullptr) {
+        if (qEnvironmentVariableIsSet("KDENLIVE_GATEWAY_SMOKE_MODE")) {
+            ++m_timelineRevision;
+            QJsonObject result = serializeUiScopeTool(*spec);
+            result.insert(QStringLiteral("simulated"), true);
+            result.insert(QStringLiteral("opened"), requestedOpen);
+            return GatewayProtocol::successResponse(
+                QStringLiteral("open_ui_scope_tool"),
+                requestId,
+                projectId(),
+                timelineRevision(),
+                result
+            );
+        }
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("open_ui_scope_tool"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("scope_tool_unavailable"),
+            QStringLiteral("Scope dock was not found.")
+        );
+    }
+
+    if (dock != nullptr) {
+        if (requestedOpen) {
+            dock->open();
+        } else {
+            dock->close();
+        }
+        if (requestedOpen && focus) {
+            dock->open();
+            dock->setAsCurrentTab();
+            dock->setFocus(Qt::OtherFocusReason);
+        }
+    } else if (toggleAction != nullptr && toggleAction->isChecked() != requestedOpen) {
+        toggleAction->trigger();
+    }
+    QCoreApplication::processEvents(QEventLoop::ExcludeSocketNotifiers);
+
+    ++m_timelineRevision;
+    QJsonObject result = serializeUiScopeTool(*spec, toggleAction, dock);
+    result.insert(QStringLiteral("simulated"), false);
+    result.insert(QStringLiteral("opened"), requestedOpen);
+    if (dock != nullptr || toggleAction != nullptr) {
+        result.insert(QStringLiteral("dock"), serializeUiDock(spec->dockName, dock != nullptr ? dock->windowTitle() : spec->title, toggleAction, dock));
+    }
+    return GatewayProtocol::successResponse(
+        QStringLiteral("open_ui_scope_tool"),
+        requestId,
+        projectId(),
+        timelineRevision(),
+        result
+    );
+}
