+QString GatewayService::handleSaveProject(const QString &requestId, const QString &savePath)
+{
+    if (m_core == nullptr || m_core->projectManager() == nullptr) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("save_project"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("project_manager_unavailable"),
+            QStringLiteral("ProjectManager is not available.")
+        );
+    }
+
+    bool saved = false;
+    QString effectivePath = savePath;
+    if (savePath.trimmed().isEmpty()) {
+        saved = m_core->projectManager()->saveFile();
+        if (m_core->currentDoc() != nullptr) {
+            effectivePath = m_core->currentDoc()->url().toLocalFile();
+        }
+    } else {
+        saved = m_core->projectManager()->saveFileAs(savePath, true, false);
+    }
+
+    if (!saved) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("save_project"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("save_failed"),
+            QStringLiteral("Project save failed.")
+        );
+    }
+
+    return GatewayProtocol::successResponse(
+        QStringLiteral("save_project"),
+        requestId,
+        effectivePath.isEmpty() ? projectId() : effectivePath,
+        timelineRevision(),
+        QJsonObject{{QStringLiteral("save_path"), effectivePath}}
+    );
+}
