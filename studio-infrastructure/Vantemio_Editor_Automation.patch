+QString GatewayService::handleOpenUiMixerTool(const QString &requestId, const QJsonObject &params)
+{
+    if (m_core == nullptr || m_core->window() == nullptr || m_core->mixer() == nullptr) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("open_ui_mixer_tool"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("mixer_unavailable"),
+            QStringLiteral("MainWindow or MixerManager is not available.")
+        );
+    }
+
+    const QString toolId = params.value(QStringLiteral("tool_id")).toString();
+    if (toolId.trimmed().isEmpty()) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("open_ui_mixer_tool"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("invalid_parameters"),
+            QStringLiteral("open_ui_mixer_tool requires tool_id.")
+        );
+    }
+
+    const std::optional<UiMixerToolSpec> spec = findUiMixerToolSpec(toolId);
+    if (!spec.has_value()) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("open_ui_mixer_tool"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("mixer_tool_not_found"),
+            QStringLiteral("Requested mixer tool was not found.")
+        );
+    }
+
+    QAction *action = nullptr;
+    KDDockWidgets::QtWidgets::DockWidget *dock = nullptr;
+    bool performed = false;
+
+    if (spec->kind == QStringLiteral("dock")) {
+        dock = findNamedUiDock(m_core->window(), spec->targetName);
+        if (dock == nullptr) {
+            return GatewayProtocol::errorResponse(
+                QStringLiteral("open_ui_mixer_tool"),
+                requestId,
+                projectId(),
+                timelineRevision(),
+                QStringLiteral("mixer_dock_unavailable"),
+                QStringLiteral("Audio mixer dock was not found.")
+            );
+        }
+        const bool open = params.contains(QStringLiteral("open")) ? params.value(QStringLiteral("open")).toBool() : true;
+        if (open) {
+            dock->open();
+        } else {
+            dock->close();
+        }
+        if (open && params.value(QStringLiteral("focus")).toBool(false)) {
+            dock->open();
+            dock->setAsCurrentTab();
+            dock->setFocus(Qt::OtherFocusReason);
+        }
+        performed = true;
+    } else if (spec->toolId == QStringLiteral("collapse_mixer_tracks")) {
+        KdenliveSettings::setMixerCollapse(true);
+        m_core->mixer()->collapseMixers();
+        performed = true;
+    } else if (spec->toolId == QStringLiteral("expand_mixer_tracks")) {
+        KdenliveSettings::setMixerCollapse(false);
+        m_core->mixer()->collapseMixers();
+        performed = true;
+    } else if (spec->toolId == QStringLiteral("monitor_track") || spec->toolId == QStringLiteral("unmonitor_track")) {
+        if (!params.contains(QStringLiteral("track_id"))) {
+            return GatewayProtocol::errorResponse(
+                QStringLiteral("open_ui_mixer_tool"),
+                requestId,
+                projectId(),
+                timelineRevision(),
+                QStringLiteral("invalid_parameters"),
+                QStringLiteral("monitor_track and unmonitor_track require track_id.")
+            );
+        }
+        const int trackId = params.value(QStringLiteral("track_id")).toInt(-1);
+        if (!m_core->mixer()->hasTrackMixer(trackId)) {
+            return GatewayProtocol::errorResponse(
+                QStringLiteral("open_ui_mixer_tool"),
+                requestId,
+                projectId(),
+                timelineRevision(),
+                QStringLiteral("mixer_track_not_found"),
+                QStringLiteral("Requested mixer track id is not registered.")
+            );
+        }
+        m_core->mixer()->monitorAudio(trackId, spec->toolId == QStringLiteral("monitor_track"));
+        performed = true;
+    }
+
+    QCoreApplication::processEvents(QEventLoop::ExcludeSocketNotifiers);
+
+    ++m_timelineRevision;
+    QJsonObject result = serializeUiMixerTool(*spec, action, dock);
+    result.insert(QStringLiteral("performed"), performed);
+    result.insert(QStringLiteral("simulated"), false);
+    if (dock != nullptr) {
+        result.insert(QStringLiteral("dock"), serializeUiDock(spec->targetName, dock->windowTitle(), dock->toggleAction(), dock));
+    }
+    QJsonArray trackIds;
+    for (int tid : m_core->mixer()->registeredTrackIds()) {
+        trackIds.push_back(tid);
+    }
+    result.insert(QStringLiteral("registered_track_ids"), trackIds);
+    result.insert(QStringLiteral("registered_track_count"), int(m_core->mixer()->registeredTrackIds().size()));
+    result.insert(QStringLiteral("mixer_collapsed"), KdenliveSettings::mixerCollapse());
+    result.insert(QStringLiteral("monitored_track_id"), m_core->mixer()->recordTrack());
+    result.insert(QStringLiteral("audio_level_v2"), m_core->mixer()->audioLevelV2());
+    return GatewayProtocol::successResponse(
+        QStringLiteral("open_ui_mixer_tool"),
+        requestId,
+        projectId(),
+        timelineRevision(),
+        result
+    );
+}
