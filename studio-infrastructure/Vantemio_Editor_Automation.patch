+
+// Пакетная раскладка клипов встык на одном треке = собрать монтаж одним вызовом.
+// params: track_id, items:[{clip_path, duration_frames?}], start_position?
+// Асинхронно (как insert_clip): ok+pending → push sequence.done {clip_ids}/sequence.failed.
+QString GatewayService::handleInsertSequence(const QString &requestId, const QJsonObject &params)
+{
+    auto tl = currentTimelineModel();
+    if (!tl) {
+        return GatewayProtocol::errorResponse(QStringLiteral("insert_sequence"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("timeline_unavailable"), QStringLiteral("Active timeline is not available."));
+    }
+    const int trackId = params.value(QStringLiteral("track_id")).toInt(-1);
+    if (!tl->isTrack(trackId)) {
+        return GatewayProtocol::errorResponse(QStringLiteral("insert_sequence"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("track_not_found"), QStringLiteral("insert_sequence требует валидный track_id."));
+    }
+    const QJsonArray items = params.value(QStringLiteral("items")).toArray();
+    if (items.isEmpty()) {
+        return GatewayProtocol::errorResponse(QStringLiteral("insert_sequence"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("empty_items"), QStringLiteral("insert_sequence требует непустой массив items[{clip_path,duration_frames?}]."));
+    }
+    const int startPos = params.value(QStringLiteral("start_position")).toInt(0);
+    const QString rid = requestId;
+    enqueueJob([this, trackId, items, startPos, rid]() {
+        QJsonArray clipIds;
+        QString errCode;
+        int pos = startPos;
+        for (const QJsonValue &it : items) {
+            const QJsonObject o = it.toObject();
+            const QString clipPath = o.value(QStringLiteral("clip_path")).toString();
+            const QFileInfo f(clipPath);
+            if (!f.exists()) { errCode = QStringLiteral("file_not_found:") + clipPath; break; }
+            QStringList binIds = m_core->projectItemModel()->getClipByUrl(f);
+            if (binIds.isEmpty()) {
+                Fun undo = []() { return true; };
+                Fun redo = []() { return true; };
+                const auto root = m_core->projectItemModel()->getRootFolder();
+                const QString rootId = root ? root->clipId() : QStringLiteral("-1");
+                const std::function<void(const QString &)> cb = [](const QString &) {};
+                const QString newId = ClipCreator::createClipFromFile(f.absoluteFilePath(), rootId, m_core->projectItemModel(), undo, redo, cb, false);
+                if (newId != QStringLiteral("-1") && !newId.isEmpty()) {
+                    m_core->pushUndo(undo, redo, QStringLiteral("Add clip (sequence)"));
+                    binIds = QStringList{newId};
+                }
+            }
+            if (binIds.isEmpty()) { errCode = QStringLiteral("bin_import_failed:") + clipPath; break; }
+            const QString binId = binIds.constFirst();
+            auto clip = m_core->projectItemModel()->getClipByBinID(binId);
+            QElapsedTimer rdy; rdy.start();
+            while (clip && !clip->statusReady() && rdy.elapsed() < 20000) {
+                QCoreApplication::processEvents(QEventLoop::ExcludeSocketNotifiers,50);
+            }
+            if (clip && !clip->statusReady()) { errCode = QStringLiteral("clip_not_ready:") + clipPath; break; }
+            int clipId = -1;
+            auto tl2 = currentTimelineModel();
+            if (!tl2 || !tl2->requestClipInsertion(binId, trackId, pos, clipId, true, true, false) || clipId < 0) {
+                errCode = QStringLiteral("insert_failed:") + clipPath; break;
+            }
+            // обрезать до duration_frames, если задано
+            const int wantDur = o.value(QStringLiteral("duration_frames")).toInt(-1);
+            if (wantDur > 0) {
+                tl2->requestItemResize(clipId, wantDur, true, true);
+            }
+            const int actualDur = tl2->getClipPlaytime(clipId);
+            pos += actualDur;
+            clipIds.append(clipId);
+            ++m_timelineRevision;
+        }
+        QJsonObject ev{
+            {QStringLiteral("kind"), QStringLiteral("event")},
+            {QStringLiteral("request_id"), rid},
+            {QStringLiteral("track_id"), trackId},
+        };
+        if (errCode.isEmpty()) {
+            ev[QStringLiteral("event")] = QStringLiteral("sequence.done");
+            ev[QStringLiteral("clip_ids")] = clipIds;
+            ev[QStringLiteral("count")] = clipIds.size();
+            ev[QStringLiteral("end_position")] = pos;
+        } else {
+            ev[QStringLiteral("event")] = QStringLiteral("sequence.failed");
+            ev[QStringLiteral("error")] = errCode;
+            ev[QStringLiteral("inserted")] = clipIds;
+        }
+        pushEvent(ev);
+    });
+    return GatewayProtocol::successResponse(QStringLiteral("insert_sequence"), requestId, projectId(), timelineRevision(),
+        QJsonObject{{QStringLiteral("status_detail"), QStringLiteral("pending")},
+                    {QStringLiteral("track_id"), trackId},
+                    {QStringLiteral("items_count"), items.size()},
+                    {QStringLiteral("note"), QStringLiteral("Асинхронно. subscribe_events → жди sequence.done (clip_ids) или sequence.failed (error+inserted).")}});
+}
+
+// ============================================================================
+// ЛИЦЕНЗИЯ / АКТИВАЦИЯ VidRA AI (онлайн-модель).
+// Ключи выдаёт/отзывает сервер продавца. Клиент кэширует подписанный токен
+// локально (HMAC-целостность + привязка к железу + срок). Без активации gateway
+// блокирует монтаж/эффекты/рендер/AI/обновление, оставляя интроспекцию и activate.
+// ВНИМАНИЕ: т.к. бинарь GPL, локальная проверка — «лежачий полицейский»; настоящая
+// неподделываемость — на стороне сервера (выдача/отзыв) и серверного мозга.
+// ============================================================================
+namespace {
+// Безопасное получение строки эффект-стека: защита от невалидного row.
+// Без этого getEffectStackRow(-1) / вне диапазона роняет ядро (SIGSEGV в dynamic_cast).
+std::shared_ptr<EffectItemModel> gw_safeEffectRow(const std::shared_ptr<EffectStackModel> &stack, int idx)
+{
+    if (!stack || idx < 0 || idx >= stack->rowCount()) return nullptr;
+    return std::dynamic_pointer_cast<EffectItemModel>(stack->getEffectStackRow(idx));
+}
+// Секрет целостности локального токена (синхронизирован с сервером активации).
+// 0731 ПРЕД-ПРОДАЖНАЯ ГИГИЕНА: значение больше НЕ зашито в исходник — читается из env
+// VIDRA_LICENSE_SECRET (должно совпадать с сервером активации). Без env контур закрыт
+// «в отказ»: ни один локальный токен не сойдётся, активация не пройдёт.
+QByteArray gw_licenseSecret()
+{
+    return qgetenv("VIDRA_LICENSE_SECRET");
+}
+// Мастер-токен разработчика: на наших машинах ставим env VIDRA_MASTER=<значение
+// VIDRA_MASTER_TOKEN>, и активация не нужна (полный доступ без ключей).
+// 0731: значение из env, не из исходника; без env мастер-режим выключен.
+QByteArray gw_masterToken()
+{
+    return qgetenv("VIDRA_MASTER_TOKEN");
+}
+
+QString gw_hwId()
+{
+    // Стабильный идентификатор машины (для привязки лицензии к железу).
+    QByteArray id = QSysInfo::machineUniqueId();
+    if (id.isEmpty()) {
+        id = QSysInfo::machineHostName().toUtf8();
+    }
+    return QString::fromLatin1(QCryptographicHash::hash(id, QCryptographicHash::Sha256).toHex().left(16));
+}
+
+QString gw_licensePath()
+{
+    const QString dir = QStandardPaths::writableLocation(QStandardPaths::AppConfigLocation);
+    return dir + QStringLiteral("/vidra_license.json");
+}
+
+// Ожидаемый токен целостности для записи лицензии.
+QString gw_expectedToken(const QString &key, const QString &edition, const QString &expires, const QString &hw)
+{
+    const QByteArray msg = (key + QLatin1Char('|') + edition + QLatin1Char('|') + expires + QLatin1Char('|') + hw).toUtf8();
+    return QString::fromLatin1(QMessageAuthenticationCode::hash(msg, gw_licenseSecret(), QCryptographicHash::Sha256).toHex());
+}
+} // namespace
+
+// Проверка активации. Заполняет info (edition/expires/source). Возвращает true если активна.
+bool GatewayService::gw_isActivated(QJsonObject &info) const
+{
+    // 1) мастер-режим разработчика (выключен, если VIDRA_MASTER_TOKEN не задан)
+    const QByteArray master = gw_masterToken();
+    if (!master.isEmpty() && qgetenv("VIDRA_MASTER") == master) {
+        info = QJsonObject{{QStringLiteral("activated"), true}, {QStringLiteral("edition"), QStringLiteral("developer")},
+                           {QStringLiteral("source"), QStringLiteral("master_env")}, {QStringLiteral("expires"), QStringLiteral("never")}};
+        return true;
+    }
+    // 2) локальный кэш лицензии (его пишет vidra_license.sh после онлайн-активации)
+    QFile f(gw_licensePath());
+    if (!f.open(QIODevice::ReadOnly)) {
+        info = QJsonObject{{QStringLiteral("activated"), false}, {QStringLiteral("reason"), QStringLiteral("no_license")}};
+        return false;
+    }
+    const QJsonObject lic = QJsonDocument::fromJson(f.readAll()).object();
+    f.close();
+    const QString key = lic.value(QStringLiteral("key")).toString();
+    const QString edition = lic.value(QStringLiteral("edition")).toString();
+    const QString expires = lic.value(QStringLiteral("expires")).toString();
+    const QString hw = lic.value(QStringLiteral("hw")).toString();
+    const QString token = lic.value(QStringLiteral("token")).toString();
+    // целостность токена
+    if (token.isEmpty() || token != gw_expectedToken(key, edition, expires, hw)) {
+        info = QJsonObject{{QStringLiteral("activated"), false}, {QStringLiteral("reason"), QStringLiteral("invalid_token")}};
+        return false;
+    }
+    // привязка к железу
+    if (hw != gw_hwId()) {
+        info = QJsonObject{{QStringLiteral("activated"), false}, {QStringLiteral("reason"), QStringLiteral("hardware_mismatch")}};
+        return false;
+    }
+    // срок (expires пусто/"never"/"0" = бессрочно)
+    if (!expires.isEmpty() && expires != QStringLiteral("never") && expires != QStringLiteral("0")) {
+        const QDate exp = QDate::fromString(expires, QStringLiteral("yyyy-MM-dd"));
+        if (exp.isValid() && exp < QDate::currentDate()) {
+            info = QJsonObject{{QStringLiteral("activated"), false}, {QStringLiteral("reason"), QStringLiteral("expired")}, {QStringLiteral("expires"), expires}};
+            return false;
+        }
+    }
+    info = QJsonObject{{QStringLiteral("activated"), true}, {QStringLiteral("edition"), edition},
+                       {QStringLiteral("expires"), expires.isEmpty() ? QStringLiteral("never") : expires},
+                       {QStringLiteral("source"), QStringLiteral("license_file")}};
+    return true;
+}
