+QString GatewayService::handleDescribeFrame(const QString &requestId, const QJsonObject &params) const
+{
+    const QString path = params.value(QStringLiteral("path")).toString();
+    QImage img(path);
+    if (img.isNull()) {
+        return GatewayProtocol::errorResponse(QStringLiteral("describe_frame"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("image_not_found"), QStringLiteral("describe_frame требует path к PNG (сначала screenshot_monitor)."));
+    }
+    const QImage small = img.scaled(160, 90, Qt::KeepAspectRatio, Qt::FastTransformation).convertToFormat(QImage::Format_RGB32);
+    double sumL = 0, sumR = 0, sumG = 0, sumB = 0, sumL2 = 0;
+    qint64 n = 0, black = 0, bright = 0;
+    for (int y = 0; y < small.height(); ++y) {
+        for (int x = 0; x < small.width(); ++x) {
+            const QRgb p = small.pixel(x, y);
+            const double r = qRed(p), g = qGreen(p), b = qBlue(p);
+            const double lum = (0.299 * r + 0.587 * g + 0.114 * b) / 255.0;
+            sumL += lum; sumL2 += lum * lum; sumR += r; sumG += g; sumB += b;
+            if (lum < 0.06) ++black;
+            if (lum > 0.94) ++bright;
+            ++n;
+        }
+    }
+    if (n == 0) n = 1;
+    const double meanL = sumL / n;
+    const double variance = qMax(0.0, sumL2 / n - meanL * meanL);
+    QString verdict = QStringLiteral("ok");
+    if (meanL < 0.18) verdict = QStringLiteral("too_dark");
+    else if (meanL > 0.85) verdict = QStringLiteral("too_bright");
+    else if (double(black) / n > 0.9) verdict = QStringLiteral("mostly_black");
+    return GatewayProtocol::successResponse(QStringLiteral("describe_frame"), requestId, projectId(), timelineRevision(),
+        QJsonObject{
+            {QStringLiteral("path"), path}, {QStringLiteral("width"), img.width()}, {QStringLiteral("height"), img.height()},
+            {QStringLiteral("brightness"), meanL}, {QStringLiteral("contrast"), qSqrt(variance)},
+            {QStringLiteral("avg_rgb"), QJsonArray{int(qRound(sumR / n)), int(qRound(sumG / n)), int(qRound(sumB / n))}},
+            {QStringLiteral("black_ratio"), double(black) / n}, {QStringLiteral("bright_ratio"), double(bright) / n},
+            {QStringLiteral("verdict"), verdict},
+        });
+}
+
+QString GatewayService::handleDescribeEffect(const QString &requestId, const QJsonObject &params) const
+{
+    auto tl = currentTimelineModel();
+    const int clipId = params.value(QStringLiteral("clip_id")).toInt(-1);
+    const QString effectName = params.value(QStringLiteral("effect_name")).toString().trimmed();
+
+    // РЕЖИМ КАТАЛОГА: описать параметры эффекта/перехода ПО ИМЕНИ, до применения
+    // к клипу. Нужно "мозгу", чтобы видеть min/max/default/type каждого параметра
+    // и осознанно подбирать значения. Срабатывает, когда не задан валидный clip_id.
+    if (clipId < 0 && !effectName.isEmpty()) {
+        QDomElement xml;
+        QString kind;
+        if (EffectsRepository::get()->exists(effectName)) {
+            xml = EffectsRepository::get()->getXml(effectName);
+            kind = QStringLiteral("effect");
+        } else if (TransitionsRepository::get()->exists(effectName)) {
+            xml = TransitionsRepository::get()->getXml(effectName);
+            kind = QStringLiteral("transition");
+        } else {
+            return GatewayProtocol::errorResponse(QStringLiteral("describe_effect"), requestId, projectId(), timelineRevision(),
+                QStringLiteral("effect_not_found"),
+                QStringLiteral("Нет эффекта/перехода с таким effect_name в репозитории (см. all_effects.json)."));
+        }
+        QJsonArray ps;
+        const QDomNodeList plist = xml.elementsByTagName(QStringLiteral("parameter"));
+        for (int i = 0; i < plist.count(); ++i) {
+            const QDomElement pe = plist.at(i).toElement();
+            QString label = pe.attribute(QStringLiteral("name"));
+            const QDomNodeList names = pe.elementsByTagName(QStringLiteral("name"));
+            if (!names.isEmpty()) {
+                label = names.at(0).toElement().text();
+            }
+            QJsonObject p{
+                {QStringLiteral("name"), pe.attribute(QStringLiteral("name"))},
+                {QStringLiteral("label"), label},
+                {QStringLiteral("type"), pe.attribute(QStringLiteral("type"))},
+                {QStringLiteral("default"), pe.attribute(QStringLiteral("default"))},
+                {QStringLiteral("min"), pe.attribute(QStringLiteral("min"))},
+                {QStringLiteral("max"), pe.attribute(QStringLiteral("max"))},
+                {QStringLiteral("factor"), pe.attribute(QStringLiteral("factor"))},
+                {QStringLiteral("suffix"), pe.attribute(QStringLiteral("suffix"))},
+                {QStringLiteral("decimals"), pe.attribute(QStringLiteral("decimals"))},
+            };
+            ps.append(p);
+        }
+        return GatewayProtocol::successResponse(QStringLiteral("describe_effect"), requestId, projectId(), timelineRevision(),
+            QJsonObject{{QStringLiteral("mode"), QStringLiteral("catalog")},
+                        {QStringLiteral("kind"), kind},
+                        {QStringLiteral("effect_id"), effectName},
+                        {QStringLiteral("name"), EffectsRepository::get()->exists(effectName) ? EffectsRepository::get()->getName(effectName) : TransitionsRepository::get()->getName(effectName)},
+                        {QStringLiteral("param_count"), ps.size()},
+                        {QStringLiteral("params"), ps}});
+    }
+
+    if (!tl || !tl->isClip(clipId)) {
+        return GatewayProtocol::errorResponse(QStringLiteral("describe_effect"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("clip_not_found"),
+            QStringLiteral("Нет клипа с таким clip_id. Для описания по имени передай effect_name без clip_id (режим каталога)."));
+    }
+    std::shared_ptr<EffectStackModel> stack = tl->getClipEffectStackModel(clipId);
+    const int row = params.value(QStringLiteral("effect_row")).toInt();
+    std::shared_ptr<EffectItemModel> eff = gw_safeEffectRow(stack, row);
+    if (!eff) {
+        return GatewayProtocol::errorResponse(QStringLiteral("describe_effect"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("effect_not_found"), QStringLiteral("Нет эффекта в этой строке (см. list_effects)."));
+    }
+    // EffectItemModel наследует AssetParameterModel (QAbstractListModel): каждая строка = параметр.
+    AssetParameterModel *apm = eff.get();
+    QJsonArray ps;
+    const int pc = apm->rowCount();
+    for (int r = 0; r < pc; ++r) {
+        const QModelIndex ix = apm->index(r, 0);
+        const QString pname = apm->data(ix, AssetParameterModel::NameRole).toString();
+        QJsonObject p{
+            {QStringLiteral("name"), pname},
+            {QStringLiteral("label"), apm->data(ix, AssetParameterModel::NameRole).toString()},
+            {QStringLiteral("type"), apm->data(ix, AssetParameterModel::TypeRole).toInt()},
+            {QStringLiteral("min"), apm->data(ix, AssetParameterModel::MinRole).toDouble()},
+            {QStringLiteral("max"), apm->data(ix, AssetParameterModel::MaxRole).toDouble()},
+            {QStringLiteral("default"), apm->data(ix, AssetParameterModel::DefaultRole).toString()},
+            {QStringLiteral("suffix"), apm->data(ix, AssetParameterModel::SuffixRole).toString()},
+            {QStringLiteral("value"), apm->getParamFromName(pname).toString()},
+        };
+        ps.append(p);
+    }
+    return GatewayProtocol::successResponse(QStringLiteral("describe_effect"), requestId, projectId(), timelineRevision(),
+        QJsonObject{{QStringLiteral("clip_id"), clipId}, {QStringLiteral("effect_row"), row},
+                    {QStringLiteral("effect_id"), eff->getAssetId()}, {QStringLiteral("param_count"), ps.size()}, {QStringLiteral("params"), ps}});
+}
+
+QString GatewayService::handlePreviewDraft(const QString &requestId, const QJsonObject &params)
+{
+    QString out = params.value(QStringLiteral("output_path")).toString();
+    if (out.isEmpty()) {
+        out = QDir::tempPath() + QStringLiteral("/vidra_draft_%1.mp4").arg(timelineRevision());
+    }
+    const QString preset = params.value(QStringLiteral("preset")).toString().isEmpty()
+        ? QStringLiteral("H.264 (libx264+aac)") : params.value(QStringLiteral("preset")).toString();
+    return handleRenderMaster(requestId, out, preset, true);
+}
+
+QString GatewayService::projectId() const
+{
+    if (m_core != nullptr && m_core->currentDoc() != nullptr) {
+        const QString path = m_core->currentDoc()->url().toLocalFile();
+        if (!path.isEmpty()) {
+            return path;
+        }
+        return m_core->currentDoc()->activeUuid.toString(QUuid::WithoutBraces);
+    }
+    return QStringLiteral("active_kdenlive_project");
+}
+
+int GatewayService::timelineRevision() const
+{
+    return m_timelineRevision;
+}
+
+TimelineWidget *GatewayService::currentTimeline() const
+{
+    if (m_core == nullptr || m_core->window() == nullptr) {
+        return nullptr;
+    }
+    return m_core->window()->getCurrentTimeline();
+}
+
+TimelineController *GatewayService::currentController() const
+{
+    TimelineWidget *timeline = currentTimeline();
+    return timeline == nullptr ? nullptr : timeline->controller();
+}
+
+std::shared_ptr<TimelineItemModel> GatewayService::currentTimelineModel() const
+{
+    TimelineWidget *timeline = currentTimeline();
+    return timeline == nullptr ? nullptr : timeline->model();
+}
+
+std::shared_ptr<SubtitleModel> GatewayService::currentSubtitleModel(bool createIfMissing) const
+{
+    auto timelineModel = currentTimelineModel();
+    if (!timelineModel) {
+        return nullptr;
+    }
+    if (!timelineModel->hasSubtitleModel() && createIfMissing) {
+        return timelineModel->createSubtitleModel();
+    }
+    return timelineModel->hasSubtitleModel() ? timelineModel->getSubtitleModel() : nullptr;
+}
+
