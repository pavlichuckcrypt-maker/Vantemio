+// compare_frames — сравнить два кадра (оценить влияние эффекта/изменения).
+QString GatewayService::handleCompareFrames(const QString &requestId, const QJsonObject &params) const
+{
+    const QString a = params.value(QStringLiteral("a")).toString();
+    const QString b = params.value(QStringLiteral("b")).toString();
+    QImage ia(a), ib(b);
+    if (ia.isNull() || ib.isNull()) {
+        return GatewayProtocol::errorResponse(QStringLiteral("compare_frames"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("image_not_found"), QStringLiteral("compare_frames требует пути a и b к PNG."));
+    }
+    const QImage sa = ia.scaled(160, 90, Qt::IgnoreAspectRatio, Qt::FastTransformation).convertToFormat(QImage::Format_RGB32);
+    const QImage sb = ib.scaled(160, 90, Qt::IgnoreAspectRatio, Qt::FastTransformation).convertToFormat(QImage::Format_RGB32);
+    double diffSum = 0; qint64 n = 0; qint64 changed = 0;
+    for (int y = 0; y < sa.height(); ++y) {
+        for (int x = 0; x < sa.width(); ++x) {
+            const QRgb pa = sa.pixel(x, y), pb = sb.pixel(x, y);
+            const double d = (qAbs(qRed(pa) - qRed(pb)) + qAbs(qGreen(pa) - qGreen(pb)) + qAbs(qBlue(pa) - qBlue(pb))) / 3.0 / 255.0;
+            diffSum += d; if (d > 0.06) ++changed; ++n;
+        }
+    }
+    if (n == 0) n = 1;
+    return GatewayProtocol::successResponse(QStringLiteral("compare_frames"), requestId, projectId(), timelineRevision(),
+        QJsonObject{{QStringLiteral("a"), a}, {QStringLiteral("b"), b},
+                    {QStringLiteral("mean_diff"), diffSum / n}, {QStringLiteral("changed_ratio"), double(changed) / n},
+                    {QStringLiteral("identical"), diffSum / n < 0.01}});
+}
+
+// Захват одного кадra монитора в файл (seek+settle+extract+повтор при чёрном).
+bool GatewayService::gw_captureFrame(int frame, const QString &path)
+{
+    if (m_core == nullptr || m_core->monitorManager() == nullptr || m_core->monitorManager()->projectMonitor() == nullptr) {
+        return false;
+    }
+    Monitor *mon = m_core->monitorManager()->projectMonitor();
+    QFile::remove(path);
+    mon->requestSeek(frame);
+    QElapsedTimer settle; settle.start();
+    while (settle.elapsed() < 500) QCoreApplication::processEvents(QEventLoop::ExcludeSocketNotifiers,60);
+    mon->extractFrame(path);
+    QElapsedTimer t; t.start();
+    while (!QFileInfo::exists(path) && t.elapsed() < 3000) QCoreApplication::processEvents(QEventLoop::ExcludeSocketNotifiers,50);
+    QCoreApplication::processEvents(QEventLoop::ExcludeSocketNotifiers,150);
+    if (gw_analyzeImage(path).value(QStringLiteral("brightness")).toDouble() < 0.001) {
+        QElapsedTimer s2; s2.start();
+        while (s2.elapsed() < 400) QCoreApplication::processEvents(QEventLoop::ExcludeSocketNotifiers,60);
+        mon->extractFrame(path);
+        s2.restart();
+        while (s2.elapsed() < 400) QCoreApplication::processEvents(QEventLoop::ExcludeSocketNotifiers,60);
+    }
+    return QFileInfo::exists(path);
+}
