+QString GatewayService::handleQtListMethods(const QString &requestId, const QJsonObject &params) const
+{
+    QObject *o = gw_resolveObject(params.value(QStringLiteral("id")).toString());
+    if (o == nullptr) {
+        return GatewayProtocol::errorResponse(QStringLiteral("qt_list_methods"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("object_not_found"), QStringLiteral("No Qt object matched the requested id."));
+    }
+    QJsonArray arr;
+    const QMetaObject *mo = o->metaObject();
+    for (int i = 0; i < mo->methodCount(); ++i) {
+        const QMetaMethod m = mo->method(i);
+        QString kind = QStringLiteral("method");
+        if (m.methodType() == QMetaMethod::Signal) {
+            kind = QStringLiteral("signal");
+        } else if (m.methodType() == QMetaMethod::Slot) {
+            kind = QStringLiteral("slot");
+        }
+        arr.append(QJsonObject{
+            {QStringLiteral("signature"), QString::fromUtf8(m.methodSignature())},
+            {QStringLiteral("kind"), kind},
+            {QStringLiteral("return_type"), QString::fromUtf8(m.typeName())},
+            {QStringLiteral("arg_count"), m.parameterCount()},
+        });
+    }
+    return GatewayProtocol::successResponse(QStringLiteral("qt_list_methods"), requestId, projectId(), timelineRevision(),
+        QJsonObject{{QStringLiteral("count"), arr.size()}, {QStringLiteral("methods"), arr}});
+}
