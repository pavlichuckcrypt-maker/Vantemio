+QString resolveUiLayoutFilePath(const QString &fileName)
+{
+    if (fileName.trimmed().isEmpty()) {
+        return {};
+    }
+
+    const QString appDir = QCoreApplication::applicationDirPath();
+    const QStringList candidatePaths{
+        QDir(appDir).absoluteFilePath(QStringLiteral("../share/layouts/") + fileName),
+        QDir(appDir).absoluteFilePath(QStringLiteral("../Resources/layouts/") + fileName),
+        QDir(appDir).absoluteFilePath(QStringLiteral("../../kdenlive-src/data/layouts/") + fileName),
+        QDir(appDir).absoluteFilePath(QStringLiteral("../kdenlive-src/data/layouts/") + fileName)
+    };
+    for (const QString &candidate : candidatePaths) {
+        if (QFileInfo::exists(candidate)) {
+            return QFileInfo(candidate).absoluteFilePath();
+        }
+    }
+    return {};
+}
+
+QList<LayoutInfo> collectAvailableUiLayouts()
+{
+    LayoutCollection layouts;
+    layouts.loadLayouts();
+    QMap<QString, LayoutInfo> mergedLayouts;
+    for (const LayoutInfo &layout : layouts.getAllLayouts()) {
+        mergedLayouts.insert(layout.internalId, layout);
+    }
+
+    for (const BuiltinUiLayoutSpec &spec : builtinUiLayoutSpecs()) {
+        LayoutInfo layout = mergedLayouts.value(spec.layoutId, LayoutInfo(spec.layoutId, spec.displayName));
+        if (layout.displayName.isEmpty()) {
+            layout.displayName = spec.displayName;
+        }
+        if (layout.path.isEmpty()) {
+            layout.path = resolveUiLayoutFilePath(spec.horizontalFileName);
+        }
+        if (layout.verticalPath.isEmpty()) {
+            layout.verticalPath = resolveUiLayoutFilePath(spec.verticalFileName);
+        }
+        if (layout.path.isEmpty() && layout.verticalPath.isEmpty() && mergedLayouts.contains(spec.layoutId)) {
+            layout.path = mergedLayouts.value(spec.layoutId).path;
+            layout.verticalPath = mergedLayouts.value(spec.layoutId).verticalPath;
+        }
+        layout.isDefault = true;
+        mergedLayouts.insert(spec.layoutId, layout);
+    }
+
+    QList<LayoutInfo> result;
+    for (const BuiltinUiLayoutSpec &spec : builtinUiLayoutSpecs()) {
+        if (mergedLayouts.contains(spec.layoutId)) {
+            result.push_back(mergedLayouts.value(spec.layoutId));
+            mergedLayouts.remove(spec.layoutId);
+        }
+    }
+    const QList<LayoutInfo> remainingLayouts = mergedLayouts.values();
+    for (const LayoutInfo &layout : remainingLayouts) {
+        result.push_back(layout);
+    }
+    return result;
+}
+
+LayoutInfo findAvailableUiLayout(const QString &layoutId)
+{
+    const QList<LayoutInfo> layouts = collectAvailableUiLayouts();
+    for (const LayoutInfo &layout : layouts) {
+        if (layout.internalId == layoutId) {
+            return layout;
+        }
+    }
+    return {};
+}
