+QString GatewayService::handleGetProjectState(const QString &requestId) const
+{
+    auto timelineModel = currentTimelineModel();
+    auto subtitleModel = currentSubtitleModel(false);
+    QJsonObject result{
+        {QStringLiteral("project_id"), projectId()},
+        {QStringLiteral("timeline_revision"), timelineRevision()},
+        {QStringLiteral("render_status"), m_lastRenderStatus},
+        {QStringLiteral("render_output"), m_lastRenderOutput},
+        {QStringLiteral("render_preset"), m_lastRenderPreset},
+        {QStringLiteral("render_error"), m_lastRenderError}
+    };
+
+    if (m_core != nullptr && m_core->currentDoc() != nullptr) {
+        result.insert(QStringLiteral("project_path"), m_core->currentDoc()->url().toLocalFile());
+        result.insert(QStringLiteral("active_timeline_uuid"), m_core->currentDoc()->activeUuid.toString(QUuid::WithoutBraces));
+    }
+
+    if (timelineModel) {
+        result.insert(QStringLiteral("tracks_count"), timelineModel->getTracksCount());
+        result.insert(QStringLiteral("clips_count"), timelineModel->getClipsCount());
+        result.insert(QStringLiteral("compositions_count"), timelineModel->getCompositionsCount());
+        result.insert(QStringLiteral("selection"), jsonArrayFromIntSet(timelineModel->getCurrentSelection()));
+    }
+
+    if (currentController() != nullptr) {
+        result.insert(QStringLiteral("subtitles"), jsonArrayFromVariantList(currentController()->subtitlesList()));
+    }
+    if (subtitleModel) {
+        result.insert(QStringLiteral("subtitles_count"), subtitleModel->count());
+    }
+
+    return GatewayProtocol::successResponse(
+        QStringLiteral("get_project_state"),
+        requestId,
+        projectId(),
+        timelineRevision(),
+        result
+    );
+}
