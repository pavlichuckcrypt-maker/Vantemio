+QString GatewayService::handleQtSetProperty(const QString &requestId, const QJsonObject &params)
+{
+    QObject *o = gw_resolveObject(params.value(QStringLiteral("id")).toString());
+    const QString prop = params.value(QStringLiteral("property")).toString();
+    if (o == nullptr || prop.isEmpty()) {
+        return GatewayProtocol::errorResponse(QStringLiteral("qt_set_property"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("object_not_found"), QStringLiteral("qt_set_property requires a valid id and property."));
+    }
+    const bool applied = o->setProperty(prop.toUtf8().constData(), gw_jsonToVariant(params.value(QStringLiteral("value"))));
+    // setProperty=false ⇒ свойство не существует/не writable/тип не подошёл. Раньше это
+    // отдавалось как status:ok (applied:false) — мозг считал изменение выполненным. Теперь
+    // честная ошибка, и ревизию НЕ бампаем при неудаче.
+    if (!applied) {
+        return GatewayProtocol::errorResponse(QStringLiteral("qt_set_property"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("property_not_applied"),
+            QStringLiteral("Свойство не задано (нет такого / не writable / несовместимый тип): ") + prop);
+    }
+    ++m_timelineRevision;
+    return GatewayProtocol::successResponse(QStringLiteral("qt_set_property"), requestId, projectId(), timelineRevision(),
+        QJsonObject{{QStringLiteral("property"), prop}, {QStringLiteral("applied"), applied}, {QStringLiteral("value_now"), gw_variantToJson(o->property(prop.toUtf8().constData()))}});
+}
