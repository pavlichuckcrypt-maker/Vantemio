+// set_volume_keyframes — громкость по ключевым кадрам (фейды/дакинг вручную).
+// keyframes: [{frame, db}] → строка "frame=db;...". level в дБ (0 = без изменений).
+QString GatewayService::handleSetVolumeKeyframes(const QString &requestId, const QJsonObject &params)
+{
+    const int clipId = params.value(QStringLiteral("clip_id")).toInt(-1);
+    auto tl = currentTimelineModel();
+    if (!tl || !tl->isClip(clipId)) {
+        return GatewayProtocol::errorResponse(QStringLiteral("set_volume_keyframes"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("clip_not_found"), QStringLiteral("Нет клипа с таким clip_id."));
+    }
+    const QJsonArray kfs = params.value(QStringLiteral("keyframes")).toArray();
+    if (kfs.isEmpty()) {
+        return GatewayProtocol::errorResponse(QStringLiteral("set_volume_keyframes"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("empty_keyframes"), QStringLiteral("keyframes:[{frame,db}] обязателен."));
+    }
+    QStringList parts;
+    for (const QJsonValue &kv : kfs) {
+        const QJsonObject k = kv.toObject();
+        parts << QStringLiteral("%1=%2").arg(k.value(QStringLiteral("frame")).toInt()).arg(k.value(QStringLiteral("db")).toDouble());
+    }
+    const int row = gw_addEffectWithParams(clipId, QStringLiteral("volume"), {{QStringLiteral("level"), parts.join(QLatin1Char(';'))}});
+    if (row < 0) {
+        return GatewayProtocol::errorResponse(QStringLiteral("set_volume_keyframes"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("volume_failed"), QStringLiteral("Не удалось применить громкость."));
+    }
+    return GatewayProtocol::successResponse(QStringLiteral("set_volume_keyframes"), requestId, projectId(), timelineRevision(),
+        QJsonObject{{QStringLiteral("clip_id"), clipId}, {QStringLiteral("effect_row"), row}, {QStringLiteral("level"), parts.join(QLatin1Char(';'))}});
+}
