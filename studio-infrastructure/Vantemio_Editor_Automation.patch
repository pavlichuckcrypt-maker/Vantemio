+// get_thumbnail_strip — контактный лист: N кадров → одна картинка-грид (через PIL).
+QString GatewayService::handleThumbnailStrip(const QString &requestId, const QJsonObject &params)
+{
+    auto tl = currentTimelineModel();
+    if (!tl) {
+        return GatewayProtocol::errorResponse(QStringLiteral("get_thumbnail_strip"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("timeline_unavailable"), QStringLiteral("Active timeline is not available."));
+    }
+    const double fps = m_core ? m_core->getCurrentFps() : 25.0;
+    int projEnd = 0;
+    for (int trackId : tl->getTracksIds(false)) {
+        for (int it : tl->getItemsInRange(trackId, 0, -1, false)) if (tl->isClip(it)) projEnd = qMax(projEnd, tl->getClipPosition(it) + tl->getClipPlaytime(it));
+    }
+    const int inF = params.contains(QStringLiteral("in")) ? params.value(QStringLiteral("in")).toInt() : 0;
+    const int outF = params.contains(QStringLiteral("out")) ? params.value(QStringLiteral("out")).toInt() : projEnd;
+    int count = params.value(QStringLiteral("count")).toInt(6);
+    if (count < 1) count = 1; if (count > 24) count = 24;
+    const QString dir = params.value(QStringLiteral("dir")).toString().isEmpty() ? QDir::tempPath() : params.value(QStringLiteral("dir")).toString();
+    QStringList framePaths;
+    for (int i = 0; i < count; ++i) {
+        const int f = (count == 1) ? inF : inF + (outF - inF) * i / (count - 1);
+        const QString p = QStringLiteral("%1/vidra_ts_%2_%3.png").arg(dir).arg(f).arg(timelineRevision());
+        if (gw_captureFrame(f, p)) framePaths << p;
+    }
+    if (framePaths.isEmpty()) {
+        return GatewayProtocol::errorResponse(QStringLiteral("get_thumbnail_strip"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("no_frames"), QStringLiteral("Не удалось снять кадры."));
+    }
+    const QString strip = QStringLiteral("%1/vidra_strip_%2.png").arg(dir).arg(timelineRevision());
+    const int cols = qMin(framePaths.size(), 4);
+    const QByteArray envScript = qgetenv("VIDRA_STRIP_SCRIPT");
+    const QString script = !envScript.isEmpty() ? QString::fromUtf8(envScript) : QDir::homePath() + QStringLiteral("/AIMmontag/vidra_strip.py");
+    QStringList args{script, strip, QString::number(cols)};
+    args.append(framePaths);
+    QProcess p;
+    p.start(QStringLiteral("/usr/bin/python3"), args);
+    waitProcessPumped(p, 20000, QStringLiteral("get_thumbnail_strip"));
+    return GatewayProtocol::successResponse(QStringLiteral("get_thumbnail_strip"), requestId, projectId(), timelineRevision(),
+        QJsonObject{{QStringLiteral("strip"), strip}, {QStringLiteral("count"), framePaths.size()}, {QStringLiteral("cols"), cols},
+                    {QStringLiteral("exists"), QFileInfo::exists(strip)}});
+}
