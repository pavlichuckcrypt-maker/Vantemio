+        QJsonObject{{QStringLiteral("composition_id"), id}, {QStringLiteral("track_id"), trackId},
+                    {QStringLiteral("position"), pos}, {QStringLiteral("duration"), length}, {QStringLiteral("transition_name"), name}});
