+// ============================================================================
+// Новшества: навигация, числовой анализ кадра, черновой рендер.
+// ============================================================================
+// ============================================================================
+// Push-события: подписка сокета + рассылка (мозг получает render.started/finished
+// и др. без опроса, в реальном времени).
+// ============================================================================
+void GatewayService::pushEvent(const QJsonObject &event)
+{
+    if (m_subscribers.isEmpty()) {
+        return;
+    }
+    const QByteArray line = QJsonDocument(event).toJson(QJsonDocument::Compact) + "\n";
+    const QSet<QTcpSocket *> snapshot = m_subscribers;
+    for (QTcpSocket *s : snapshot) {
+        if (s != nullptr && s->state() == QAbstractSocket::ConnectedState) {
+            s->write(line);
+            s->flush();
+        }
+    }
+}
