+QString GatewayService::handleInvokeUiMethod(const QString &requestId, const QString &target, const QString &methodName, const QJsonArray &args)
+{
+    if (methodName.trimmed().isEmpty()) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("invoke_ui_method"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("invalid_parameters"),
+            QStringLiteral("invoke_ui_method requires a valid target and method_name.")
+        );
+    }
+    if (!args.isEmpty()) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("invoke_ui_method"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("invalid_arguments"),
+            QStringLiteral("Arguments do not match a supported UI method signature.")
+        );
+    }
+
+    if (target != QStringLiteral("mainwindow")) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("invoke_ui_method"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("method_not_found"),
+            QStringLiteral("No supported public UI method matched the requested name/signature.")
+        );
+    }
+
+    MainWindow *window = m_core != nullptr ? m_core->window() : nullptr;
+    if (window == nullptr) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("invoke_ui_method"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("invalid_parameters"),
+            QStringLiteral("invoke_ui_method requires a valid target and method_name.")
+        );
+    }
+
+    const QByteArray signature = methodName.toUtf8() + "()";
+    if (methodName != QStringLiteral("slotSwitchMarkersComments") && methodName != QStringLiteral("slotSwitchSnap")) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("invoke_ui_method"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("method_not_found"),
+            QStringLiteral("No supported public UI method matched the requested name/signature.")
+        );
+    }
+
+    const QByteArray methodNameUtf8 = methodName.toUtf8();
+    if (!QMetaObject::invokeMethod(window, methodNameUtf8.constData(), Qt::DirectConnection)) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("invoke_ui_method"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("method_invoke_failed"),
+            QStringLiteral("Qt failed to invoke the requested UI method.")
+        );
+    }
+
+    ++m_timelineRevision;
+    return GatewayProtocol::successResponse(
+        QStringLiteral("invoke_ui_method"),
+        requestId,
+        projectId(),
+        timelineRevision(),
+        QJsonObject{
+            {QStringLiteral("target"), target},
+            {QStringLiteral("method_name"), methodName},
+            {QStringLiteral("signature"), QString::fromUtf8(signature)},
+            {QStringLiteral("args"), args}
+        }
+    );
+}
