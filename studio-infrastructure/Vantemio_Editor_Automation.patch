+// auto_montage — раскладка клипов под ОБЩУЮ длительность (равные доли). Тонкая
+// надстройка над insert_sequence: считает duration_frames на клип и делегирует.
+QString GatewayService::handleAutoMontage(const QString &requestId, const QJsonObject &params)
+{
+    const QJsonArray clips = params.value(QStringLiteral("clip_paths")).toArray();
+    if (clips.isEmpty()) {
+        return GatewayProtocol::errorResponse(QStringLiteral("auto_montage"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("empty_clips"), QStringLiteral("auto_montage требует clip_paths:[...]."));
+    }
+    const double fps = m_core ? m_core->getCurrentFps() : 25.0;
+    int totalFrames = params.value(QStringLiteral("total_frames")).toInt(-1);
+    if (totalFrames <= 0) {
+        const double secs = params.value(QStringLiteral("total_seconds")).toDouble(0);
+        totalFrames = secs > 0 ? int(secs * fps) : int(clips.size() * 3 * fps); // дефолт 3с/клип
+    }
+    const int per = qMax(1, totalFrames / clips.size());
+    QJsonArray items;
+    for (const QJsonValue &c : clips) {
+        items.append(QJsonObject{{QStringLiteral("clip_path"), c.toString()}, {QStringLiteral("duration_frames"), per}});
+    }
+    QJsonObject seqParams{
+        {QStringLiteral("track_id"), params.value(QStringLiteral("track_id"))},
+        {QStringLiteral("start_position"), params.value(QStringLiteral("start_position")).toInt(0)},
+        {QStringLiteral("items"), items},
+    };
+    return handleInsertSequence(requestId, seqParams);
+}
