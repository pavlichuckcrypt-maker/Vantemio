+QString GatewayService::handleQtListProperties(const QString &requestId, const QJsonObject &params) const
+{
+    const QString id = params.value(QStringLiteral("id")).toString();
+    QObject *o = gw_resolveObject(id);
+    if (o == nullptr) {
+        return GatewayProtocol::errorResponse(QStringLiteral("qt_list_properties"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("object_not_found"), QStringLiteral("No Qt object matched the requested id."));
+    }
+    QJsonArray arr;
+    const QMetaObject *mo = o->metaObject();
+    for (int i = 0; i < mo->propertyCount(); ++i) {
+        const QMetaProperty p = mo->property(i);
+        arr.append(QJsonObject{
+            {QStringLiteral("name"), QString::fromUtf8(p.name())},
+            {QStringLiteral("type"), QString::fromUtf8(p.typeName())},
+            {QStringLiteral("writable"), p.isWritable()},
+            {QStringLiteral("value"), gw_variantToJson(p.read(o))},
+        });
+    }
+    const QList<QByteArray> dyn = o->dynamicPropertyNames();
+    for (const QByteArray &n : dyn) {
+        arr.append(QJsonObject{
+            {QStringLiteral("name"), QString::fromUtf8(n)},
+            {QStringLiteral("dynamic"), true},
+            {QStringLiteral("value"), gw_variantToJson(o->property(n.constData()))},
+        });
+    }
+    return GatewayProtocol::successResponse(QStringLiteral("qt_list_properties"), requestId, projectId(), timelineRevision(),
+        QJsonObject{{QStringLiteral("id"), id}, {QStringLiteral("class"), QString::fromUtf8(mo->className())}, {QStringLiteral("count"), arr.size()}, {QStringLiteral("properties"), arr}});
+}
