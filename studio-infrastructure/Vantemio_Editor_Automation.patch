+// detach_audio — отцепить звук клипа на отдельную аудиодорожку.
+QString GatewayService::handleDetachAudio(const QString &requestId, const QJsonObject &params)
+{
+    auto tl = currentTimelineModel();
+    const int clipId = params.value(QStringLiteral("clip_id")).toInt(-1);
+    if (!tl || !tl->isClip(clipId)) {
+        return GatewayProtocol::errorResponse(QStringLiteral("detach_audio"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("clip_not_found"), QStringLiteral("Нет клипа с таким clip_id."));
+    }
+    const QList<int> aud = tl->getTracksIds(true);
+    QList<int> targets;
+    const int wanted = params.value(QStringLiteral("audio_track_id")).toInt(-1);
+    if (tl->isTrack(wanted)) targets.append(wanted);
+    else if (!aud.isEmpty()) targets.append(aud.constFirst());
+    const bool ok = TimelineFunctions::requestSplitAudio(tl, clipId, targets);
+    if (!ok) {
+        return GatewayProtocol::errorResponse(QStringLiteral("detach_audio"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("detach_failed"), QStringLiteral("Не удалось отцепить звук (есть ли аудиодорожка?)."));
+    }
+    ++m_timelineRevision;
+    return GatewayProtocol::successResponse(QStringLiteral("detach_audio"), requestId, projectId(), timelineRevision(),
+        QJsonObject{{QStringLiteral("clip_id"), clipId}, {QStringLiteral("audio_tracks"), jsonArrayFromIntSet(std::unordered_set<int>(targets.begin(), targets.end()))}});
+}
