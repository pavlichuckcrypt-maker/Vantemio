+QString GatewayService::handleAddTrack(const QString &requestId, const QJsonObject &params)
+{
+    auto tl = currentTimelineModel();
+    if (!tl) {
+        return GatewayProtocol::errorResponse(QStringLiteral("add_track"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("timeline_unavailable"), QStringLiteral("Active timeline is not available."));
+    }
+    const bool audio = params.value(QStringLiteral("audio")).toBool(false);
+    const QString name = params.value(QStringLiteral("name")).toString();
+    // позиция вставки: по умолчанию наверх (макс. позиция)
+    int pos = params.contains(QStringLiteral("position"))
+        ? params.value(QStringLiteral("position")).toInt()
+        : int(tl->getTracksIds(false).size() + tl->getTracksIds(true).size());
+    int newId = -1;
+    const bool ok = tl->requestTrackInsertion(pos, newId, name, audio);
+    if (!ok || newId < 0) {
+        return GatewayProtocol::errorResponse(QStringLiteral("add_track"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("add_track_failed"), QStringLiteral("Не удалось добавить трек."));
+    }
+    ++m_timelineRevision;
+    return GatewayProtocol::successResponse(QStringLiteral("add_track"), requestId, projectId(), timelineRevision(),
+        QJsonObject{{QStringLiteral("track_id"), newId}, {QStringLiteral("audio"), audio}, {QStringLiteral("position"), pos}});
+}
