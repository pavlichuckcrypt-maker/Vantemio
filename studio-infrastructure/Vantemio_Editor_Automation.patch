+// ============================================================================
+// ДЕКЛАРАТИВНЫЙ МОНТАЖ: мозг отдаёт ОДИН JSON-план — gateway всё строит.
+// НЕ шаблон: каждое значение задаёт мозг, у каждого клипа может быть своё.
+// ============================================================================
+
+// Применить полную спецификацию к одному клипу (длительность, эффекты с зонами,
+// look, ken_burns, title). Переиспользуется apply_clip_spec и build_montage.
+QJsonObject GatewayService::gw_applyClipSpec(int clipId, const QJsonObject &spec)
+{
+    auto tl = currentTimelineModel();
+    QJsonObject applied;
+    if (!tl || !tl->isClip(clipId)) {
+        return QJsonObject{{QStringLiteral("error"), QStringLiteral("clip_not_found")}};
+    }
+    const double fps = m_core ? m_core->getCurrentFps() : 25.0;
+    if (spec.contains(QStringLiteral("duration_frames"))) {
+        const int d = spec.value(QStringLiteral("duration_frames")).toInt();
+        if (d > 0) { tl->requestItemResize(clipId, d, true, true); applied.insert(QStringLiteral("duration"), d); }
+    } else if (spec.contains(QStringLiteral("duration"))) {
+        // "duration" — секунды (a не duration_frames), как в build_montage clips[]. Конвертируем во fps проекта.
+        const double seconds = spec.value(QStringLiteral("duration")).toDouble();
+        const int d = qRound(seconds * fps);
+        if (d > 0) { tl->requestItemResize(clipId, d, true, true); applied.insert(QStringLiteral("duration"), d); }
+    }
+    QJsonArray effRes;
+    for (const QJsonValue &ev : spec.value(QStringLiteral("effects")).toArray()) {
+        const QJsonObject e = ev.toObject();
+        const QString name = e.value(QStringLiteral("name")).toString();
+        if (!EffectsRepository::get()->exists(name)) { effRes.append(QJsonObject{{QStringLiteral("name"), name}, {QStringLiteral("ok"), false}}); continue; }
+        QList<QPair<QString, QString>> kv;
+        const QJsonObject po = e.value(QStringLiteral("params")).toObject();
+        for (auto it = po.constBegin(); it != po.constEnd(); ++it) {
+            kv.append({it.key(), it.value().isString() ? it.value().toString() : QString::number(it.value().toDouble())});
+        }
+        const QJsonArray zones = e.value(QStringLiteral("zones")).toArray();
+        if (zones.isEmpty()) {
+            const int row = gw_addEffectWithParams(clipId, name, kv);
+            effRes.append(QJsonObject{{QStringLiteral("name"), name}, {QStringLiteral("row"), row}});
+        } else {
+            for (const QJsonValue &zv : zones) {
+                const QJsonObject z = zv.toObject();
+                const int in = z.contains(QStringLiteral("in")) ? z.value(QStringLiteral("in")).toInt() : int(z.value(QStringLiteral("start_sec")).toDouble() * fps);
+                const int out = z.contains(QStringLiteral("out")) ? z.value(QStringLiteral("out")).toInt() : int(z.value(QStringLiteral("end_sec")).toDouble() * fps);
+                const int row = gw_addEffectWithParams(clipId, name, kv);
+                if (row >= 0) {
+                    std::shared_ptr<EffectStackModel> stack = tl->getClipEffectStackModel(clipId);
+                    std::shared_ptr<EffectItemModel> eff = gw_safeEffectRow(stack, row);
+                    if (eff) eff->setInOut(name, qMakePair(in, out), true, true);
+                }
+                effRes.append(QJsonObject{{QStringLiteral("name"), name}, {QStringLiteral("row"), row}, {QStringLiteral("in"), in}, {QStringLiteral("out"), out}});
+            }
+        }
+    }
+    if (!effRes.isEmpty()) applied.insert(QStringLiteral("effects"), effRes);
+    if (spec.contains(QStringLiteral("look"))) {
+        handleApplyLook(QStringLiteral("spec"), QJsonObject{{QStringLiteral("clip_id"), clipId}, {QStringLiteral("look"), spec.value(QStringLiteral("look"))}});
+        applied.insert(QStringLiteral("look"), spec.value(QStringLiteral("look")));
+    }
+    if (spec.contains(QStringLiteral("ken_burns"))) {
+        QJsonObject kb = spec.value(QStringLiteral("ken_burns")).toObject();
+        kb.insert(QStringLiteral("clip_id"), clipId);
+        handleKenBurns(QStringLiteral("spec"), kb);
+        applied.insert(QStringLiteral("ken_burns"), true);
+    }
+    if (spec.contains(QStringLiteral("title"))) {
+        QJsonObject ti = spec.value(QStringLiteral("title")).toObject();
+        ti.insert(QStringLiteral("clip_id"), clipId);
+        handleAddTitle(QStringLiteral("spec"), ti);
+        applied.insert(QStringLiteral("title"), true);
+    }
+    ++m_timelineRevision;
+    return applied;
+}
+
+QString GatewayService::handleApplyClipSpec(const QString &requestId, const QJsonObject &params)
+{
+    auto tl = currentTimelineModel();
+    const int clipId = params.value(QStringLiteral("clip_id")).toInt(-1);
+    if (!tl || !tl->isClip(clipId)) {
+        return GatewayProtocol::errorResponse(QStringLiteral("apply_clip_spec"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("clip_not_found"), QStringLiteral("Нет клипа с таким clip_id."));
+    }
+    const QJsonObject applied = gw_applyClipSpec(clipId, params.value(QStringLiteral("spec")).toObject());
+    return GatewayProtocol::successResponse(QStringLiteral("apply_clip_spec"), requestId, projectId(), timelineRevision(),
+        QJsonObject{{QStringLiteral("clip_id"), clipId}, {QStringLiteral("applied"), applied}});
+}
+
+// build_montage — собрать весь монтаж из ОДНОГО плана. Асинхронно → montage.done.
+// params: { create_project?, profile?, track_id?, clips:[{clip_path, duration_frames?|duration?,
+//   in_sec?|in_frames? (in-point: с какого места продюсера начать кусок),
+//   effects?, look?, ken_burns?, title?}], transitions:[{position, transition_name, duration}],
+//   transition? (имя, применяется между КАЖДОЙ парой соседних клипов), transition_duration? (сек, по умолч. 1.0),
+//   output? (если задан — рендер по завершении) }
+// ВАЖНО: одна неудача с клипом (файл не найден/импорт не удался/вставка не удалась) НЕ прерывает
+// сборку остальных клипов плана — клип пропускается, ошибка копится в "failed", итог всё равно
+// montage.done (если собран хотя бы один клип). Полный провал (0 клипов) → montage.failed.
+QString GatewayService::handleBuildMontage(const QString &requestId, const QJsonObject &params)
+{
+    const QJsonArray clips = params.value(QStringLiteral("clips")).toArray();
+    if (clips.isEmpty()) {
+        return GatewayProtocol::errorResponse(QStringLiteral("build_montage"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("empty_clips"), QStringLiteral("build_montage требует clips:[{clip_path,...}]."));
+    }
+    const QString rid = requestId;
+    const QJsonObject p = params;
+    m_buildMontageBusy = true;
+    enqueueJob([this, p, clips, rid]() {
+        QString errCode;
+        // 1) при необходимости — новый проект
+        if (p.value(QStringLiteral("create_project")).toBool(false)) {
+            if (m_core->currentDoc()) m_core->currentDoc()->setModified(false);
+            const QString prof = p.value(QStringLiteral("profile")).toString();
+            if (prof.isEmpty()) m_core->projectManager()->newFile(false);
+            else m_core->projectManager()->newFile(prof, false);
+            QElapsedTimer w; w.start();
+            while (m_core->currentDoc() == nullptr && w.elapsed() < 10000) QCoreApplication::processEvents(QEventLoop::ExcludeSocketNotifiers,50);
+            // #9 ФИКС (перемежающийся краш build_montage{create_project}): newFile() ПЕРЕСОЗДАЁТ
+            // таймлайн/модели асинхронно — currentDoc()!=nullptr НЕ значит, что таймлайн-модель
+            // достроена. Прежде код сразу шёл в пре-прогрев бина и requestClipInsertion по
+            // ПОЛУПОСТРОЕННОЙ модели → гонка/краш (без дампа). Теперь ждём готовности треков —
+            // ТОТ ЖЕ проверенный механизм, что и в стабильном standalone create_project
+            // (getTracksCount()>0, до 8с). Если так и не готово — НЕ трогаем модель, а честно
+            // валим montage.failed вместо падения (executor/watchdog это переживут).
+            QElapsedTimer tt; tt.start();
+            bool tlReady = false;
+            while (tt.elapsed() < 8000) {
+                auto m = currentTimelineModel();
+                if (m && m->getTracksCount() > 0) { tlReady = true; break; }
+                QCoreApplication::processEvents(QEventLoop::ExcludeSocketNotifiers,50);
+            }
+            if (!tlReady) {
+                m_buildMontageBusy = false;
+                pushEvent(QJsonObject{{QStringLiteral("kind"), QStringLiteral("event")}, {QStringLiteral("request_id"), rid},
+                                      {QStringLiteral("event"), QStringLiteral("montage.failed")},
+                                      {QStringLiteral("error"), QStringLiteral("create_project_timeline_not_ready")},
+                                      {QStringLiteral("error_detail"), QStringLiteral("Таймлайн-модель не получила треки за 8с после newFile() — сборка прервана до обращения к полупостроенной модели.")}});
+                return;
+            }
+        }
+        auto tl = currentTimelineModel();
+        // 2) дорожка: заданная или первая видео
+        int trackId = p.value(QStringLiteral("track_id")).toInt(-1);
+        if (tl && !tl->isTrack(trackId)) {
+            const QList<int> v = tl->getTracksIds(false);
+            trackId = v.isEmpty() ? -1 : v.constFirst();
+        }
+        QJsonArray builtClips;
+        QJsonArray failedClips;
+        QList<int> insertedClipIds; // для расстановки переходов между соседними успешными клипами
+        int pos = p.value(QStringLiteral("start_position")).toInt(0);
+        // Общий бюджет ожидания готовности продюсеров на весь план (не даём одному
+        // зависшему клипу съесть ping-доступность гейтвея на N*20с — см. ниже).
+        QElapsedTimer batchTimer; batchTimer.start();
+        // Бюджеты ожидания готовности продюсеров — настраиваемы (холодный SMB-кэш требует больше).
+        const qint64 batchReadyBudgetMs = qMax<qint64>(5000, p.value(QStringLiteral("ready_budget_ms")).toInt(45000));
+        const qint64 perClipCapMax = qMax<qint64>(1000, p.value(QStringLiteral("per_clip_ready_ms")).toInt(8000));
+        if (tl && trackId >= 0) {
+            // ПРЕ-ПРОГРЕВ БИНА: заранее запускаем импорт ВСЕХ клипов без ожидания, чтобы
+            // продюсеры строились параллельно (особенно с холодного SMB-тома). К основному
+            // циклу большинство уже готово → на порядок меньше clip_not_ready на первом прогоне.
+            for (const QJsonValue &cv : clips) {
+                const QString wp = cv.toObject().value(QStringLiteral("clip_path")).toString();
+                const QFileInfo wf(wp);
+                if (!wf.exists()) continue;
+                if (!m_core->projectItemModel()->getClipByUrl(wf).isEmpty()) continue;
+                Fun u = []() { return true; }; Fun r = []() { return true; };
+                const auto root = m_core->projectItemModel()->getRootFolder();
+                const QString rootId = root ? root->clipId() : QStringLiteral("-1");
+                const std::function<void(const QString &)> cb = [](const QString &) {};
+                const QString nid = ClipCreator::createClipFromFile(wf.absoluteFilePath(), rootId, m_core->projectItemModel(), u, r, cb, false);
+                if (nid != QStringLiteral("-1") && !nid.isEmpty()) m_core->pushUndo(u, r, QStringLiteral("Warmup clip (montage)"));
+            }
+            for (const QJsonValue &cv : clips) {
+                const QJsonObject spec = cv.toObject();
+                const QString clipPath = spec.value(QStringLiteral("clip_path")).toString();
+                const QFileInfo f(clipPath);
+                if (!f.exists()) {
+                    failedClips.append(QJsonObject{{QStringLiteral("clip_path"), clipPath}, {QStringLiteral("error"), QStringLiteral("file_not_found")}});
+                    continue;
+                }
+                QStringList binIds = m_core->projectItemModel()->getClipByUrl(f);
+                if (binIds.isEmpty()) {
+                    Fun undo = []() { return true; }; Fun redo = []() { return true; };
+                    const auto root = m_core->projectItemModel()->getRootFolder();
+                    const QString rootId = root ? root->clipId() : QStringLiteral("-1");
+                    const std::function<void(const QString &)> cb = [](const QString &) {};
+                    const QString newId = ClipCreator::createClipFromFile(f.absoluteFilePath(), rootId, m_core->projectItemModel(), undo, redo, cb, false);
+                    if (newId != QStringLiteral("-1") && !newId.isEmpty()) { m_core->pushUndo(undo, redo, QStringLiteral("Add clip (montage)")); binIds = QStringList{newId}; }
+                }
+                if (binIds.isEmpty()) {
+                    failedClips.append(QJsonObject{{QStringLiteral("clip_path"), clipPath}, {QStringLiteral("error"), QStringLiteral("bin_import_failed")}});
+                    continue;
+                }
+                const QString binId = binIds.constFirst();
+                auto clip = m_core->projectItemModel()->getClipByBinID(binId);
+                // Ждём готовности продюсера неблокирующе, но ограничено оставшимся бюджетом всего
+                // плана — иначе несколько тяжёлых/битых клипов подряд держат processEvents(ExcludeSocketNotifiers)
+                // так долго, что гейтвей перестаёт видеть новые TCP-данные (в т.ч. ping) на всё это время.
+                QElapsedTimer rdy; rdy.start();
+                const qint64 remainingBudget = qMax<qint64>(0, batchReadyBudgetMs - batchTimer.elapsed());
+                const qint64 perClipCap = qMin<qint64>(perClipCapMax, remainingBudget);
+                // 28.07 ФИКС (картинки не вставали НИКОГДА): clip нужно ПЕРЕЧИТЫВАТЬ по binId на
+                // каждой итерации — тот же фикс, что давно стоит в handleInsertClip. Модель
+                // пересоздаёт ProjectClip при смене продюсера (для Image это происходит всегда:
+                // после загрузки клипу проставляется длительность из image_duration), и разово
+                // взятый shared_ptr держит МЁРТВЫЙ объект, чей statusReady() уже не изменится —
+                // отсюда вечный clip_not_ready на PNG при любом бюджете (проверено 8с/30с/120с),
+                // тогда как видео (продюсер не пересоздаётся) ложилось всегда.
+                while (clip && !clip->statusReady() && rdy.elapsed() < perClipCap) {
+                    QCoreApplication::processEvents(QEventLoop::ExcludeSocketNotifiers,50);
+                    clip = m_core->projectItemModel()->getClipByBinID(binId);
+                }
+                if (clip && !clip->statusReady()) {
+                    failedClips.append(QJsonObject{{QStringLiteral("clip_path"), clipPath}, {QStringLiteral("error"), QStringLiteral("clip_not_ready")}});
+                    continue;
+                }
+                // IN-POINT: clips[].in_sec / in_frames — вставка не с 0-го кадра продюсера, а с выбранного
+                // мозгом момента. Используем штатный формат binId "id/in/out" — requestClipCreation сам
+                // режет клип по зоне (тот же путь, что drag зоны из монитора), никакого ручного resize.
+                const double fps = m_core ? m_core->getCurrentFps() : 25.0;
+                QString insertId = binId;
+                int inFrames = 0;
+                if (spec.contains(QStringLiteral("in_frames"))) inFrames = spec.value(QStringLiteral("in_frames")).toInt();
+                else if (spec.contains(QStringLiteral("in_sec"))) inFrames = qRound(spec.value(QStringLiteral("in_sec")).toDouble() * fps);
+                if (inFrames > 0 && clip) {
+                    const int total = int(clip->frameDuration());
+                    if (inFrames >= total) {
+                        failedClips.append(QJsonObject{{QStringLiteral("clip_path"), clipPath}, {QStringLiteral("error"), QStringLiteral("in_point_beyond_clip")},
+                                                       {QStringLiteral("in_frames"), inFrames}, {QStringLiteral("clip_frames"), total}});
+                        continue;
+                    }
+                    int outFrame = total - 1;
+                    if (spec.contains(QStringLiteral("duration_frames"))) outFrame = inFrames + spec.value(QStringLiteral("duration_frames")).toInt() - 1;
+                    else if (spec.contains(QStringLiteral("duration"))) outFrame = inFrames + qRound(spec.value(QStringLiteral("duration")).toDouble() * fps) - 1;
+                    outFrame = qBound(inFrames, outFrame, total - 1);
+                    insertId = QStringLiteral("%1/%2/%3").arg(binId).arg(inFrames).arg(outFrame);
+                }
+                int clipId = -1;
+                if (!tl->requestClipInsertion(insertId, trackId, pos, clipId, true, true, false) || clipId < 0) {
+                    failedClips.append(QJsonObject{{QStringLiteral("clip_path"), clipPath}, {QStringLiteral("error"), QStringLiteral("insert_failed")}});
+                    continue;
+                }
+                // применить спецификацию клипа (длительность/эффекты/look/ken_burns/title)
+                const QJsonObject applied = gw_applyClipSpec(clipId, spec);
+                const int dur = tl->getClipPlaytime(clipId);
+                builtClips.append(QJsonObject{{QStringLiteral("clip_id"), clipId}, {QStringLiteral("position"), pos}, {QStringLiteral("duration"), dur},
+                                              {QStringLiteral("in"), inFrames}, {QStringLiteral("applied"), applied}});
+                insertedClipIds.append(clipId);
+                // живой прогресс: событие на каждый собранный клип
+                pushEvent(QJsonObject{{QStringLiteral("kind"), QStringLiteral("event")}, {QStringLiteral("request_id"), rid},
+                                      {QStringLiteral("event"), QStringLiteral("montage.clip_done")},
+                                      {QStringLiteral("index"), builtClips.size() - 1}, {QStringLiteral("clip_id"), clipId}, {QStringLiteral("position"), pos}});
+                pos += dur;
+            }
+            // 3) переходы в заданных местах (явный список position/transition_name/duration)
+            for (const QJsonValue &tv : p.value(QStringLiteral("transitions")).toArray()) {
+                const QJsonObject t = tv.toObject();
+                const QString tn = t.value(QStringLiteral("transition_name")).toString();
+                if (!TransitionsRepository::get()->exists(tn)) continue;
+                int id = -1;
+                tl->requestCompositionInsertion(tn, trackId, t.value(QStringLiteral("position")).toInt(), t.value(QStringLiteral("duration")).toInt(25), std::unique_ptr<Mlt::Properties>(), id, true);
+            }
+            // 3b) короткая форма: transition (имя) + transition_duration (сек) — применяется между
+            // КАЖДОЙ парой соседних успешно вставленных клипов через тот же путь, что и apply_transition
+            // (controller->addCompositionToClip), который уже валидирует имя перехода ДО вставки и не
+            // требует ручного вычисления track/position — это устраняет зависание, которое давал прежний
+            // расчёт позиции вручную через requestCompositionInsertion с непроверенными параметрами.
+            const QString flatTransition = p.value(QStringLiteral("transition")).toString();
+            if (!flatTransition.isEmpty() && TransitionsRepository::get()->exists(flatTransition) && insertedClipIds.size() > 1) {
+                const double transSec = p.contains(QStringLiteral("transition_duration")) ? p.value(QStringLiteral("transition_duration")).toDouble(1.0) : 1.0;
+                const double fps = m_core ? m_core->getCurrentFps() : 25.0;
+                const int transFrames = qMax(1, qRound(transSec * fps));
+                auto controller = currentController();
+                if (controller) {
+                    for (int i = 1; i < insertedClipIds.size(); ++i) {
+                        const int leftClipId = insertedClipIds.at(i - 1);
+                        if (!tl->isClip(leftClipId)) continue;
+                        const int compositionId = controller->addCompositionToClip(flatTransition, leftClipId, 0);
+                        if (compositionId > 0 && transFrames > 0) {
+                            tl->requestItemResize(compositionId, transFrames, true, true);
+                        }
+                    }
+                }
+            }
+        } else {
+            errCode = QStringLiteral("no_track");
+        }
+        ++m_timelineRevision;
+        // 4) опциональный рендер (только если собран хотя бы один клип)
+        QString renderOut;
+        if (errCode.isEmpty() && !builtClips.isEmpty() && !p.value(QStringLiteral("output")).toString().isEmpty()) {
+            renderOut = p.value(QStringLiteral("output")).toString();
+            handleRenderMaster(QStringLiteral("montage"), renderOut, QStringLiteral("H.264 (libx264+aac)"), false);
+        }
+        QJsonObject ev{{QStringLiteral("kind"), QStringLiteral("event")}, {QStringLiteral("request_id"), rid}};
+        if (errCode.isEmpty() && !builtClips.isEmpty()) {
+            ev[QStringLiteral("event")] = QStringLiteral("montage.done");
+            ev[QStringLiteral("clips")] = builtClips;
+            ev[QStringLiteral("count")] = builtClips.size();
+            ev[QStringLiteral("end_position")] = pos;
+            if (!failedClips.isEmpty()) { ev[QStringLiteral("failed")] = failedClips; ev[QStringLiteral("failed_count")] = failedClips.size(); }
+            if (!renderOut.isEmpty()) ev[QStringLiteral("output")] = renderOut;
+        } else {
+            ev[QStringLiteral("event")] = QStringLiteral("montage.failed");
+            ev[QStringLiteral("error")] = errCode.isEmpty() ? QStringLiteral("all_clips_failed") : errCode;
+            ev[QStringLiteral("built")] = builtClips;
+            ev[QStringLiteral("failed")] = failedClips;
+        }
+        // Снять гейт реентрантности ДО pushEvent: как только подписчик получит
+        // montage.done/montage.failed, он вправе сразу слать следующую команду
+        // (save_project, следующий build_montage) — гейтвей должен быть готов её
+        // принять немедленно, а не оставаться "busy" ещё один цикл событий.
+        m_buildMontageBusy = false;
+        pushEvent(ev);
+    });
+    return GatewayProtocol::successResponse(QStringLiteral("build_montage"), requestId, projectId(), timelineRevision(),
+        // requested_clips = размер ЗАПРОСА (НЕ итог!). Реальный результат — в событии montage.done
+        // (поля clips[], count, failed[], failed_count). clips_count оставлен как алиас для совместимости.
+        QJsonObject{{QStringLiteral("status_detail"), QStringLiteral("pending")},
+                    {QStringLiteral("requested_clips"), clips.size()}, {QStringLiteral("clips_count"), clips.size()},
+                    {QStringLiteral("note"), QStringLiteral("Асинхронно. Итог НЕ здесь: subscribe_events → montage.done (clips[], count, failed[]) / montage.failed.")}});
+}
+
+// ============================================================================
+// ВСТРОЕННОЕ ОБНОВЛЕНИЕ: тонкая обёртка над ~/AIMmontag/vidra_update.sh.
+// check_update — читает манифест и сравнивает сборки; apply_update — скачивает
+// и применяет (приложение перезапустится). Та же логика за кнопкой меню.
+// ============================================================================
+static QString gw_updateScriptPath()
+{
+    const QByteArray env = qgetenv("VIDRA_UPDATE_SCRIPT");
+    if (!env.isEmpty()) {
+        return QString::fromUtf8(env);
+    }
+    return QDir::homePath() + QStringLiteral("/AIMmontag/vidra_update.sh");
+}
+
+QString GatewayService::handleCheckUpdate(const QString &requestId) const
+{
+    const QString script = gw_updateScriptPath();
+    if (!QFileInfo::exists(script)) {
+        return GatewayProtocol::errorResponse(QStringLiteral("check_update"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("updater_missing"), QStringLiteral("Скрипт обновления не найден: ") + script);
+    }
+    QProcess p;
+    p.start(QStringLiteral("/bin/zsh"), QStringList{script, QStringLiteral("check")});
+    if (!waitProcessPumped(p, 20000, QStringLiteral("check_update"))) {
+        return GatewayProtocol::errorResponse(QStringLiteral("check_update"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("check_timeout"), QStringLiteral("Проверка обновления не ответила вовремя."));
+    }
+    const QByteArray out = p.readAllStandardOutput().trimmed();
+    QJsonParseError err{};
+    const QJsonDocument doc = QJsonDocument::fromJson(out, &err);
+    QJsonObject result;
+    if (err.error == QJsonParseError::NoError && doc.isObject()) {
+        result = doc.object();
+    } else {
+        result = QJsonObject{{QStringLiteral("raw"), QString::fromUtf8(out)}};
+    }
+    return GatewayProtocol::successResponse(QStringLiteral("check_update"), requestId, projectId(), timelineRevision(), result);
+}
+
+QString GatewayService::handleApplyUpdate(const QString &requestId)
+{
+    const QString script = gw_updateScriptPath();
+    if (!QFileInfo::exists(script)) {
+        return GatewayProtocol::errorResponse(QStringLiteral("apply_update"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("updater_missing"), QStringLiteral("Скрипт обновления не найден: ") + script);
+    }
+    // Запускаем отдельно: скрипт скачает апдейт и породит detached swap-хелпер,
+    // который подождёт выхода приложения, заменит бандл, переподпишет и перезапустит.
+    const bool started = QProcess::startDetached(QStringLiteral("/bin/zsh"), QStringList{script, QStringLiteral("apply")});
+    if (!started) {
+        return GatewayProtocol::errorResponse(QStringLiteral("apply_update"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("apply_failed"), QStringLiteral("Не удалось запустить обновление."));
+    }
+    return GatewayProtocol::successResponse(QStringLiteral("apply_update"), requestId, projectId(), timelineRevision(),
+        QJsonObject{{QStringLiteral("status_detail"), QStringLiteral("applying")},
+                    {QStringLiteral("note"), QStringLiteral("Обновление запущено: скачивание → замена бандла → перезапуск. Gateway станет недоступен ~20-40с, затем поднимется новая версия. Сверь версию через check_update после перезапуска.")}});
+}
+
+QJsonObject GatewayService::gw_doInsertClip(const QString &absPath, int trackId, int position, const QString &rid)
+{
+    QString errCode;
+    int clipId = -1;
+    QString binId;
+    const QFileInfo f(absPath);
+    QStringList binIds = m_core->projectItemModel()->getClipByUrl(f);
+    if (binIds.isEmpty()) {
+        Fun undo = []() { return true; };
+        Fun redo = []() { return true; };
+        const auto root = m_core->projectItemModel()->getRootFolder();
+        const QString rootId = root ? root->clipId() : QStringLiteral("-1");
+        const std::function<void(const QString &)> cb = [](const QString &) {};
+        const QString newId = ClipCreator::createClipFromFile(absPath, rootId, m_core->projectItemModel(), undo, redo, cb, false);
+        if (newId != QStringLiteral("-1") && !newId.isEmpty()) {
+            m_core->pushUndo(undo, redo, QStringLiteral("Add clip (gateway)"));
+            binIds = QStringList{newId};
+        }
+    }
+    if (binIds.isEmpty()) {
+        errCode = QStringLiteral("bin_import_failed");
+    } else {
+        binId = binIds.constFirst();
+        // КЛЮЧ: дождаться готовности продюсера НЕблокирующе (statusReady через
+        // processEvents). Иначе requestClipInsertion→getFramePlaytime() виснет на
+        // condition_variable, ожидая продюсер, который строится в фоне → дедлок.
+        // Ждём готовности продюсера, ПЕРЕЧИТЫВАЯ клип по binId каждую итерацию:
+        // модель может пересоздать ProjectClip (реимпорт/смена продюсера), и разово
+        // взятый shared_ptr держал бы мёртвый объект → ложный clip_not_ready на весь таймаут.
+        QElapsedTimer rdy;
+        rdy.start();
+        auto clip = m_core->projectItemModel()->getClipByBinID(binId);
+        while (clip && !clip->statusReady() && rdy.elapsed() < 20000) {
+            QCoreApplication::processEvents(QEventLoop::ExcludeSocketNotifiers,50);
+            clip = m_core->projectItemModel()->getClipByBinID(binId);
+        }
+        if (clip && !clip->statusReady()) {
+            errCode = QStringLiteral("clip_not_ready");
+        } else {
+            auto tl = currentTimelineModel();
+            // Вставляем клип ЯВНО по виду целевого трека: префикс binClipId "V<id>"/"A<id>"
+            // задаёт ядру drop-тип VideoOnly/AudioOnly. Это обходит путь авто-AV-split, который
+            // для AV-клипа (и в headless-режиме) дёргает интерактивную promptAudioTrackCreation()
+            // и ронял вставку: AV-видео клало только аудио-зеркало, аудио-only падало вовсе.
+            // Соответствует модели «видео на видеодорожки, звук на аудиодорожки» раздельно.
+            QString dropBinId = binId;
+            if (tl && tl->isTrack(trackId)) {
+                dropBinId = (tl->isAudioTrack(trackId) ? QStringLiteral("A") : QStringLiteral("V")) + binId;
+            }
+            const bool inserted = tl && tl->requestClipInsertion(dropBinId, trackId, position, clipId, true, true, false);
+            // Доверяем НАБЛЮДАЕМОМУ состоянию, а не только булеву возврату: ядро может
+            // вернуть false при неудаче аудио-зеркала, УЖЕ поставив клип на трек.
+            // Но найденный по позиции клип засчитываем ТОЛЬКО если он из НАШЕГО bin-клипа —
+            // иначе вставка, упёршаяся в чужой клип, рапортовала «ok» с чужим clip_id
+            // (так терялись клипы «молча»: ответ ok, а вставки не было).
+            bool reallyThere = (clipId >= 0 && tl && tl->isClip(clipId));
+            if (!reallyThere && tl && tl->isTrack(trackId)) {
+                const int cid = tl->getClipByPosition(trackId, position);
+                if (cid >= 0 && tl->isClip(cid) && tl->getClipBinId(cid) == binId
+                    && tl->getClipPosition(cid) == position) {
+                    clipId = cid;
+                    reallyThere = true;
+                }
+            }
+            if (!reallyThere) {
+                errCode = QStringLiteral("clip_insertion_failed");
+            } else {
+                ++m_timelineRevision;
+            }
+            Q_UNUSED(inserted);
+        }
+    }
+    QJsonObject ev{
+        {QStringLiteral("kind"), QStringLiteral("event")},
+        {QStringLiteral("request_id"), rid},
+        {QStringLiteral("clip_path"), absPath},
+        {QStringLiteral("track_id"), trackId},
+        {QStringLiteral("position"), position},
+    };
+    if (errCode.isEmpty()) {
+        ev[QStringLiteral("event")] = QStringLiteral("clip.inserted");
+        ev[QStringLiteral("clip_id")] = clipId;
+        ev[QStringLiteral("bin_id")] = binId;
+    } else {
+        ev[QStringLiteral("event")] = QStringLiteral("clip.failed");
+        ev[QStringLiteral("error")] = errCode;
+    }
+    pushEvent(ev);
+    return ev;
+}
+
+QString GatewayService::handleInsertClip(const QString &requestId, const QString &clipPath, int trackId, int position, bool waitSync)
+{
+    auto timelineModel = currentTimelineModel();
+    if (!timelineModel) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("insert_clip"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("timeline_unavailable"),
+            QStringLiteral("Active timeline is not available.")
+        );
+    }
+    if (clipPath.trimmed().isEmpty() || trackId < 0 || position < 0) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("insert_clip"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("invalid_parameters"),
+            QStringLiteral("insert_clip requires clip_path, track_id and position.")
+        );
+    }
+
+    QFileInfo clipFile(clipPath);
+    if (!clipFile.exists() || !clipFile.isFile()) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("insert_clip"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("clip_not_found"),
+            QStringLiteral("Clip file does not exist.")
+        );
+    }
+
+    const QString absPath = clipFile.absoluteFilePath();
+    const QString rid = requestId;
+
+    // СИНХРОННЫЙ режим (wait:true) — вставка исполняется ЗДЕСЬ, ответ уходит ПОСЛЕ
+    // фактической мутации модели (никакого «ok до вставки»). Сначала FIFO: сливаем
+    // отложенные мутации очереди, затем вставляем. m_gwBusy на время операции отбивает
+    // мутирующие команды, доставленные рекурсивно во время pump ожидания продюсера.
+    if (waitSync) {
+        drainJobs(true);
+        const bool prevBusy = m_gwBusy;
+        const QString prevAction = m_gwBusyAction;
+        m_gwBusy = true;
+        m_gwBusyAction = QStringLiteral("insert_clip");
+        const QJsonObject ev = gw_doInsertClip(absPath, trackId, position, rid);
+        m_gwBusy = prevBusy;
+        m_gwBusyAction = prevAction;
+        if (ev.value(QStringLiteral("event")).toString() == QStringLiteral("clip.failed")) {
+            return GatewayProtocol::errorResponse(QStringLiteral("insert_clip"), requestId, projectId(), timelineRevision(),
+                ev.value(QStringLiteral("error")).toString(QStringLiteral("clip_insertion_failed")),
+                QStringLiteral("Вставка не удалась (см. error)."));
+        }
+        return GatewayProtocol::successResponse(QStringLiteral("insert_clip"), requestId, projectId(), timelineRevision(),
+            QJsonObject{{QStringLiteral("status_detail"), QStringLiteral("inserted")},
+                        {QStringLiteral("clip_id"), ev.value(QStringLiteral("clip_id"))},
+                        {QStringLiteral("bin_id"), ev.value(QStringLiteral("bin_id"))},
+                        {QStringLiteral("track_id"), trackId}, {QStringLiteral("position"), position}});
+    }
+
+    // АСИНХРОННО (wait:false): в единую очередь мутаций — исполнится строго по одному
+    // с верхнего уровня event loop (см. enqueueJob/drainJobs), результат push-событием
+    // clip.inserted / clip.failed. Gateway возвращает "pending" сразу.
+    enqueueJob([this, absPath, trackId, position, rid]() {
+        gw_doInsertClip(absPath, trackId, position, rid);
+    });
+
+    return GatewayProtocol::successResponse(
+        QStringLiteral("insert_clip"),
+        requestId,
+        projectId(),
+        timelineRevision(),
+        QJsonObject{
+            {QStringLiteral("status_detail"), QStringLiteral("pending")},
+            {QStringLiteral("clip_path"), absPath},
+            {QStringLiteral("track_id"), trackId},
+            {QStringLiteral("position"), position},
+            {QStringLiteral("note"), QStringLiteral("Импорт асинхронный. Подпишись (subscribe_events) и жди событие clip.inserted (с clip_id) или clip.failed.")}
+        }
+    );
+}
+
+// upscale — апскейл видео/AI-клипа (720p→1080p/4K) внешним vidra_upscale.py.
+// fast = ffmpeg lanczos (мгновенно), ai = Real-ESRGAN (медленно). Гейтвей остаётся живым (processEvents).
+QString GatewayService::handleUpscale(const QString &requestId, const QJsonObject &params)
+{
+    const QString inp = params.value(QStringLiteral("input_path")).toString();
+    const QString out = params.value(QStringLiteral("output_path")).toString();
+    const QString to  = params.value(QStringLiteral("to")).toString(QStringLiteral("1080"));
+    const QString mode= params.value(QStringLiteral("mode")).toString(QStringLiteral("fast"));
+    if (inp.trimmed().isEmpty() || out.trimmed().isEmpty()) {
+        return GatewayProtocol::errorResponse(QStringLiteral("upscale"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("invalid_parameters"), QStringLiteral("upscale требует input_path и output_path."));
+    }
+    if (!QFileInfo::exists(inp)) {
+        return GatewayProtocol::errorResponse(QStringLiteral("upscale"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("input_not_found"), QStringLiteral("Входной файл не найден: ") + inp);
+    }
+    const QString script = QDir::homePath() + QStringLiteral("/AIMmontag/vidra_upscale.py");
+    if (!QFileInfo::exists(script)) {
+        return GatewayProtocol::errorResponse(QStringLiteral("upscale"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("upscaler_missing"), QStringLiteral("Скрипт апскейла не найден: ") + script);
+    }
+    const QString py = (mode == QStringLiteral("ai"))
+        ? QDir::homePath() + QStringLiteral("/AIMmontag/tts_env/bin/python")
+        : QStringLiteral("/usr/bin/python3");
+    QProcess p;
+    p.start(py, QStringList{script, inp, out, QStringLiteral("--to"), to, QStringLiteral("--mode"), mode});
+    if (!p.waitForStarted(8000)) {
+        return GatewayProtocol::errorResponse(QStringLiteral("upscale"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("upscale_start_failed"), QStringLiteral("Не удалось запустить апскейл."));
+    }
+    const int cap = (mode == QStringLiteral("ai")) ? 1800000 : 180000;
+    QElapsedTimer t; t.start();
+    while (p.state() != QProcess::NotRunning && t.elapsed() < cap) {
+        QCoreApplication::processEvents(QEventLoop::ExcludeSocketNotifiers, 100);
+    }
+    if (p.state() != QProcess::NotRunning) {
+        p.kill(); p.waitForFinished(2000);
+        return GatewayProtocol::errorResponse(QStringLiteral("upscale"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("upscale_timeout"), QStringLiteral("Апскейл не завершился вовремя."));
+    }
+    if (!QFileInfo::exists(out) || QFileInfo(out).size() < 1000) {
+        const QString err = QString::fromUtf8(p.readAllStandardError()).right(200);
+        return GatewayProtocol::errorResponse(QStringLiteral("upscale"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("upscale_failed"), QStringLiteral("Апскейл не дал файл. ") + err);
+    }
+    return GatewayProtocol::successResponse(QStringLiteral("upscale"), requestId, projectId(), timelineRevision(),
+        QJsonObject{{QStringLiteral("status_detail"), QStringLiteral("upscaled")},
+                    {QStringLiteral("output_path"), out}, {QStringLiteral("to"), to}, {QStringLiteral("mode"), mode}});
+}
