+// inspect_motion — ДАТЧИК ДВИЖЕНИЯ: снимает N подряд идущих кадров (через step),
+// меряет пиксельную разницу между соседними (движется ли картинка) и скачки яркости
+// (мерцание). Возвращает вердикт frozen/flicker/low_motion/ok_motion. Мозг «чувствует»,
+// что кадр живой/не моргает/не застыл — закрывает дыру, из-за которой были «мигает/застыло».
+QString GatewayService::handleInspectMotion(const QString &requestId, const QJsonObject &params)
+{
+    auto tl = currentTimelineModel();
+    if (!tl) {
+        return GatewayProtocol::errorResponse(QStringLiteral("inspect_motion"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("timeline_unavailable"), QStringLiteral("Active timeline is not available."));
+    }
+    const double fps = m_core ? m_core->getCurrentFps() : 25.0;
+    int pos = params.contains(QStringLiteral("start_sec"))
+        ? int(params.value(QStringLiteral("start_sec")).toDouble() * fps)
+        : params.value(QStringLiteral("position")).toInt(0);
+    if (params.contains(QStringLiteral("clip_id"))) {
+        const int cid = params.value(QStringLiteral("clip_id")).toInt();
+        if (tl->isClip(cid)) pos = tl->getClipPosition(cid) + qMax(0, tl->getClipPlaytime(cid) / 6);
+    }
+    const int count = qBound(2, params.value(QStringLiteral("count")).toInt(6), 24);
+    const int step = qBound(1, params.value(QStringLiteral("step")).toInt(4), 120);
+    QJsonArray frames; QStringList paths;
+    for (int i = 0; i < count; ++i) {
+        const QString p = QDir::tempPath() + QStringLiteral("/vidra_motion_%1.png").arg(i);
+        const int f = pos + i * step;
+        gw_captureFrame(f, p);
+        QJsonObject a = gw_analyzeImage(p);
+        a.insert(QStringLiteral("frame"), f);
+        frames.append(a);
+        paths.append(p);
+    }
+    QJsonArray pairs; double maxPix = 0, sumPix = 0, maxBright = 0; int np = 0;
+    for (int i = 1; i < count; ++i) {
+        const double pd = gw_frameDiff(paths.at(i - 1), paths.at(i));
+        const double bd = qAbs(frames.at(i).toObject().value(QStringLiteral("brightness")).toDouble()
+                             - frames.at(i - 1).toObject().value(QStringLiteral("brightness")).toDouble());
+        if (pd >= 0) { maxPix = qMax(maxPix, pd); sumPix += pd; ++np; }
+        maxBright = qMax(maxBright, bd);
+        pairs.append(QJsonObject{
+            {QStringLiteral("from"), frames.at(i - 1).toObject().value(QStringLiteral("frame"))},
+            {QStringLiteral("to"), frames.at(i).toObject().value(QStringLiteral("frame"))},
+            {QStringLiteral("pixel_diff"), pd}, {QStringLiteral("bright_diff"), bd}});
+    }
+    const double avgPix = np ? sumPix / np : 0.0;
+    const bool frozen = maxPix < 0.004;
+    const bool flicker = maxBright > 0.10;
+    QString verdict = QStringLiteral("ok_motion");
+    QString hint = QStringLiteral("движение в норме");
+    if (frozen) { verdict = QStringLiteral("frozen"); hint = QStringLiteral("кадр не двигается (застыл) — добавь движение или убери длинный hold"); }
+    else if (flicker) { verdict = QStringLiteral("flicker"); hint = QStringLiteral("яркость скачет (мигает) — проверь fade-to-black/резкое появление панелей"); }
+    else if (avgPix < 0.012) { verdict = QStringLiteral("low_motion"); hint = QStringLiteral("движение слабое — можно усилить зум/пролёт"); }
+    return GatewayProtocol::successResponse(QStringLiteral("inspect_motion"), requestId, projectId(), timelineRevision(),
+        QJsonObject{
+            {QStringLiteral("position"), pos}, {QStringLiteral("count"), count}, {QStringLiteral("step"), step},
+            {QStringLiteral("frozen"), frozen}, {QStringLiteral("flicker"), flicker},
+            {QStringLiteral("motion_score"), avgPix}, {QStringLiteral("max_pixel_diff"), maxPix}, {QStringLiteral("max_bright_jump"), maxBright},
+            {QStringLiteral("verdict"), verdict}, {QStringLiteral("hint"), hint},
+            {QStringLiteral("frames"), frames}, {QStringLiteral("pairs"), pairs}});
+}
+
+// render_and_analyze — «сделал → увидел»: сэмплирует кадры участка + анализ + вердикт.
+QString GatewayService::handleRenderAndAnalyze(const QString &requestId, const QJsonObject &params)
+{
+    auto tl = currentTimelineModel();
+    if (!tl) {
+        return GatewayProtocol::errorResponse(QStringLiteral("render_and_analyze"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("timeline_unavailable"), QStringLiteral("Active timeline is not available."));
+    }
+    const double fps = m_core ? m_core->getCurrentFps() : 25.0;
+    int projEnd = 0;
+    for (int trackId : tl->getTracksIds(false)) {
+        for (int it : tl->getItemsInRange(trackId, 0, -1, false)) {
+            if (tl->isClip(it)) projEnd = qMax(projEnd, tl->getClipPosition(it) + tl->getClipPlaytime(it));
+        }
+    }
+    const int inF = params.contains(QStringLiteral("in")) ? params.value(QStringLiteral("in")).toInt()
+                  : (params.contains(QStringLiteral("start_sec")) ? int(params.value(QStringLiteral("start_sec")).toDouble() * fps) : 0);
+    const int outF = params.contains(QStringLiteral("out")) ? params.value(QStringLiteral("out")).toInt()
+                   : (params.contains(QStringLiteral("end_sec")) ? int(params.value(QStringLiteral("end_sec")).toDouble() * fps) : projEnd);
+    int samples = params.value(QStringLiteral("samples")).toInt(5);
+    if (samples < 1) samples = 1;
+    if (samples > 30) samples = 30;
+    const QString dir = params.value(QStringLiteral("dir")).toString().isEmpty() ? QDir::tempPath() : params.value(QStringLiteral("dir")).toString();
+    QJsonArray frames;
+    double sumB = 0, maxBlack = 0; int dark = 0;
+    for (int i = 0; i < samples; ++i) {
+        const int f = (samples == 1) ? inF : inF + (outF - inF) * i / (samples - 1);
+        const QString path = QStringLiteral("%1/vidra_ra_%2_%3.png").arg(dir).arg(f).arg(timelineRevision());
+        gw_captureFrame(f, path);
+        QJsonObject a = gw_analyzeImage(path);
+        a.insert(QStringLiteral("frame"), f);
+        a.insert(QStringLiteral("seconds"), f / fps);
+        frames.append(a);
+        sumB += a.value(QStringLiteral("brightness")).toDouble();
+        maxBlack = qMax(maxBlack, a.value(QStringLiteral("black_ratio")).toDouble());
+        if (a.value(QStringLiteral("verdict")).toString() == QStringLiteral("too_dark") || a.value(QStringLiteral("verdict")).toString() == QStringLiteral("mostly_black")) ++dark;
+    }
+    const double meanB = frames.isEmpty() ? 0 : sumB / frames.size();
+    QString verdict = QStringLiteral("ok");
+    if (dark > samples / 2) verdict = QStringLiteral("mostly_dark");
+    else if (meanB > 0.85) verdict = QStringLiteral("mostly_bright");
+    return GatewayProtocol::successResponse(QStringLiteral("render_and_analyze"), requestId, projectId(), timelineRevision(),
+        QJsonObject{{QStringLiteral("in"), inF}, {QStringLiteral("out"), outF}, {QStringLiteral("samples"), samples},
+                    {QStringLiteral("mean_brightness"), meanB}, {QStringLiteral("max_black_ratio"), maxBlack},
+                    {QStringLiteral("dark_frames"), dark}, {QStringLiteral("verdict"), verdict}, {QStringLiteral("frames"), frames}});
+}
