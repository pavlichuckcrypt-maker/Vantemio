+// reframe — кадрирование под формат (леттербокс 2.35, вертикаль 9:16, квадрат 1:1, 4:3)
+// через qtcrop. params: clip_id, aspect ("cinema"|"2.35"|"vertical"|"9:16"|"square"|"1:1"|"4:3"|число).
+QString GatewayService::handleReframe(const QString &requestId, const QJsonObject &params)
+{
+    auto tl = currentTimelineModel();
+    const int clipId = params.value(QStringLiteral("clip_id")).toInt(-1);
+    if (!tl || !tl->isClip(clipId))
+        return GatewayProtocol::errorResponse(QStringLiteral("reframe"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("clip_not_found"), QStringLiteral("Нет клипа с таким clip_id."));
+    const double W = m_core && m_core->getCurrentProfile() ? m_core->getCurrentProfile()->width() : 1920.0;
+    const double H = m_core && m_core->getCurrentProfile() ? m_core->getCurrentProfile()->height() : 1080.0;
+    const QString a = params.value(QStringLiteral("aspect")).toString(QStringLiteral("2.35")).toLower();
+    double aspect = 2.35;
+    if (a == QStringLiteral("cinema") || a == QStringLiteral("2.35")) aspect = 2.35;
+    else if (a == QStringLiteral("vertical") || a == QStringLiteral("9:16")) aspect = 9.0 / 16.0;
+    else if (a == QStringLiteral("square") || a == QStringLiteral("1:1")) aspect = 1.0;
+    else if (a == QStringLiteral("4:3")) aspect = 4.0 / 3.0;
+    else { bool ok = false; double v = a.toDouble(&ok); if (ok && v > 0.1) aspect = v; }
+    const double src = W / H;
+    QString rect;
+    if (aspect < src) { const double wf = aspect / src; const double x = (1.0 - wf) / 2.0;
+        rect = QStringLiteral("%1%/0%:%2%x100%").arg(x * 100.0, 0, 'f', 1).arg(wf * 100.0, 0, 'f', 1); }
+    else { const double hf = src / aspect; const double y = (1.0 - hf) / 2.0;
+        rect = QStringLiteral("0%/%1%:100%x%2%").arg(y * 100.0, 0, 'f', 1).arg(hf * 100.0, 0, 'f', 1); }
+    const int row = gw_addEffectWithParams(clipId, QStringLiteral("qtcrop"),
+        {{QStringLiteral("rect"), rect}, {QStringLiteral("color"), QStringLiteral("#ff000000")}});
+    if (row < 0)
+        return GatewayProtocol::errorResponse(QStringLiteral("reframe"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("reframe_failed"), QStringLiteral("Не удалось применить кадрирование."));
+    return GatewayProtocol::successResponse(QStringLiteral("reframe"), requestId, projectId(), timelineRevision(),
+        QJsonObject{{QStringLiteral("clip_id"), clipId}, {QStringLiteral("effect_row"), row}, {QStringLiteral("aspect"), aspect}, {QStringLiteral("rect"), rect}});
+}
