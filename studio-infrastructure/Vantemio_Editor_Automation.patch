+// duplicate_clip — копия клипа (из того же bin) в указанную точку.
+QString GatewayService::handleDuplicateClip(const QString &requestId, const QJsonObject &params)
+{
+    auto tl = currentTimelineModel();
+    const int clipId = params.value(QStringLiteral("clip_id")).toInt(-1);
+    if (!tl || !tl->isClip(clipId)) {
+        return GatewayProtocol::errorResponse(QStringLiteral("duplicate_clip"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("clip_not_found"), QStringLiteral("Нет клипа с таким clip_id."));
+    }
+    const QString binId = tl->getClipBinId(clipId);
+    const int srcTrack = tl->getClipTrackId(clipId);
+    const int trackId = params.contains(QStringLiteral("track_id")) ? params.value(QStringLiteral("track_id")).toInt() : srcTrack;
+    const double fps = m_core ? m_core->getCurrentFps() : 25.0;
+    int pos;
+    if (params.contains(QStringLiteral("position"))) {
+        pos = params.value(QStringLiteral("position")).toInt();
+    } else if (params.contains(QStringLiteral("seconds"))) {
+        pos = int(params.value(QStringLiteral("seconds")).toDouble() * fps);
+    } else {
+        // дефолт: КОНЕЦ целевой дорожки (свободное место, без перекрытия соседей)
+        pos = 0;
+        for (int it : tl->getItemsInRange(trackId, 0, -1, false)) {
+            if (tl->isClip(it)) pos = qMax(pos, tl->getClipPosition(it) + tl->getClipPlaytime(it));
+        }
+    }
+    int newId = -1;
+    const bool ok = tl->requestClipInsertion(binId, trackId, pos, newId, true, true, false);
+    if (!ok || newId < 0) {
+        return GatewayProtocol::errorResponse(QStringLiteral("duplicate_clip"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("duplicate_failed"), QStringLiteral("Не удалось вставить копию."));
+    }
+    ++m_timelineRevision;
+    return GatewayProtocol::successResponse(QStringLiteral("duplicate_clip"), requestId, projectId(), timelineRevision(),
+        QJsonObject{{QStringLiteral("source_clip_id"), clipId}, {QStringLiteral("new_clip_id"), newId}, {QStringLiteral("position"), pos}});
+}
