+                QStringLiteral("jump_to_undo_index requires undo_index.")
+            );
+        }
+        const int undoIndex = params.value(QStringLiteral("undo_index")).toInt(-1);
+        if (undoIndex < 0 || undoIndex > stack->count()) {
+            return GatewayProtocol::errorResponse(
+                QStringLiteral("open_ui_history_tool"),
+                requestId,
+                projectId(),
+                timelineRevision(),
+                QStringLiteral("invalid_value"),
+                QStringLiteral("Requested undo_index is outside the available undo range.")
+            );
+        }
+        stack->setIndex(undoIndex);
+        performed = true;
+    } else if (spec->toolId == QStringLiteral("step_undo")) {
+        if (!stack->canUndo()) {
+            return GatewayProtocol::errorResponse(
+                QStringLiteral("open_ui_history_tool"),
+                requestId,
+                projectId(),
+                timelineRevision(),
+                QStringLiteral("undo_unavailable"),
+                QStringLiteral("No undo step is currently available.")
+            );
+        }
+        stack->undo();
+        performed = true;
+    } else if (spec->toolId == QStringLiteral("step_redo")) {
+        if (!stack->canRedo()) {
+            return GatewayProtocol::errorResponse(
+                QStringLiteral("open_ui_history_tool"),
+                requestId,
+                projectId(),
+                timelineRevision(),
+                QStringLiteral("redo_unavailable"),
+                QStringLiteral("No redo step is currently available.")
+            );
+        }
+        stack->redo();
+        performed = true;
+    }
+
+    QCoreApplication::processEvents(QEventLoop::ExcludeSocketNotifiers);
+    dock = findNamedUiDock(window, QStringLiteral("undo_history"));
+    view = findUndoHistoryWidget(window);
+    ++m_timelineRevision;
+    QJsonObject result = serializeUiHistoryTool(*spec, action, dock);
+    result.insert(QStringLiteral("performed"), performed);
+    result.insert(QStringLiteral("simulated"), false);
+    if (action != nullptr) {
+        result.insert(QStringLiteral("action"), serializeUiAction(action));
+    }
+    if (dock != nullptr) {
+        result.insert(QStringLiteral("dock"), serializeUiDock(QStringLiteral("undo_history"), dock->windowTitle(), dock->toggleAction(), dock));
+    }
+    const QJsonObject state = serializeUndoHistoryState(stack, view, dock);
+    for (auto it = state.begin(); it != state.end(); ++it) {
+        result.insert(it.key(), it.value());
+    }
+    return GatewayProtocol::successResponse(
+        QStringLiteral("open_ui_history_tool"),
+        requestId,
+        projectId(),
+        timelineRevision(),
+        result
+    );
+}
