+QString GatewayService::handleApplyEffect(const QString &requestId, int clipId, const QString &effectName, const QString &effectParamsJson)
+{
+    auto timelineModel = currentTimelineModel();
+    auto controller = currentController();
+    if (!timelineModel || controller == nullptr || clipId < 0 || effectName.trimmed().isEmpty() || !timelineModel->isClip(clipId)) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("apply_effect"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("invalid_parameters"),
+            QStringLiteral("apply_effect requires an existing clip_id and effect_name.")
+        );
+    }
+
+    // Валидируем имя эффекта ДО применения: иначе addEffectToClip показывает
+    // модальный диалог ошибки и блокирует gateway. Чистая ошибка вместо зависания.
+    if (!EffectsRepository::get()->exists(effectName)) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("apply_effect"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("effect_not_found"),
+            QStringLiteral("Нет эффекта с таким effect_name (см. list_all_effects).")
+        );
+    }
+
+    controller->addEffectToClip(effectName, clipId);
+    // Применить переданные params к только что добавленному эффекту (раньше
+    // игнорировались — apply_effect с params не настраивал эффект). Теперь работают,
+    // в т.ч. keyframe-строки для rect/level (нужно для шаблонов движения/грейдов).
+    int appliedParams = 0;
+    const QJsonObject pobj = QJsonDocument::fromJson(effectParamsJson.toUtf8()).object();
+    if (!pobj.isEmpty()) {
+        std::shared_ptr<EffectStackModel> stack = timelineModel->getClipEffectStackModel(clipId);
+        if (stack && stack->rowCount() > 0) {
+            std::shared_ptr<EffectItemModel> eff = std::dynamic_pointer_cast<EffectItemModel>(stack->getEffectStackRow(stack->rowCount() - 1));
+            if (eff) {
+                for (auto it = pobj.constBegin(); it != pobj.constEnd(); ++it) {
+                    const QString val = it.value().isString() ? it.value().toString()
+                        : (it.value().isDouble() ? QString::number(it.value().toDouble())
+                        : (it.value().isBool() ? (it.value().toBool() ? QStringLiteral("1") : QStringLiteral("0")) : QString()));
+                    eff->setParameter(it.key(), val, true);
+                    ++appliedParams;
+                }
+            }
+        }
+    }
+    ++m_timelineRevision;
+    return GatewayProtocol::successResponse(
+        QStringLiteral("apply_effect"),
+        requestId,
+        projectId(),
+        timelineRevision(),
+        QJsonObject{
+            {QStringLiteral("clip_id"), clipId},
+            {QStringLiteral("effect_name"), effectName},
+            {QStringLiteral("applied_params"), appliedParams}
+        }
+    );
+}
