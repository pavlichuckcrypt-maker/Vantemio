+QString GatewayService::handleTagClip(const QString &requestId, const QJsonObject &params)
+{
+    loadTags();
+    const QString clipId = params.value(QStringLiteral("clip_id")).isString()
+        ? params.value(QStringLiteral("clip_id")).toString()
+        : QString::number(params.value(QStringLiteral("clip_id")).toInt());
+    const QString tag = params.value(QStringLiteral("tag")).toString();
+    if (clipId.isEmpty() || tag.isEmpty()) {
+        return GatewayProtocol::errorResponse(QStringLiteral("tag_clip"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("invalid_parameters"), QStringLiteral("tag_clip requires clip_id and tag (foto/blender/ai_video/...)."));
+    }
+    QJsonObject entry;
+    entry.insert(QStringLiteral("tag"), tag);
+    entry.insert(QStringLiteral("meta"), params.value(QStringLiteral("meta")).toObject());
+    m_clipTags.insert(clipId, entry);
+    saveTags();
+    return GatewayProtocol::successResponse(QStringLiteral("tag_clip"), requestId, projectId(), timelineRevision(),
+        QJsonObject{{QStringLiteral("clip_id"), clipId}, {QStringLiteral("tag"), tag}});
+}
