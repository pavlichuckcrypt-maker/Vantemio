+QString GatewayService::handleSetEffectParam(const QString &requestId, const QJsonObject &params)
+{
+    auto tl = currentTimelineModel();
+    const int clipId = params.value(QStringLiteral("clip_id")).toInt();
+    if (!tl || !tl->isClip(clipId)) {
+        return GatewayProtocol::errorResponse(QStringLiteral("set_effect_param"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("clip_not_found"), QStringLiteral("Нет клипа таймлайна с таким clip_id."));
+    }
+    std::shared_ptr<EffectStackModel> stack = tl->getClipEffectStackModel(clipId);
+    if (!stack) {
+        return GatewayProtocol::errorResponse(QStringLiteral("set_effect_param"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("no_effect_stack"), QStringLiteral("Clip has no effect stack."));
+    }
+    const int row = params.value(QStringLiteral("effect_row")).toInt();
+    const QString pname = params.value(QStringLiteral("param")).toString();
+    const QJsonValue jv = params.value(QStringLiteral("value"));
+    const QString val = jv.isString() ? jv.toString()
+        : (jv.isDouble() ? QString::number(jv.toDouble())
+        : (jv.isBool() ? (jv.toBool() ? QStringLiteral("1") : QStringLiteral("0")) : QString()));
+    std::shared_ptr<EffectItemModel> eff = gw_safeEffectRow(stack, row);
+    if (!eff || pname.isEmpty()) {
+        return GatewayProtocol::errorResponse(QStringLiteral("set_effect_param"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("effect_not_found"), QStringLiteral("set_effect_param requires valid effect_row and param."));
+    }
+    eff->setParameter(pname, val, true);
+    ++m_timelineRevision;
+    return GatewayProtocol::successResponse(QStringLiteral("set_effect_param"), requestId, projectId(), timelineRevision(),
+        QJsonObject{{QStringLiteral("clip_id"), clipId}, {QStringLiteral("effect_row"), row}, {QStringLiteral("param"), pname}, {QStringLiteral("value"), val}});
