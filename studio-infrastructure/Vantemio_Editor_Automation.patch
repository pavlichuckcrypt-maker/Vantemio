+QString GatewayService::handleTrimClip(const QString &requestId, int clipId, int inPoint, int outPoint)
+{
+    auto timelineModel = currentTimelineModel();
+    if (!timelineModel || clipId < 0 || outPoint < 0) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("trim_clip"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("invalid_parameters"),
+            QStringLiteral("trim_clip requires clip_id and out_point.")
+        );
+    }
+    if (!timelineModel->isClip(clipId)) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("trim_clip"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("clip_not_found"),
+            QStringLiteral("Timeline clip does not exist.")
+        );
+    }
+
+    const int currentIn = timelineModel->getClipIn(clipId);
+    if (inPoint >= 0 && inPoint != currentIn) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("trim_clip"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("unsupported_left_trim"),
+            QStringLiteral("Gateway currently supports safe right-edge trimming only.")
+        );
+    }
+
+    const int newSize = outPoint - (inPoint >= 0 ? inPoint : currentIn);
+    if (newSize <= 0) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("trim_clip"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("invalid_trim_range"),
+            QStringLiteral("Trim range produced an invalid clip duration.")
+        );
+    }
+
+    if (timelineModel->requestItemResize(clipId, newSize, true, true) < 0) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("trim_clip"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("clip_trim_failed"),
+            QStringLiteral("Timeline rejected clip resize.")
+        );
+    }
+
+    ++m_timelineRevision;
+    return GatewayProtocol::successResponse(
+        QStringLiteral("trim_clip"),
+        requestId,
+        projectId(),
+        timelineRevision(),
+        QJsonObject{
+            {QStringLiteral("clip_id"), clipId},
+            {QStringLiteral("in_point"), currentIn},
+            {QStringLiteral("out_point"), outPoint},
+            {QStringLiteral("duration"), newSize}
+        }
+    );
+}
