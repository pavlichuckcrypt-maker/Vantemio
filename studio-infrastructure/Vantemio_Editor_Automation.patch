+QJsonObject serializeUiDock(const QString &name, const QString &title, const QAction *toggleAction, const KDDockWidgets::QtWidgets::DockWidget *dock)
+{
+    const bool open = dock != nullptr ? (dock->toggleAction() != nullptr ? dock->toggleAction()->isChecked() : dock->isVisible())
+                                      : (toggleAction != nullptr ? toggleAction->isChecked() : false);
+    const bool visible = dock != nullptr ? dock->isVisible() : open;
+    QJsonObject result{
+        {QStringLiteral("name"), name},
+        {QStringLiteral("title"), title},
+        {QStringLiteral("open"), open},
+        {QStringLiteral("visible"), visible},
+        {QStringLiteral("floating"), dock != nullptr ? dock->isWindow() : false},
+        {QStringLiteral("focused"), dock != nullptr ? (dock->hasFocus() || dock->isActiveWindow()) : false},
+        {QStringLiteral("available_live_widget"), dock != nullptr}
+    };
+    return result;
+}
