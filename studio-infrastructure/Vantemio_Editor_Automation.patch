+        return GatewayProtocol::errorResponse(
+            QStringLiteral("open_ui_media_tool"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("invalid_parameters"),
+            QStringLiteral("open_ui_media_tool requires tool_id.")
+        );
+    }
+
+    const std::optional<UiMediaToolSpec> spec = findUiMediaToolSpec(toolId);
+    if (!spec.has_value()) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("open_ui_media_tool"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("media_tool_not_found"),
+            QStringLiteral("Requested media tool was not found.")
+        );
+    }
+
+    MainWindow *window = m_core->window();
+    QAction *action = nullptr;
+    KDDockWidgets::QtWidgets::DockWidget *dock = nullptr;
+    MediaBrowser *browser = findMediaBrowserWidget(window);
+    TextBasedEdit *editor = findSpeechEditorWidget(window);
+    bool performed = false;
+
+    if (spec->kind == QStringLiteral("dock")) {
+        dock = findNamedUiDock(window, spec->targetName);
+        if (dock == nullptr) {
+            return GatewayProtocol::errorResponse(
+                QStringLiteral("open_ui_media_tool"),
+                requestId,
+                projectId(),
+                timelineRevision(),
+                QStringLiteral("media_dock_unavailable"),
+                QStringLiteral("Requested media-related dock was not found.")
+            );
+        }
+        const bool open = params.contains(QStringLiteral("open")) ? params.value(QStringLiteral("open")).toBool() : true;
+        if (open) {
+            dock->open();
+        } else {
+            dock->close();
+        }
+        if (open && params.value(QStringLiteral("focus")).toBool(false)) {
+            dock->open();
+            dock->setAsCurrentTab();
+            dock->setFocus(Qt::OtherFocusReason);
+        }
+        performed = true;
+    } else if (spec->toolId == QStringLiteral("media_browser_set_url")) {
+        if (browser == nullptr) {
+            return GatewayProtocol::errorResponse(
+                QStringLiteral("open_ui_media_tool"),
+                requestId,
+                projectId(),
+                timelineRevision(),
+                QStringLiteral("media_browser_unavailable"),
+                QStringLiteral("Media Browser widget was not found.")
+            );
+        }
+        const QString urlText = params.value(QStringLiteral("url")).toString().trimmed();
+        if (urlText.isEmpty()) {
+            return GatewayProtocol::errorResponse(
+                QStringLiteral("open_ui_media_tool"),
+                requestId,
+                projectId(),
+                timelineRevision(),
+                QStringLiteral("invalid_parameters"),
+                QStringLiteral("media_browser_set_url requires url.")
+            );
+        }
+        browser->setUrl(QUrl::fromUserInput(urlText));
+        performed = true;
+    } else if (spec->toolId == QStringLiteral("media_browser_back")) {
+        if (browser == nullptr) {
+            return GatewayProtocol::errorResponse(
+                QStringLiteral("open_ui_media_tool"),
+                requestId,
+                projectId(),
+                timelineRevision(),
+                QStringLiteral("media_browser_unavailable"),
+                QStringLiteral("Media Browser widget was not found.")
+            );
+        }
+        browser->back();
+        performed = true;
+    } else if (spec->toolId == QStringLiteral("media_browser_forward")) {
+        if (browser == nullptr) {
+            return GatewayProtocol::errorResponse(
+                QStringLiteral("open_ui_media_tool"),
+                requestId,
+                projectId(),
+                timelineRevision(),
+                QStringLiteral("media_browser_unavailable"),
+                QStringLiteral("Media Browser widget was not found.")
+            );
+        }
+        browser->forward();
+        performed = true;
+    } else if (spec->toolId == QStringLiteral("media_browser_import_selection")) {
+        if (browser == nullptr) {
+            return GatewayProtocol::errorResponse(
+                QStringLiteral("open_ui_media_tool"),
+                requestId,
+                projectId(),
+                timelineRevision(),
+                QStringLiteral("media_browser_unavailable"),
+                QStringLiteral("Media Browser widget was not found.")
+            );
+        }
+        if (!QMetaObject::invokeMethod(browser, "importSelection", Qt::DirectConnection)) {
+            return GatewayProtocol::errorResponse(
+                QStringLiteral("open_ui_media_tool"),
+                requestId,
+                projectId(),
+                timelineRevision(),
+                QStringLiteral("media_method_failed"),
+                QStringLiteral("Failed to invoke Media Browser importSelection.")
+            );
+        }
+        performed = true;
+    } else if (spec->toolId == QStringLiteral("speech_search")) {
+        if (editor == nullptr) {
+            return GatewayProtocol::errorResponse(
+                QStringLiteral("open_ui_media_tool"),
+                requestId,
+                projectId(),
+                timelineRevision(),
+                QStringLiteral("speech_editor_unavailable"),
+                QStringLiteral("Speech Editor widget was not found.")
+            );
+        }
+        QAbstractButton *searchButton = editor->findChild<QAbstractButton *>(QStringLiteral("button_search"));
+        QLineEdit *searchLine = editor->findChild<QLineEdit *>(QStringLiteral("search_line"));
+        if (searchButton == nullptr || searchLine == nullptr) {
+            return GatewayProtocol::errorResponse(
+                QStringLiteral("open_ui_media_tool"),
+                requestId,
+                projectId(),
+                timelineRevision(),
+                QStringLiteral("speech_search_unavailable"),
+                QStringLiteral("Speech Editor search controls were not found.")
+            );
+        }
+        if (!searchButton->isChecked()) {
+            searchButton->click();
+        }
+        searchLine->setText(params.value(QStringLiteral("text")).toString());
+        searchLine->setFocus(Qt::OtherFocusReason);
+        performed = true;
+    } else {
+        if (editor == nullptr) {
+            return GatewayProtocol::errorResponse(
+                QStringLiteral("open_ui_media_tool"),
+                requestId,
+                projectId(),
+                timelineRevision(),
+                QStringLiteral("speech_editor_unavailable"),
+                QStringLiteral("Speech Editor widget was not found.")
+            );
+        }
+        QString methodName;
+        if (spec->toolId == QStringLiteral("speech_start_recognition")) {
+            methodName = QStringLiteral("startRecognition");
+        } else if (spec->toolId == QStringLiteral("speech_create_sequence")) {
+            methodName = QStringLiteral("createSequence");
+        } else if (spec->toolId == QStringLiteral("speech_insert_selection")) {
+            methodName = QStringLiteral("insertToTimeline");
+        } else if (spec->toolId == QStringLiteral("speech_zoom_in")) {
+            methodName = QStringLiteral("slotZoomIn");
+        } else if (spec->toolId == QStringLiteral("speech_zoom_out")) {
+            methodName = QStringLiteral("slotZoomOut");
+        } else if (spec->toolId == QStringLiteral("speech_find_next")) {
+            methodName = QStringLiteral("findNext");
+        } else if (spec->toolId == QStringLiteral("speech_find_previous")) {
+            methodName = QStringLiteral("findPrevious");
+        }
+        const QByteArray methodNameUtf8 = methodName.toUtf8();
+        if (!QMetaObject::invokeMethod(editor, methodNameUtf8.constData(), Qt::DirectConnection)) {
+            return GatewayProtocol::errorResponse(
+                QStringLiteral("open_ui_media_tool"),
+                requestId,
+                projectId(),
+                timelineRevision(),
+                QStringLiteral("speech_method_failed"),
+                QStringLiteral("Failed to invoke Speech Editor method.")
+            );
+        }
+        performed = true;
+    }
+
+    QCoreApplication::processEvents(QEventLoop::ExcludeSocketNotifiers);
+    browser = findMediaBrowserWidget(window);
+    editor = findSpeechEditorWidget(window);
+    if (spec->kind == QStringLiteral("dock")) {
+        dock = findNamedUiDock(window, spec->targetName);
+    }
+
+    QFrame *searchFrame = editor != nullptr ? editor->findChild<QFrame *>(QStringLiteral("search_frame")) : nullptr;
+    QLineEdit *searchLine = editor != nullptr ? editor->findChild<QLineEdit *>(QStringLiteral("search_line")) : nullptr;
+
+    ++m_timelineRevision;
+    QJsonObject result = serializeUiMediaTool(*spec, action, dock);
+    result.insert(QStringLiteral("performed"), performed);
+    result.insert(QStringLiteral("simulated"), false);
+    if (dock != nullptr) {
+        result.insert(QStringLiteral("dock"), serializeUiDock(spec->targetName, dock->windowTitle(), dock->toggleAction(), dock));
+    }
+    result.insert(QStringLiteral("media_browser_url"), browser != nullptr ? browser->url().toString() : QString());
+    result.insert(QStringLiteral("speech_search_visible"), searchFrame != nullptr ? searchFrame->isVisible() : false);
+    result.insert(QStringLiteral("speech_search_text"), searchLine != nullptr ? searchLine->text() : QString());
+    return GatewayProtocol::successResponse(
+        QStringLiteral("open_ui_media_tool"),
+        requestId,
+        projectId(),
+        timelineRevision(),
+        result
+    );
+}
