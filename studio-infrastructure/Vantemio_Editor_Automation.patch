+// observe — ЕДИНЫЙ ДАШБОРД МОЗГА: всё состояние редактора + визуал + авто-анализ
+// за ОДИН вызов. Полная картина: проект, таймлайн (треки/клипы/эффекты+params/зоны),
+// маркеры, корзина, история, рендер-статус, и (опц.) визуал — кадры с анализом +
+// контактный лист. params: with_visual(bool), frames(N=4), history(N=10).
+QString GatewayService::handleObserve(const QString &requestId, const QJsonObject &params)
+{
+    auto tl = currentTimelineModel();
+    const double fps = m_core ? m_core->getCurrentFps() : 25.0;
+    QJsonObject project{
+        {QStringLiteral("project_id"), projectId()},
+        {QStringLiteral("timeline_revision"), timelineRevision()},
+        {QStringLiteral("fps"), fps},
+        {QStringLiteral("render_status"), m_lastRenderStatus},
+        {QStringLiteral("render_output"), m_lastRenderOutput},
+    };
+    if (m_core && m_core->getCurrentProfile()) {
+        project.insert(QStringLiteral("width"), m_core->getCurrentProfile()->width());
+        project.insert(QStringLiteral("height"), m_core->getCurrentProfile()->height());
+    }
+    if (m_core && m_core->currentDoc()) {
+        project.insert(QStringLiteral("project_path"), m_core->currentDoc()->url().toLocalFile());
+    }
+    // playhead
+    if (m_core && m_core->monitorManager() && m_core->monitorManager()->projectMonitor()) {
+        const int pos = m_core->monitorManager()->projectMonitor()->position();
+        project.insert(QStringLiteral("playhead"), pos);
+        project.insert(QStringLiteral("playhead_sec"), pos / fps);
+    }
+
+    // ПОЛНЫЙ таймлайн с эффектами+параметрами+зонами (мозг видит каждое значение)
+    QJsonArray tracksArr;
+    int totalClips = 0, projectEnd = 0;
+    QJsonArray issues; // авто-анализ (линтер) на лету
+    if (tl) {
+        QList<int> all = tl->getTracksIds(false);
+        all.append(tl->getTracksIds(true));
+        for (int trackId : all) {
+            const bool isAudio = tl->isAudioTrack(trackId);
+            QJsonArray clipsArr;
+            std::unordered_set<int> items = tl->getItemsInRange(trackId, 0, -1, false);
+            QList<int> sorted(items.begin(), items.end());
+            std::sort(sorted.begin(), sorted.end(), [tl](int a, int b){ return tl->getClipPosition(a) < tl->getClipPosition(b); });
+            int prevEnd = -1;
+            for (int clipId : sorted) {
+                if (!tl->isClip(clipId)) continue;
+                const int pos = tl->getClipPosition(clipId), dur = tl->getClipPlaytime(clipId);
+                projectEnd = qMax(projectEnd, pos + dur); ++totalClips;
+                if (prevEnd >= 0 && pos > prevEnd && !isAudio)
+                    issues.append(QJsonObject{{QStringLiteral("type"), QStringLiteral("gap")}, {QStringLiteral("track_id"), trackId}, {QStringLiteral("detail"), QStringLiteral("%1->%2").arg(prevEnd).arg(pos)}});
+                prevEnd = pos + dur;
+                QJsonArray effArr;
+                std::shared_ptr<EffectStackModel> stack = tl->getClipEffectStackModel(clipId);
+                if (stack) {
+                    for (int r = 0; r < stack->rowCount(); ++r) {
+                        std::shared_ptr<EffectItemModel> eff = std::dynamic_pointer_cast<EffectItemModel>(stack->getEffectStackRow(r));
+                        if (!eff) continue;
+                        const QPair<int, int> io = eff->getInOut();
+                        QJsonArray ps;
+                        for (const auto &pr : eff->getAllParameters())
+                            ps.append(QJsonObject{{QStringLiteral("name"), pr.first}, {QStringLiteral("value"), pr.second.toString()}});
+                        effArr.append(QJsonObject{{QStringLiteral("row"), r}, {QStringLiteral("effect_id"), eff->getAssetId()},
+                            {QStringLiteral("enabled"), eff->isAssetEnabled()}, {QStringLiteral("zoned"), eff->hasForcedInOut()},
+                            {QStringLiteral("in"), io.first}, {QStringLiteral("out"), io.second}, {QStringLiteral("params"), ps}});
+                    }
+                }
+                clipsArr.append(QJsonObject{{QStringLiteral("clip_id"), clipId}, {QStringLiteral("bin_id"), tl->getClipBinId(clipId)},
+                    {QStringLiteral("position"), pos}, {QStringLiteral("duration"), dur}, {QStringLiteral("end"), pos + dur},
+                    {QStringLiteral("position_sec"), pos / fps}, {QStringLiteral("duration_sec"), dur / fps},
+                    {QStringLiteral("effects_count"), effArr.size()}, {QStringLiteral("effects"), effArr}});
+            }
+            tracksArr.append(QJsonObject{{QStringLiteral("track_id"), trackId}, {QStringLiteral("kind"), isAudio ? QStringLiteral("audio") : QStringLiteral("video")},
+                {QStringLiteral("tag"), tl->getTrackTagById(trackId)}, {QStringLiteral("locked"), tl->trackIsLocked(trackId)},
+                {QStringLiteral("clips_count"), clipsArr.size()}, {QStringLiteral("clips"), clipsArr}});
+        }
+    }
+
+    // корзина (bin)
+    QJsonArray binArr;
+    if (m_core && m_core->projectItemModel()) {
+        for (const QString &binId : m_core->projectItemModel()->getAllClipIds()) {
+            std::shared_ptr<ProjectClip> clip = m_core->projectItemModel()->getClipByBinID(binId);
+            if (!clip) continue;
+            const bool ready = clip->statusReady();
+            binArr.append(QJsonObject{{QStringLiteral("bin_id"), binId}, {QStringLiteral("name"), clip->clipName()},
+                {QStringLiteral("url"), clip->url()}, {QStringLiteral("ready"), ready}});
+        }
+    }
+    // маркеры
+    QJsonArray markersArr;
+    for (auto it = m_markers.constBegin(); it != m_markers.constEnd(); ++it)
+        markersArr.append(QJsonObject{{QStringLiteral("label"), it.key()}, {QStringLiteral("frame"), it.value().toInt()}});
+    // история (последние N)
+    const int hN = params.value(QStringLiteral("history")).toInt(10);
+    QJsonArray histArr;
+    for (int i = qMax(0, int(m_history.size()) - hN); i < m_history.size(); ++i) histArr.append(m_history.at(i));
+
+    QJsonObject result{
+        {QStringLiteral("project"), project},
+        {QStringLiteral("tracks_count"), tracksArr.size()},
+        {QStringLiteral("clips_count"), totalClips},
+        {QStringLiteral("project_end_frames"), projectEnd},
+        {QStringLiteral("project_end_sec"), projectEnd / fps},
+        {QStringLiteral("tracks"), tracksArr},
+        {QStringLiteral("bin"), binArr},
+        {QStringLiteral("markers"), markersArr},
+        {QStringLiteral("history"), histArr},
+        {QStringLiteral("clip_tags"), m_clipTags},
+        {QStringLiteral("analysis"), QJsonObject{{QStringLiteral("clean"), issues.isEmpty()}, {QStringLiteral("issues"), issues}}},
+    };
+
+    // ВИЗУАЛ (опц.): кадры с анализом + контактный лист — мозг «видит» монтаж
+    if (params.value(QStringLiteral("with_visual")).toBool(false) && projectEnd > 0) {
+        int frames = params.value(QStringLiteral("frames")).toInt(4);
+        if (frames < 1) frames = 1; if (frames > 12) frames = 12;
+        const QString dir = QDir::tempPath();
+        QJsonArray fr; QStringList paths;
+        for (int i = 0; i < frames; ++i) {
+            const int f = (frames == 1) ? projectEnd / 2 : projectEnd * i / (frames - 1);
+            const QString p = QStringLiteral("%1/vidra_obs_%2_%3.png").arg(dir).arg(f).arg(timelineRevision());
+            if (gw_captureFrame(f, p)) {
+                QJsonObject a = gw_analyzeImage(p); a.insert(QStringLiteral("frame"), f); a.insert(QStringLiteral("seconds"), f / fps);
+                fr.append(a); paths << p;
+            }
+        }
+        QString strip;
+        if (!paths.isEmpty()) {
+            strip = QStringLiteral("%1/vidra_obs_strip_%2.png").arg(dir).arg(timelineRevision());
+            const QByteArray env = qgetenv("VIDRA_STRIP_SCRIPT");
+            const QString script = !env.isEmpty() ? QString::fromUtf8(env) : QDir::homePath() + QStringLiteral("/AIMmontag/vidra_strip.py");
+            QStringList args{script, strip, QString::number(qMin(paths.size(), 4))}; args.append(paths);
+            QProcess pr; pr.start(QStringLiteral("/usr/bin/python3"), args); waitProcessPumped(pr, 20000, QStringLiteral("observe_strip"));
+        }
+        result.insert(QStringLiteral("visual"), QJsonObject{{QStringLiteral("frames"), fr}, {QStringLiteral("strip"), strip}, {QStringLiteral("strip_exists"), QFileInfo::exists(strip)}});
+    }
+    return GatewayProtocol::successResponse(QStringLiteral("observe"), requestId, projectId(), timelineRevision(), result);
+}
