+QString GatewayService::handleOpenUiSettingsPage(const QString &requestId, const QJsonObject &params)
+{
+    if (m_core == nullptr || m_core->window() == nullptr) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("open_ui_settings_page"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("ui_root_unavailable"),
+            QStringLiteral("MainWindow is not available.")
+        );
+    }
+
+    const QString pageId = params.value(QStringLiteral("page_id")).toString();
+    if (pageId.trimmed().isEmpty()) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("open_ui_settings_page"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("invalid_parameters"),
+            QStringLiteral("open_ui_settings_page requires page_id.")
+        );
+    }
+
+    const std::optional<UiSettingsPageSpec> spec = findUiSettingsPageSpec(pageId);
+    if (!spec.has_value()) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("open_ui_settings_page"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("settings_page_not_found"),
+            QStringLiteral("Requested settings page was not found.")
+        );
+    }
+
+    const int option = params.contains(QStringLiteral("option")) ? params.value(QStringLiteral("option")).toInt(-1) : -1;
+    const bool simulate = qEnvironmentVariableIsSet("KDENLIVE_GATEWAY_SMOKE_MODE");
+    if (simulate && KConfigDialog::exists(QStringLiteral("settings")) == nullptr) {
+        ++m_timelineRevision;
+        QJsonObject result = serializeUiSettingsPage(*spec);
+        result.insert(QStringLiteral("opened"), false);
+        result.insert(QStringLiteral("option"), option);
+        result.insert(QStringLiteral("simulated"), true);
+        result.insert(QStringLiteral("dialog_name"), QStringLiteral("settings"));
+        return GatewayProtocol::successResponse(
+            QStringLiteral("open_ui_settings_page"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            result
+        );
+    }
+
+    m_core->window()->slotShowPreferencePage(spec->page, option);
+    QCoreApplication::processEvents(QEventLoop::ExcludeSocketNotifiers);
+
+    KConfigDialog *dialog = KConfigDialog::exists(QStringLiteral("settings"));
+    if (dialog != nullptr) {
+        dialog->show();
+        dialog->raise();
+        dialog->activateWindow();
+    }
+
+    ++m_timelineRevision;
+    QJsonObject result = serializeUiSettingsPage(*spec);
+    result.insert(QStringLiteral("opened"), dialog != nullptr);
+    result.insert(QStringLiteral("option"), option);
+    result.insert(QStringLiteral("simulated"), false);
+    if (dialog != nullptr) {
+        result.insert(QStringLiteral("dialog"), serializeUiDialog(dialog));
+    }
+
+    return GatewayProtocol::successResponse(
+        QStringLiteral("open_ui_settings_page"),
+        requestId,
+        projectId(),
+        timelineRevision(),
+        result
+    );
+}
