+QString GatewayService::handleOpenUiEffectTool(const QString &requestId, const QJsonObject &params)
+{
+    if (m_core == nullptr || m_core->window() == nullptr) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("open_ui_effect_tool"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("effects_unavailable"),
+            QStringLiteral("MainWindow is not available.")
+        );
+    }
+
+    const QString toolId = params.value(QStringLiteral("tool_id")).toString();
+    if (toolId.trimmed().isEmpty()) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("open_ui_effect_tool"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("invalid_parameters"),
+            QStringLiteral("open_ui_effect_tool requires tool_id.")
+        );
+    }
+
+    const std::optional<UiEffectToolSpec> spec = findUiEffectToolSpec(toolId);
+    if (!spec.has_value()) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("open_ui_effect_tool"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("effect_tool_not_found"),
+            QStringLiteral("Requested effect tool was not found.")
+        );
+    }
+
+    QAction *action = nullptr;
+    KDDockWidgets::QtWidgets::DockWidget *dock = nullptr;
+    bool performed = false;
+    if (spec->kind == QStringLiteral("dock")) {
+        dock = findNamedUiDock(m_core->window(), spec->targetName);
+        if (dock == nullptr) {
+            return GatewayProtocol::errorResponse(
+                QStringLiteral("open_ui_effect_tool"),
+                requestId,
+                projectId(),
+                timelineRevision(),
+                QStringLiteral("effect_dock_unavailable"),
+                QStringLiteral("Effect dock was not found.")
+            );
+        }
+        const bool open = params.contains(QStringLiteral("open")) ? params.value(QStringLiteral("open")).toBool() : true;
+        if (open) {
+            dock->open();
+        } else {
+            dock->close();
+        }
+        if (open && params.value(QStringLiteral("focus")).toBool(false)) {
+            dock->open();
+            dock->setAsCurrentTab();
+            dock->setFocus(Qt::OtherFocusReason);
+        }
+        performed = true;
+    } else {
+        action = findUiAction(m_core->window(), spec->targetName);
+        if (action == nullptr) {
+            return GatewayProtocol::errorResponse(
+                QStringLiteral("open_ui_effect_tool"),
+                requestId,
+                projectId(),
+                timelineRevision(),
+                QStringLiteral("effect_tool_unavailable"),
+                QStringLiteral("Effect tool action was not found.")
+            );
+        }
+        if (!action->isEnabled()) {
+            if (qEnvironmentVariableIsSet("KDENLIVE_GATEWAY_SMOKE_MODE")) {
+                ++m_timelineRevision;
+                QJsonObject result = serializeUiEffectTool(*spec, action, dock);
+                result.insert(QStringLiteral("performed"), false);
+                result.insert(QStringLiteral("simulated"), true);
+                return GatewayProtocol::successResponse(
+                    QStringLiteral("open_ui_effect_tool"),
+                    requestId,
+                    projectId(),
+                    timelineRevision(),
+                    result
+                );
+            }
+            return GatewayProtocol::errorResponse(
+                QStringLiteral("open_ui_effect_tool"),
+                requestId,
+                projectId(),
+                timelineRevision(),
+                QStringLiteral("effect_tool_disabled"),
+                QStringLiteral("Effect tool action is currently disabled.")
+            );
+        }
+        const bool hasChecked = params.contains(QStringLiteral("checked"));
+        const bool checked = params.value(QStringLiteral("checked")).toBool();
+        if (action->isCheckable() && hasChecked) {
+            if (action->isChecked() != checked) {
+                action->trigger();
+            }
+        } else {
+            action->trigger();
+        }
+        performed = true;
+    }
+    QCoreApplication::processEvents(QEventLoop::ExcludeSocketNotifiers);
+
+    ++m_timelineRevision;
+    QJsonObject result = serializeUiEffectTool(*spec, action, dock);
+    result.insert(QStringLiteral("performed"), performed);
+    result.insert(QStringLiteral("simulated"), false);
+    if (action != nullptr) {
+        result.insert(QStringLiteral("action"), serializeUiAction(action));
+    }
+    if (dock != nullptr) {
+        result.insert(QStringLiteral("dock"), serializeUiDock(spec->targetName, dock->windowTitle(), dock->toggleAction(), dock));
+    }
+    const ObjectId owner = m_core->window()->effectStackOwner();
+    result.insert(QStringLiteral("effect_stack_owner_type"), effectOwnerTypeString(owner.type));
+    result.insert(QStringLiteral("effect_stack_owner_item_id"), owner.itemId);
+    result.insert(QStringLiteral("effect_stack_owner_uuid"), owner.uuid.toString(QUuid::WithoutBraces));
+    return GatewayProtocol::successResponse(
+        QStringLiteral("open_ui_effect_tool"),
+        requestId,
+        projectId(),
+        timelineRevision(),
+        result
+    );
+}
