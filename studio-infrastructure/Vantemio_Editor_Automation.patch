+QJsonObject serializeUiLayout(const LayoutInfo &layout, bool isVerticalWorkspace)
+{
+    const bool hasPreferredVariant = isVerticalWorkspace ? layout.hasVerticalData() : layout.hasHorizontalData();
+    return QJsonObject{
+        {QStringLiteral("layout_id"), layout.internalId},
+        {QStringLiteral("display_name"), layout.displayName},
+        {QStringLiteral("is_default"), layout.isDefault},
+        {QStringLiteral("has_horizontal_data"), layout.hasHorizontalData()},
+        {QStringLiteral("has_vertical_data"), layout.hasVerticalData()},
+        {QStringLiteral("preferred_variant"), hasPreferredVariant ? (isVerticalWorkspace ? QStringLiteral("vertical") : QStringLiteral("horizontal"))
+                                                                  : (layout.hasHorizontalData() ? QStringLiteral("horizontal")
+                                                                                                : QStringLiteral("vertical"))},
+        {QStringLiteral("available_live_workspace"), true}
+    };
+}
