+// ============================================================================
+// Универсальный слой полного управления (добавлено для VidRA AI).
+// Доступ ко ВСЕМ объектам интерфейса (Qt meta-object) и ко ВСЕМ свойствам MLT.
+// ============================================================================
+namespace {
+
+QObject *gw_resolveObject(const QString &id)
+{
+    if (id.isEmpty()) {
+        return nullptr;
+    }
+    const QWidgetList tops = QApplication::topLevelWidgets();
+    for (QWidget *top : tops) {
+        if (top == nullptr) {
+            continue;
+        }
+        if (automationIdForObject(top) == id || top->objectName() == id) {
+            return top;
+        }
+        const QList<QObject *> kids = top->findChildren<QObject *>();
+        for (QObject *o : kids) {
+            if (o != nullptr && (automationIdForObject(o) == id || o->objectName() == id)) {
+                return o;
+            }
+        }
+    }
+    return nullptr;
+}
+
+QJsonValue gw_variantToJson(const QVariant &v)
+{
+    switch (v.typeId()) {
+    case QMetaType::Bool:
+        return QJsonValue(v.toBool());
+    case QMetaType::Int:
+    case QMetaType::UInt:
+    case QMetaType::LongLong:
+    case QMetaType::ULongLong:
+        return QJsonValue(v.toLongLong());
+    case QMetaType::Double:
+    case QMetaType::Float:
+        return QJsonValue(v.toDouble());
+    default:
+        if (v.canConvert<QString>()) {
+            return QJsonValue(v.toString());
+        }
+        return QJsonValue(QJsonValue::Null);
+    }
+}
+
+QVariant gw_jsonToVariant(const QJsonValue &v)
+{
+    switch (v.type()) {
+    case QJsonValue::Bool:
+        return v.toBool();
+    case QJsonValue::Double:
+        return v.toDouble();
+    case QJsonValue::String:
+        return v.toString();
+    default:
+        return QVariant();
+    }
+}
+
+} // namespace
+
+QString GatewayService::handleQtListObjects(const QString &requestId, const QJsonObject &params) const
+{
+    const QString classFilter = params.value(QStringLiteral("class")).toString();
+    const QString nameFilter = params.value(QStringLiteral("name")).toString();
+    QJsonArray arr;
+    QSet<QObject *> seen;
+    const QWidgetList tops = QApplication::topLevelWidgets();
+    for (QWidget *top : tops) {
+        if (top == nullptr) {
+            continue;
+        }
+        QList<QObject *> objs;
+        objs.append(top);
+        objs.append(top->findChildren<QObject *>());
+        for (QObject *o : objs) {
+            if (o == nullptr || seen.contains(o)) {
+                continue;
+            }
+            seen.insert(o);
+            const QString cls = QString::fromUtf8(o->metaObject()->className());
+            if (!classFilter.isEmpty() && !cls.contains(classFilter, Qt::CaseInsensitive)) {
+                continue;
+            }
+            const QString id = automationIdForObject(o);
+            if (!nameFilter.isEmpty() && !id.contains(nameFilter, Qt::CaseInsensitive) && !o->objectName().contains(nameFilter, Qt::CaseInsensitive)) {
+                continue;
+            }
+            arr.append(QJsonObject{
+                {QStringLiteral("id"), id},
+                {QStringLiteral("class"), cls},
+                {QStringLiteral("object_name"), o->objectName()},
+                {QStringLiteral("is_widget"), o->isWidgetType()},
+            });
+            if (arr.size() >= 8000) {
+                break;
+            }
+        }
+        if (arr.size() >= 8000) {
+            break;
+        }
+    }
+    return GatewayProtocol::successResponse(QStringLiteral("qt_list_objects"), requestId, projectId(), timelineRevision(),
+        QJsonObject{{QStringLiteral("count"), arr.size()}, {QStringLiteral("objects"), arr}});
+}
