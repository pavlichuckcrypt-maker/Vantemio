+// assert_state — мозг объявляет ожидания, gateway отдаёт pass/fail по каждому.
+QString GatewayService::handleAssertState(const QString &requestId, const QJsonObject &params)
+{
+    auto tl = currentTimelineModel();
+    const QJsonObject expect = params.value(QStringLiteral("expect")).toObject();
+    int clips = 0, projEnd = 0, tracks = 0;
+    if (tl) {
+        QList<int> all = tl->getTracksIds(false);
+        all.append(tl->getTracksIds(true));
+        tracks = all.size();
+        for (int trackId : all) {
+            for (int it : tl->getItemsInRange(trackId, 0, -1, false)) {
+                if (tl->isClip(it)) { ++clips; projEnd = qMax(projEnd, tl->getClipPosition(it) + tl->getClipPlaytime(it)); }
+            }
+        }
+    }
+    QJsonArray checks;
+    bool allPass = true;
+    auto cmp = [&](const QString &key, int actual) {
+        if (!expect.contains(key)) return;
+        const int exp = expect.value(key).toInt();
+        const bool pass = (actual == exp);
+        if (!pass) allPass = false;
+        checks.append(QJsonObject{{QStringLiteral("check"), key}, {QStringLiteral("expected"), exp}, {QStringLiteral("actual"), actual}, {QStringLiteral("pass"), pass}});
+    };
+    cmp(QStringLiteral("clips_count"), clips);
+    cmp(QStringLiteral("tracks_count"), tracks);
+    // project_end_frames с допуском (min/max)
+    if (expect.contains(QStringLiteral("project_end_min"))) {
+        const int mn = expect.value(QStringLiteral("project_end_min")).toInt(); const bool pass = projEnd >= mn;
+        if (!pass) allPass = false; checks.append(QJsonObject{{QStringLiteral("check"), QStringLiteral("project_end_min")}, {QStringLiteral("expected"), mn}, {QStringLiteral("actual"), projEnd}, {QStringLiteral("pass"), pass}});
+    }
+    if (expect.contains(QStringLiteral("project_end_max"))) {
+        const int mx = expect.value(QStringLiteral("project_end_max")).toInt(); const bool pass = projEnd <= mx;
+        if (!pass) allPass = false; checks.append(QJsonObject{{QStringLiteral("check"), QStringLiteral("project_end_max")}, {QStringLiteral("expected"), mx}, {QStringLiteral("actual"), projEnd}, {QStringLiteral("pass"), pass}});
+    }
+    return GatewayProtocol::successResponse(QStringLiteral("assert_state"), requestId, projectId(), timelineRevision(),
+        QJsonObject{{QStringLiteral("pass"), allPass}, {QStringLiteral("clips_count"), clips}, {QStringLiteral("tracks_count"), tracks},
+                    {QStringLiteral("project_end_frames"), projEnd}, {QStringLiteral("checks"), checks}});
+}
