+// set_keyframes — задать ключевые кадры параметра структурно (без ручных строк).
+QString GatewayService::handleSetKeyframes(const QString &requestId, const QJsonObject &params)
+{
+    auto tl = currentTimelineModel();
+    const int clipId = params.value(QStringLiteral("clip_id")).toInt(-1);
+    if (!tl || !tl->isClip(clipId)) {
+        return GatewayProtocol::errorResponse(QStringLiteral("set_keyframes"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("clip_not_found"), QStringLiteral("Нет клипа с таким clip_id."));
+    }
+    std::shared_ptr<EffectStackModel> stack = tl->getClipEffectStackModel(clipId);
+    const int row = params.value(QStringLiteral("effect_row")).toInt(-1);
+    std::shared_ptr<EffectItemModel> eff = gw_safeEffectRow(stack, row);
+    const QString pname = params.value(QStringLiteral("param")).toString();
+    if (!eff || pname.isEmpty()) {
+        return GatewayProtocol::errorResponse(QStringLiteral("set_keyframes"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("effect_not_found"), QStringLiteral("Нужны валидные effect_row и param (см. list_effects)."));
+    }
+    QStringList parts;
+    for (const QJsonValue &kv : params.value(QStringLiteral("keyframes")).toArray()) {
+        const QJsonObject k = kv.toObject();
+        const QJsonValue v = k.value(QStringLiteral("value"));
+        const QString vs = v.isString() ? v.toString() : QString::number(v.toDouble());
+        parts << QStringLiteral("%1=%2").arg(k.value(QStringLiteral("frame")).toInt()).arg(vs);
+    }
+    if (parts.isEmpty()) {
+        return GatewayProtocol::errorResponse(QStringLiteral("set_keyframes"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("empty_keyframes"), QStringLiteral("keyframes:[{frame,value}] обязателен."));
+    }
+    const QString kfStr = parts.join(QLatin1Char(';'));
+    eff->setParameter(pname, kfStr, true);
+    ++m_timelineRevision;
+    return GatewayProtocol::successResponse(QStringLiteral("set_keyframes"), requestId, projectId(), timelineRevision(),
+        QJsonObject{{QStringLiteral("clip_id"), clipId}, {QStringLiteral("effect_row"), row}, {QStringLiteral("param"), pname}, {QStringLiteral("keyframes"), kfStr}});
+}
