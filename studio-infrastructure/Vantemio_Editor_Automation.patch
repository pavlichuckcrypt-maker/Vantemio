+QString GatewayService::handleSetClipDuration(const QString &requestId, const QJsonObject &params)
+{
+    auto tl = currentTimelineModel();
+    const int clipId = params.value(QStringLiteral("clip_id")).toInt(-1);
+    if (!tl || !tl->isClip(clipId)) {
+        return GatewayProtocol::errorResponse(QStringLiteral("set_clip_duration"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("clip_not_found"), QStringLiteral("Нет клипа с таким clip_id."));
+    }
+    const int frames = params.value(QStringLiteral("frames")).toInt(-1);
+    if (frames <= 0) {
+        return GatewayProtocol::errorResponse(QStringLiteral("set_clip_duration"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("invalid_frames"), QStringLiteral("set_clip_duration требует frames > 0."));
+    }
+    // right=true: тянем правый край (меняем длительность от начала клипа)
+    const bool fromRight = params.value(QStringLiteral("from_right")).toBool(true);
+    const int newSize = tl->requestItemResize(clipId, frames, fromRight, true);
+    if (newSize < 0) {
+        return GatewayProtocol::errorResponse(QStringLiteral("set_clip_duration"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("resize_failed"), QStringLiteral("Не удалось изменить длительность (упор в соседний клип/границу?)."));
+    }
+    ++m_timelineRevision;
+    return GatewayProtocol::successResponse(QStringLiteral("set_clip_duration"), requestId, projectId(), timelineRevision(),
+        QJsonObject{{QStringLiteral("clip_id"), clipId}, {QStringLiteral("requested_frames"), frames}, {QStringLiteral("actual_frames"), newSize}});
+}
