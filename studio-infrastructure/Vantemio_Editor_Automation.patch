+QString GatewayService::handleActivateUiControl(const QString &requestId, const QJsonObject &params)
+{
+    const QString controlName = params.value(QStringLiteral("control_name")).toString();
+    if (m_core == nullptr || m_core->window() == nullptr || controlName.trimmed().isEmpty()) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("activate_ui_control"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("invalid_parameters"),
+            QStringLiteral("activate_ui_control requires control_name and an available MainWindow.")
+        );
+    }
+
+    QWidget *widget = nullptr;
+    const QList<QObject *> roots = collectAutomationUiRoots(m_core->window());
+    for (QObject *root : roots) {
+        widget = findNamedUiControl(root, controlName);
+        if (widget != nullptr) {
+            break;
+        }
+    }
+    if (widget == nullptr) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("activate_ui_control"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("control_not_found"),
+            QStringLiteral("Requested UI control was not found.")
+        );
+    }
+    if (!widget->isEnabled()) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("activate_ui_control"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("control_disabled"),
+            QStringLiteral("Requested UI control is currently disabled.")
+        );
+    }
+
+    if (QAbstractButton *button = qobject_cast<QAbstractButton *>(widget)) {
+        const bool hasCheckedState = params.contains(QStringLiteral("checked"));
+        const bool checkedState = params.value(QStringLiteral("checked")).toBool();
+        if (button->isCheckable() && hasCheckedState) {
+            if (button->isChecked() != checkedState) {
+                button->click();
+            }
+        }
+        else {
+            button->click();
+        }
+    } else if (QComboBox *combo = qobject_cast<QComboBox *>(widget)) {
+        if (params.contains(QStringLiteral("index"))) {
+            const int index = params.value(QStringLiteral("index")).toInt(-1);
+            if (index < 0 || index >= combo->count()) {
+                return GatewayProtocol::errorResponse(QStringLiteral("activate_ui_control"), requestId, projectId(), timelineRevision(),
+                                                      QStringLiteral("invalid_value"), QStringLiteral("Requested combo box index is out of range."));
+            }
+            combo->setCurrentIndex(index);
+        } else if (params.contains(QStringLiteral("text"))) {
+            const QString text = params.value(QStringLiteral("text")).toString();
+            const int index = combo->findText(text);
+            if (index < 0) {
+                return GatewayProtocol::errorResponse(QStringLiteral("activate_ui_control"), requestId, projectId(), timelineRevision(),
+                                                      QStringLiteral("invalid_value"), QStringLiteral("Requested combo box text was not found."));
+            }
+            combo->setCurrentIndex(index);
+        } else {
+            return GatewayProtocol::errorResponse(QStringLiteral("activate_ui_control"), requestId, projectId(), timelineRevision(),
+                                                  QStringLiteral("invalid_parameters"), QStringLiteral("Combo boxes require index or text."));
+        }
+    } else if (QSpinBox *spin = qobject_cast<QSpinBox *>(widget)) {
+        if (!params.contains(QStringLiteral("value"))) {
+            return GatewayProtocol::errorResponse(QStringLiteral("activate_ui_control"), requestId, projectId(), timelineRevision(),
+                                                  QStringLiteral("invalid_parameters"), QStringLiteral("Spin boxes require value."));
+        }
+        spin->setValue(params.value(QStringLiteral("value")).toInt(spin->value()));
+    } else if (QDoubleSpinBox *doubleSpin = qobject_cast<QDoubleSpinBox *>(widget)) {
+        if (!params.contains(QStringLiteral("value"))) {
+            return GatewayProtocol::errorResponse(QStringLiteral("activate_ui_control"), requestId, projectId(), timelineRevision(),
+                                                  QStringLiteral("invalid_parameters"), QStringLiteral("Double spin boxes require value."));
+        }
+        doubleSpin->setValue(params.value(QStringLiteral("value")).toDouble(doubleSpin->value()));
+    } else if (QSlider *slider = qobject_cast<QSlider *>(widget)) {
+        if (!params.contains(QStringLiteral("value"))) {
+            return GatewayProtocol::errorResponse(QStringLiteral("activate_ui_control"), requestId, projectId(), timelineRevision(),
+                                                  QStringLiteral("invalid_parameters"), QStringLiteral("Sliders require value."));
+        }
+        slider->setValue(params.value(QStringLiteral("value")).toInt(slider->value()));
+    } else if (QLineEdit *lineEdit = qobject_cast<QLineEdit *>(widget)) {
+        if (lineEdit->isReadOnly() || !params.contains(QStringLiteral("text"))) {
+            return GatewayProtocol::errorResponse(QStringLiteral("activate_ui_control"), requestId, projectId(), timelineRevision(),
+                                                  QStringLiteral("invalid_parameters"), QStringLiteral("Line edits require writable text input."));
+        }
+        lineEdit->setText(params.value(QStringLiteral("text")).toString());
+    } else if (QTabBar *tabBar = qobject_cast<QTabBar *>(widget)) {
+        if (!params.contains(QStringLiteral("index"))) {
+            return GatewayProtocol::errorResponse(QStringLiteral("activate_ui_control"), requestId, projectId(), timelineRevision(),
+                                                  QStringLiteral("invalid_parameters"), QStringLiteral("Tab bars require index."));
+        }
+        const int index = params.value(QStringLiteral("index")).toInt(-1);
+        if (index < 0 || index >= tabBar->count()) {
+            return GatewayProtocol::errorResponse(QStringLiteral("activate_ui_control"), requestId, projectId(), timelineRevision(),
+                                                  QStringLiteral("invalid_value"), QStringLiteral("Requested tab index is out of range."));
+        }
+        tabBar->setCurrentIndex(index);
+    } else if (QAbstractItemView *itemView = qobject_cast<QAbstractItemView *>(widget)) {
+        QAbstractItemModel *model = itemView->model();
+        if (model == nullptr) {
+            return GatewayProtocol::errorResponse(QStringLiteral("activate_ui_control"), requestId, projectId(), timelineRevision(),
+                                                  QStringLiteral("invalid_parameters"), QStringLiteral("Item views require a model."));
+        }
+
+        QModelIndex targetIndex;
+        if (params.contains(QStringLiteral("row"))) {
+            const int row = params.value(QStringLiteral("row")).toInt(-1);
+            const int column = params.value(QStringLiteral("column")).toInt(0);
+            if (row < 0 || column < 0 || row >= model->rowCount() || column >= model->columnCount()) {
+                return GatewayProtocol::errorResponse(QStringLiteral("activate_ui_control"), requestId, projectId(), timelineRevision(),
+                                                      QStringLiteral("invalid_value"), QStringLiteral("Requested item view row/column is out of range."));
+            }
+            targetIndex = model->index(row, column);
+        } else if (params.contains(QStringLiteral("match_text"))) {
+            const QString matchText = params.value(QStringLiteral("match_text")).toString();
+            Qt::MatchFlags matchFlags = Qt::MatchRecursive | Qt::MatchFixedString;
+            if (params.value(QStringLiteral("match_contains")).toBool(false)) {
+                matchFlags = Qt::MatchRecursive | Qt::MatchContains;
+            }
+            const QModelIndex startIndex = model->rowCount() > 0 && model->columnCount() > 0 ? model->index(0, 0) : QModelIndex();
+            const QModelIndexList matches = model->match(startIndex, Qt::DisplayRole, matchText, 1, matchFlags);
+            if (matches.isEmpty()) {
+                return GatewayProtocol::errorResponse(QStringLiteral("activate_ui_control"), requestId, projectId(), timelineRevision(),
+                                                      QStringLiteral("invalid_value"), QStringLiteral("Requested item view text was not found."));
+            }
+            targetIndex = matches.constFirst();
+        } else {
+            return GatewayProtocol::errorResponse(QStringLiteral("activate_ui_control"), requestId, projectId(), timelineRevision(),
+                                                  QStringLiteral("invalid_parameters"), QStringLiteral("Item views require row or match_text."));
+        }
+
+        if (!targetIndex.isValid()) {
+            return GatewayProtocol::errorResponse(QStringLiteral("activate_ui_control"), requestId, projectId(), timelineRevision(),
+                                                  QStringLiteral("invalid_value"), QStringLiteral("Requested item view target is invalid."));
+        }
+        itemView->setCurrentIndex(targetIndex);
+        if (itemView->selectionModel() != nullptr) {
+            itemView->selectionModel()->setCurrentIndex(targetIndex, QItemSelectionModel::ClearAndSelect);
+        }
+        itemView->scrollTo(targetIndex);
+    } else if (QTextEdit *textEdit = qobject_cast<QTextEdit *>(widget)) {
+        if (textEdit->isReadOnly() || !params.contains(QStringLiteral("text"))) {
+            return GatewayProtocol::errorResponse(QStringLiteral("activate_ui_control"), requestId, projectId(), timelineRevision(),
+                                                  QStringLiteral("invalid_parameters"), QStringLiteral("Text edits require writable text input."));
+        }
+        textEdit->setPlainText(params.value(QStringLiteral("text")).toString());
+    } else if (QPlainTextEdit *plainTextEdit = qobject_cast<QPlainTextEdit *>(widget)) {
+        if (plainTextEdit->isReadOnly() || !params.contains(QStringLiteral("text"))) {
+            return GatewayProtocol::errorResponse(QStringLiteral("activate_ui_control"), requestId, projectId(), timelineRevision(),
+                                                  QStringLiteral("invalid_parameters"), QStringLiteral("Plain text edits require writable text input."));
+        }
+        plainTextEdit->setPlainText(params.value(QStringLiteral("text")).toString());
+    } else {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("activate_ui_control"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("unsupported_control_type"),
+            QStringLiteral("Requested control type is not supported for automation.")
+        );
+    }
+
+    ++m_timelineRevision;
+    return GatewayProtocol::successResponse(
+        QStringLiteral("activate_ui_control"),
+        requestId,
+        projectId(),
+        timelineRevision(),
+        serializeUiControl(widget)
+    );
+}
