+QString GatewayService::handleUndo(const QString &requestId, const QJsonObject &params)
+{
+    const int count = qMax(1, params.value(QStringLiteral("count")).toInt(1));
+    MainWindow *win = m_core != nullptr ? m_core->window() : nullptr;
+    QAction *act = (win != nullptr && win->actionCollection() != nullptr) ? win->actionCollection()->action(QStringLiteral("edit_undo")) : nullptr;
+    if (act == nullptr) {
+        return GatewayProtocol::errorResponse(QStringLiteral("undo"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("no_undo"), QStringLiteral("Undo action unavailable."));
+    }
+    int done = 0;
+    for (int i = 0; i < count && act->isEnabled(); ++i) {
+        act->trigger();
+        ++done;
+    }
+    ++m_timelineRevision;
+    return GatewayProtocol::successResponse(QStringLiteral("undo"), requestId, projectId(), timelineRevision(),
+        QJsonObject{{QStringLiteral("undone"), done}});
+}
