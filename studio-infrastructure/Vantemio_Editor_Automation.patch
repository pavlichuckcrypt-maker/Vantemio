+QString GatewayService::handleSeek(const QString &requestId, const QJsonObject &params)
+{
+    if (m_core == nullptr || m_core->monitorManager() == nullptr || m_core->monitorManager()->projectMonitor() == nullptr) {
+        return GatewayProtocol::errorResponse(QStringLiteral("seek"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("no_monitor"), QStringLiteral("Project monitor unavailable."));
+    }
+    double fps = m_core->getCurrentFps();
+    if (fps <= 0.0) fps = 25.0;   // защита от деления на 0 → seconds=inf → битый JSON
+    int frame = -1;
+    if (params.contains(QStringLiteral("frame"))) {
+        frame = params.value(QStringLiteral("frame")).toInt();
+    } else if (params.contains(QStringLiteral("seconds"))) {
+        frame = int(qRound(params.value(QStringLiteral("seconds")).toDouble() * fps));
+    }
+    if (frame < 0) {
+        return GatewayProtocol::errorResponse(QStringLiteral("seek"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("invalid_parameters"), QStringLiteral("seek requires frame or seconds (>=0)."));
+    }
+    m_core->monitorManager()->projectMonitor()->requestSeek(frame);
+    return GatewayProtocol::successResponse(QStringLiteral("seek"), requestId, projectId(), timelineRevision(),
+        QJsonObject{{QStringLiteral("frame"), frame}, {QStringLiteral("seconds"), frame / fps}});
+}
