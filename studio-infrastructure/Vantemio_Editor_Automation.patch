+// generate_clip — создать генеративный bin-клип. type: color (заливка), title (текст).
+QString GatewayService::handleGenerateClip(const QString &requestId, const QJsonObject &params)
+{
+    if (m_core == nullptr || m_core->projectItemModel() == nullptr) {
+        return GatewayProtocol::errorResponse(QStringLiteral("generate_clip"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("no_project"), QStringLiteral("No project."));
+    }
+    const QString type = params.value(QStringLiteral("type")).toString();
+    const double fps = m_core ? m_core->getCurrentFps() : 25.0;
+    const int dur = params.contains(QStringLiteral("duration_frames")) ? params.value(QStringLiteral("duration_frames")).toInt()
+                  : (params.contains(QStringLiteral("seconds")) ? int(params.value(QStringLiteral("seconds")).toDouble() * fps) : int(5 * fps));
+    const auto root = m_core->projectItemModel()->getRootFolder();
+    const QString rootId = root ? root->clipId() : QStringLiteral("-1");
+    QString binId;
+    if (type == QStringLiteral("color")) {
+        const QString color = params.value(QStringLiteral("color")).toString().isEmpty() ? QStringLiteral("#000000ff") : params.value(QStringLiteral("color")).toString();
+        const QString name = params.value(QStringLiteral("name")).toString().isEmpty() ? QStringLiteral("VidRA Color") : params.value(QStringLiteral("name")).toString();
+        binId = ClipCreator::createColorClip(color, dur, name, rootId, m_core->projectItemModel());
+    } else if (type == QStringLiteral("title")) {
+        const QString text = params.value(QStringLiteral("text")).toString();
+        const int W = m_core->getCurrentProfile() ? m_core->getCurrentProfile()->width() : 1920;
+        const int H = m_core->getCurrentProfile() ? m_core->getCurrentProfile()->height() : 1080;
+        const int sz = params.value(QStringLiteral("size")).toInt(120);
+        const QString col = params.value(QStringLiteral("color")).toString().isEmpty() ? QStringLiteral("255,255,255,255") : params.value(QStringLiteral("color")).toString();
+        // минимальный title-XML Kdenlive (текстовый элемент по центру)
+        const QString xml = QStringLiteral(
+            "<kdenlivetitle width=\"%1\" height=\"%2\" out=\"%3\">"
+            "<item type=\"QGraphicsTextItem\" z-index=\"0\">"
+            "<position x=\"%4\" y=\"%5\"><transform>1,0,0,0,1,0,0,0,1</transform></position>"
+            "<content font-pixel-size=\"%6\" font-color=\"%7\" font=\"Sans Serif\">%8</content>"
+            "</item></kdenlivetitle>")
+            .arg(W).arg(H).arg(dur).arg(W/4).arg(H/2 - sz/2).arg(sz).arg(col).arg(text.toHtmlEscaped());
+        std::unordered_map<QString, QString> props;
+        props[QStringLiteral("xmldata")] = xml;
+        const QString name = params.value(QStringLiteral("name")).toString().isEmpty() ? QStringLiteral("VidRA Title") : params.value(QStringLiteral("name")).toString();
+        binId = ClipCreator::createTitleClip(props, dur, name, rootId, m_core->projectItemModel());
+    } else {
+        return GatewayProtocol::errorResponse(QStringLiteral("generate_clip"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("unknown_type"), QStringLiteral("type: color | title."));
+    }
+    if (binId.isEmpty() || binId == QStringLiteral("-1")) {
+        return GatewayProtocol::errorResponse(QStringLiteral("generate_clip"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("generate_failed"), QStringLiteral("Не удалось создать клип."));
+    }
+    return GatewayProtocol::successResponse(QStringLiteral("generate_clip"), requestId, projectId(), timelineRevision(),
+        QJsonObject{{QStringLiteral("bin_id"), binId}, {QStringLiteral("type"), type}, {QStringLiteral("duration_frames"), dur}});
+}
