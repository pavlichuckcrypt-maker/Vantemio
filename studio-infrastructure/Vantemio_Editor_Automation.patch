+// get_keyframes — прочитать ключевые кадры параметра (распарсить в массив).
+QString GatewayService::handleGetKeyframes(const QString &requestId, const QJsonObject &params) const
+{
+    auto tl = currentTimelineModel();
+    const int clipId = params.value(QStringLiteral("clip_id")).toInt(-1);
+    if (!tl || !tl->isClip(clipId)) {
+        return GatewayProtocol::errorResponse(QStringLiteral("get_keyframes"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("clip_not_found"), QStringLiteral("Нет клипа с таким clip_id."));
+    }
+    std::shared_ptr<EffectStackModel> stack = tl->getClipEffectStackModel(clipId);
+    const int row = params.value(QStringLiteral("effect_row")).toInt(-1);
+    std::shared_ptr<EffectItemModel> eff = gw_safeEffectRow(stack, row);
+    const QString pname = params.value(QStringLiteral("param")).toString();
+    if (!eff || pname.isEmpty()) {
+        return GatewayProtocol::errorResponse(QStringLiteral("get_keyframes"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("effect_not_found"), QStringLiteral("Нужны валидные effect_row и param."));
+    }
+    const QString raw = eff->getParamFromName(pname).toString();
+    QJsonArray kfs;
+    for (const QString &seg : raw.split(QLatin1Char(';'), Qt::SkipEmptyParts)) {
+        const int eq = seg.indexOf(QLatin1Char('='));
+        if (eq > 0) {
+            kfs.append(QJsonObject{{QStringLiteral("frame"), seg.left(eq).toInt()}, {QStringLiteral("value"), seg.mid(eq + 1)}});
+        }
+    }
+    return GatewayProtocol::successResponse(QStringLiteral("get_keyframes"), requestId, projectId(), timelineRevision(),
+        QJsonObject{{QStringLiteral("clip_id"), clipId}, {QStringLiteral("effect_row"), row}, {QStringLiteral("param"), pname},
+                    {QStringLiteral("raw"), raw}, {QStringLiteral("keyframes"), kfs}});
+}
