+QString GatewayService::handleListUiControls(const QString &requestId) const
+{
+    if (m_core == nullptr || m_core->window() == nullptr) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("list_ui_controls"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("ui_root_unavailable"),
+            QStringLiteral("MainWindow is not available.")
+        );
+    }
+
+    QJsonArray controls;
+    QSet<QWidget *> seenWidgets;
+    const QList<QObject *> roots = collectAutomationUiRoots(m_core->window());
+    for (QObject *root : roots) {
+        const auto widgets = root->findChildren<QWidget *>(QString(), Qt::FindChildrenRecursively);
+        for (QWidget *widget : widgets) {
+            if (widget == nullptr || seenWidgets.contains(widget)) {
+                continue;
+            }
+            if (supportedUiControlType(widget).isEmpty()) {
+                continue;
+            }
+            seenWidgets.insert(widget);
+            controls.push_back(serializeUiControl(widget));
+        }
+    }
+
+    return GatewayProtocol::successResponse(
+        QStringLiteral("list_ui_controls"),
+        requestId,
+        projectId(),
+        timelineRevision(),
+        QJsonObject{{QStringLiteral("controls"), controls}}
+    );
+}
