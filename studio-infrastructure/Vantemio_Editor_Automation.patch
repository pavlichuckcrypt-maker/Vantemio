+            QStringLiteral("timeline_unavailable"), QStringLiteral("Active timeline is not available."));
+    }
+    const int trackId = params.value(QStringLiteral("track_id")).toInt(-1);
+    const QString name = params.value(QStringLiteral("transition_name")).toString();
+    const double fps = m_core ? m_core->getCurrentFps() : 25.0;
+    const int pos = params.contains(QStringLiteral("position"))
+        ? params.value(QStringLiteral("position")).toInt()
+        : int(params.value(QStringLiteral("seconds")).toDouble() * fps);
+    const int length = params.value(QStringLiteral("duration")).toInt(25);
