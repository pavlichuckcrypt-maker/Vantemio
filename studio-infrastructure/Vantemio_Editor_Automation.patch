+GatewayService::GatewayService(Core *core, QObject *parent)
+    : QObject(parent)
+    , m_core(core)
+{
+    // VidRA AI native gateway transport. macOS builds have no D-Bus, so the
+    // gatewayCommand() entry point is unreachable that way. Optionally listen on
+    // a localhost TCP port (opt-in via KDENLIVE_GATEWAY_PORT). Newline-delimited
+    // JSON: one request object per line in, one response object per line out.
+    bool ok = false;
+    const int port = qEnvironmentVariableIntValue("KDENLIVE_GATEWAY_PORT", &ok);
+    if (!ok || port <= 0 || port > 65535) {
+        return;
+    }
+    auto *server = new QTcpServer(this);
+    if (!server->listen(QHostAddress::LocalHost, static_cast<quint16>(port))) {
+        qWarning() << "VidRA gateway: failed to listen on 127.0.0.1:" << port << "-" << server->errorString();
+        server->deleteLater();
+        return;
+    }
+    qInfo() << "VidRA gateway listening on 127.0.0.1:" << port;
+
+    // Heartbeat: таймер раз в секунду пишет epoch-мс в файл. Он тикает во время ЛЮБОГО
+    // processEvents-pump (сборка/рендер/waitProcessPumped исключают только сокет-нотификаторы,
+    // но НЕ таймеры), поэтому heartbeat остаётся свежим, пока главный поток жив и качает цикл.
+    // Реальный дедлок (без processEvents) → heartbeat протухает → watchdog видит истинный hang.
+    m_heartbeatPath = QStringLiteral("/tmp/vidra_gateway_heartbeat_%1").arg(port);
+    auto *hbTimer = new QTimer(this);
+    hbTimer->setInterval(1000);
+    connect(hbTimer, &QTimer::timeout, this, [this]() {
+        QFile f(m_heartbeatPath);
+        if (f.open(QIODevice::WriteOnly | QIODevice::Truncate)) {
+            f.write(QByteArray::number(QDateTime::currentMSecsSinceEpoch()));
+            f.close();
+        }
+    });
+    hbTimer->start();
+
+    connect(server, &QTcpServer::newConnection, this, [this, server]() {
+        while (server->hasPendingConnections()) {
+            QTcpSocket *sock = server->nextPendingConnection();
+            auto buffer = std::make_shared<QByteArray>();
+            m_gwBuffers.insert(sock, buffer);
+            connect(sock, &QTcpSocket::readyRead, this, [this, sock, buffer]() {
+                buffer->append(sock->readAll());
+                // Анти-DoS: клиент, шлющий данные без '\n', растил бы буфер безгранично.
+                // Одна команда gateway — это строка JSON; 16 МБ с запасом. Иначе рвём связь.
+                if (buffer->size() > 16 * 1024 * 1024) {
+                    sock->write("{\"status\":\"error\",\"errors\":[{\"code\":\"payload_too_large\"}]}\n");
+                    sock->flush();
+                    sock->disconnectFromHost();
+                    buffer->clear();
+                    return;
+                }
+                // ГЕЙТ РЕКУРСИИ: если разбор команд уже идёт (мы внутри pump текущей
+                // команды — повторная доставка через canReadNotification/posted QEvent),
+                // НЕ вызываем handleCommand вложенно. Данные уже в буфере; сокет
+                // помечаем — внешний dispatchSocket доразберёт его после текущей команды.
+                if (m_dispatchBusy) {
+                    m_dirtySockets.insert(sock);
+                    return;
+                }
+                dispatchSocket(sock, buffer);
+            });
+            connect(sock, &QTcpSocket::disconnected, this, [this, sock]() {
+                m_subscribers.remove(sock);
+                m_gwBuffers.remove(sock);
+                m_dirtySockets.remove(sock);
+                if (m_currentSocket == sock) {
+                    m_currentSocket = nullptr;
+                }
+                sock->deleteLater();
+            });
+        }
+    });
+}
+
+void GatewayService::dispatchSocket(QTcpSocket *sock, const std::shared_ptr<QByteArray> &buffer)
+{
+    // Разбор строк-команд одного сокета СТРОГО последовательно, без рекурсии.
+    // handleCommand может качать event loop (вставка ждёт продюсер и т.п.) — на это
+    // время m_dispatchBusy отводит повторные readyRead в m_dirtySockets.
+    m_dispatchBusy = true;
+    const QPointer<QTcpSocket> guard(sock);
+    int newlineIndex;
+    while (guard && (newlineIndex = buffer->indexOf('\n')) >= 0) {
+        const QByteArray line = buffer->left(newlineIndex);
+        buffer->remove(0, newlineIndex + 1);
+        if (line.trimmed().isEmpty()) {
+            continue;
+        }
+        m_currentSocket = sock;
+        const QString response = handleCommand(QString::fromUtf8(line));
+        m_currentSocket = nullptr;
+        // Клиент мог оборваться, пока команда качала цикл — QPointer ловит удаление.
+        if (guard && guard->state() == QAbstractSocket::ConnectedState) {
+            guard->write(response.toUtf8());
+            guard->write("\n");
+            guard->flush();
+        }
+    }
+    m_dispatchBusy = false;
+    // Сокеты, чьи readyRead пришлись на время разбора, — доразобрать сейчас.
+    while (!m_dirtySockets.isEmpty()) {
+        QTcpSocket *next = *m_dirtySockets.begin();
+        m_dirtySockets.remove(next);
+        const auto nextBuffer = m_gwBuffers.value(next);
+        if (nextBuffer) {
+            dispatchSocket(next, nextBuffer);
+        }
+    }
+    // Всё разобрано — если за это время накопились отложенные мутации, слить их.
+    drainJobs();
+}
+
+void GatewayService::enqueueJob(std::function<void()> job)
+{
+    // Отложенная мутация. НЕ invokeMethod(QueuedConnection): posted MetaCall исполнился
+    // бы внутри ЛЮБОГО processEvents-pump (ExcludeSocketNotifiers его не фильтрует) —
+    // это и была вложенная гонка. Таймер безопасен: его тики во время pump упираются
+    // в гейты drainJobs и просто повторяются, пока не окажемся на верхнем уровне.
+    m_jobQueue.append(std::move(job));
+    if (m_jobTimer == nullptr) {
+        m_jobTimer = new QTimer(this);
+        m_jobTimer->setInterval(30);
+        connect(m_jobTimer, &QTimer::timeout, this, [this]() { drainJobs(); });
+    }
+    m_jobTimer->start();
+}
+
+void GatewayService::drainJobs(bool fromDispatch)
+{
+    // Исполнять мутации можно только когда никакая другая операция не в середине:
+    // ни job (вложенность), ни разбор команды (кроме осознанного вызова из
+    // handleCommand/dispatchSocket, где модель в консистентном состоянии).
+    if (m_jobActive) {
+        return;
+    }
+    if (!fromDispatch && m_dispatchBusy) {
+        return;
+    }
+    m_jobActive = true;
+    while (!m_jobQueue.isEmpty()) {
+        const std::function<void()> job = m_jobQueue.takeFirst();
+        job();
+    }
+    m_jobActive = false;
+    if (m_jobTimer != nullptr) {
+        m_jobTimer->stop();
+    }
+}
+
+bool GatewayService::waitProcessPumped(QProcess &proc, int timeoutMs, const QString &opName) const
+{
+    // Ждём завершения дочернего процесса, НЕ замораживая главный Qt event loop:
+    // качаем события (включая сокеты), чтобы gateway продолжал отвечать на ping и
+    // read-only интроспекцию, пока ffmpeg/ffprobe/python работают 15-30с. На это время
+    // ставим m_gwBusy — гейт реентрантности в handleCommand отбивает МУТИРУЮЩИЕ команды
+    // (gateway_busy), поэтому обработка сокетов во время pump безопасна.
+    // Возвращает true, если процесс завершился сам; false — если вышел таймаут (тогда
+    // процесс убит здесь же). Флаги busy восстанавливаются на выходе (поддержка вложенности).
+    const bool prevBusy = m_gwBusy;
+    const QString prevAction = m_gwBusyAction;
+    m_gwBusy = true;
+    m_gwBusyAction = opName;
+    QElapsedTimer timer;
+    timer.start();
+    bool finished = true;
+    while (proc.state() != QProcess::NotRunning) {
+        if (timeoutMs > 0 && timer.elapsed() > timeoutMs) {
+            proc.kill();
+            proc.waitForFinished(2000);
+            finished = false;
+            break;
+        }
+        // Прокачиваем очередь событий БЕЗ сокет-нотификаторов (как все прочие pump-циклы
+        // файла). AllEvents был опасен: при обрыве клиента во время операции processEvents
+        // выполнял отложенный sock->deleteLater(), а внешний readyRead-кадр затем писал в
+        // уже удалённый сокет (use-after-free) + реентрантно портил общий буфер команд.
+        // Тишину порта на время операции прикрывает grace-окно watchdog'а (period*grace).
+        QCoreApplication::processEvents(QEventLoop::ExcludeSocketNotifiers, 50);
+        proc.waitForFinished(30);
+    }
+    m_gwBusy = prevBusy;
+    m_gwBusyAction = prevAction;
+    return finished;
+}
+
+QString GatewayService::handleCommand(const QString &payloadJson)
+{
+    const GatewayRequest request = GatewayProtocol::parseRequest(payloadJson);
+    if (request.action.isEmpty() || request.action == QStringLiteral("invalid_request")) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("invalid_request"),
+            request.requestId,
+            request.projectId,
+            timelineRevision(),
+            QStringLiteral("invalid_request"),
+            QStringLiteral("Request payload is not a valid JSON gateway command.")
+        );
+    }
+
+    // ЛИЦЕНЗИОННЫЙ ГЕЙТ: без активации доступны только интроспекция и activate.
+    // Монтаж/эффекты/рендер/AI/обновление требуют валидной лицензии.
+    if (request.action == QStringLiteral("license_status")) {
+        return handleLicenseStatus(request.requestId);
+    }
+    if (request.action == QStringLiteral("activate")) {
+        return handleActivate(request.requestId, request.params);
+    }
+    // Гейт ВЫКЛЮЧЕН по умолчанию (никаких ограничений для мозга). Включается
+    // осознанно при продаже: env VIDRA_ENFORCE_LICENSE=1. Код активации готов,
+    // но сейчас не мешает автоматизации.
+    if (qgetenv("VIDRA_ENFORCE_LICENSE") == QByteArrayLiteral("1") && !gw_isFreeAction(request.action)) {
+        QJsonObject licInfo;
+        if (!gw_isActivated(licInfo)) {
+            return GatewayProtocol::errorResponse(
+                request.action, request.requestId, projectId(), timelineRevision(),
+                QStringLiteral("license_required"),
+                QStringLiteral("VidRA AI не активирована. Выполни activate{key} (онлайн-активация). Интроспекция доступна без ключа.")
+            );
+        }
+    }
+
+    // ГЕЙТ РЕЕНТРАНТНОСТИ build_montage: пока асинхронный батч build_montage крутит
+    // processEvents(ExcludeSocketNotifiers) в цикле ожидания готовности клипов, уже
+    // ПРИНЯТЫЕ в TCP-буфер команды (напр. save_project, отправленный сразу вслед за
+    // build_montage — так делает brain_montage_executor.py) всё равно доставляются
+    // повторно через canReadNotification()/posted QEvent и РЕКУРСИВНО вызывают
+    // handleCommand() на этом же потоке. save_project → saveFile() →
+    // updateCacheThumbnail() → getThumbFrame() берёт read-lock на producer клипа,
+    // который build_montage в этот момент ещё строит (write-lock) на ТОМ ЖЕ потоке —
+    // получаем самодедлок: гейтвей вешается насмерть, ping не отвечает даже после
+    // конца build_montage, потому что поток так и остаётся в этом заблокированном
+    // кадре стека. Чиним не позволяя МУТИРУЮЩИМ командам исполниться, пока идёт
+    // батч — read-only интроспекция (ping/capabilities/get_*/list_*) по-прежнему
+    // разрешена и отрабатывает мгновенно, так что снаружи гейтвей выглядит живым.
+    if (m_buildMontageBusy && !gw_isFreeAction(request.action)) {
+        return GatewayProtocol::errorResponse(
+            request.action, request.requestId, projectId(), timelineRevision(),
+            QStringLiteral("gateway_busy"),
+            QStringLiteral("build_montage ещё выполняется (батч клипов). Дождись события montage.done/montage.failed, затем повтори команду.")
+        );
+    }
+
+    // ГЕЙТ РЕЕНТРАНТНОСТИ create_project: тот же самодедлок-риск, что и у build_montage
+    // (см. комментарий выше и m_createProjectBusy в gatewayservice.h) — пока асинхронный
+    // create_project крутит processEvents(ExcludeSocketNotifiers) в ожидании newFile()/
+    // готовности таймлайна, уже принятые в TCP-буфере МУТИРУЮЩИЕ команды (в т.ч. повторный
+    // create_project/build_montage, которые клиент вправе прислать сразу вслед, не дождавшись
+    // project.created) иначе выполнились бы рекурсивно на этом же потоке поверх документа,
+    // который ещё не готов. read-only (gw_isFreeAction) по-прежнему проходит.
+    if (m_createProjectBusy && !gw_isFreeAction(request.action)) {
+        return GatewayProtocol::errorResponse(
+            request.action, request.requestId, projectId(), timelineRevision(),
+            QStringLiteral("gateway_busy"),
+            QStringLiteral("create_project ещё выполняется. Дождись события project.created/project.failed, затем повтори команду.")
+        );
+    }
+
+    // ГЕЙТ РЕЕНТРАНТНОСТИ синхронных дочерних процессов: пока waitProcessPumped() качает
+    // event loop (чтобы ping/интроспекция жили во время ffmpeg/ffprobe/python), уже
+    // принятые в TCP-буфер МУТИРУЮЩИЕ команды могли бы рекурсивно вызвать handleCommand()
+    // и поменять таймлайн на том же потоке в середине операции. Блокируем их тем же
+    // способом; read-only (gw_isFreeAction) проходит и держит gateway живым для ping.
+    if (m_gwBusy && !gw_isFreeAction(request.action)) {
+        return GatewayProtocol::errorResponse(
+            request.action, request.requestId, projectId(), timelineRevision(),
+            QStringLiteral("gateway_busy"),
+            QStringLiteral("Gateway занят операцией '%1' (дочерний процесс). Повтори команду через момент.").arg(m_gwBusyAction)
+        );
+    }
+
+    // ГЕЙТ ОЧЕРЕДИ МУТАЦИЙ: пока drainJobs исполняет отложенную мутацию (insert_clip
+    // pending / insert_sequence / build_montage / create_project / restore_checkpoint),
+    // модель может быть в середине операции — новые мутирующие команды отбиваем;
+    // read-only проходит (ping/интроспекция живы, как и при прочих busy).
+    if (m_jobActive && !gw_isFreeAction(request.action)) {
+        return GatewayProtocol::errorResponse(
+            request.action, request.requestId, projectId(), timelineRevision(),
+            QStringLiteral("gateway_busy"),
+            QStringLiteral("Идёт отложенная мутация из очереди гейтвея. Повтори команду через момент.")
+        );
+    }
+    // FIFO: если в очереди ждут отложенные мутации, новая ПРЯМАЯ мутация обязана
+    // исполниться ПОСЛЕ них (иначе add_track/save_project обгоняют pending-вставки —
+    // источник «V1 неполон» и track_not_found). Сливаем очередь здесь: мы в команде,
+    // модель консистентна. build_montage/create_project сюда не доходят — их
+    // собственные busy-гейты выше уже вернули gateway_busy.
+    if (!m_jobQueue.isEmpty() && !gw_isFreeAction(request.action)) {
+        drainJobs(true);
+    }
+
+    // ГЕЙТ качающих-цикл ЧИТАТЕЛЕЙ во время async-мутации. Часть read-команд (get_frames и
+    // др.) сами крутят processEvents для захвата кадров; будучи «free», они проходят гейты
+    // выше, но их pump выполнил бы отложенную мутацию/обработку ПОСРЕДИ чтения модели
+    // (мутация таймлайна под итерацией) → крэш/мусор. Пока идёт async-работа — отбиваем.
+    if (m_buildMontageBusy || m_createProjectBusy || m_jobActive || m_gwBusy) {
+        static const QSet<QString> gwPumpingReaders{
+            QStringLiteral("get_frames"), QStringLiteral("get_thumbnail_strip"),
+            QStringLiteral("render_and_analyze"), QStringLiteral("inspect_motion"),
+            QStringLiteral("lint_timeline"), QStringLiteral("compare_frames"),
+            QStringLiteral("observe"), QStringLiteral("describe_frame")
+        };
+        if (gwPumpingReaders.contains(request.action)) {
+            return GatewayProtocol::errorResponse(
+                request.action, request.requestId, projectId(), timelineRevision(),
+                QStringLiteral("gateway_busy"),
+                QStringLiteral("Идёт async-сборка — команда с захватом кадров недоступна. Повтори после montage.done/project.created.")
+            );
+        }
+    }
+
+    // Журнал операций (для get_history): пишем КАЖДОЕ действие. Кольцо на 200.
+    m_history.append(QJsonObject{
+        {QStringLiteral("action"), request.action},
+        {QStringLiteral("request_id"), request.requestId},
+        {QStringLiteral("ts"), QDateTime::currentMSecsSinceEpoch()},
+    });
+    while (m_history.size() > 200) m_history.removeFirst();
