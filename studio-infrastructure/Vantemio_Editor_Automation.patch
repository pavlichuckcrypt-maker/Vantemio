+QJsonObject serializeLibraryTreeItem(const QTreeWidgetItem *item)
+{
+    QJsonObject result{
+        {QStringLiteral("name"), item != nullptr ? item->text(0) : QString()},
+        {QStringLiteral("path"), item != nullptr ? item->data(0, Qt::UserRole).toString() : QString()},
+        {QStringLiteral("item_type"), item != nullptr ? libraryItemTypeString(item->data(0, Qt::UserRole + 2).toInt()) : QStringLiteral("unknown")}
+    };
+    QJsonArray children;
+    if (item != nullptr) {
+        for (int i = 0; i < item->childCount(); ++i) {
+            children.push_back(serializeLibraryTreeItem(item->child(i)));
