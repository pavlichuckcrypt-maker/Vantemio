+QAction *findUiDockToggleAction(MainWindow *window, const QString &dockName)
+{
+    if (window == nullptr || dockName.trimmed().isEmpty()) {
+        return nullptr;
+    }
+    if (window->actionCollection() != nullptr) {
+        if (QAction *action = window->actionCollection()->action(dockName)) {
+            return action;
+        }
+    }
+    const QList<QAction *> actions = window->getExtraActions(QStringLiteral("interface"));
+    for (QAction *action : actions) {
+        if (action == nullptr) {
+            continue;
+        }
+        if (dockNameFromAction(action) == dockName) {
+            return action;
+        }
+    }
+    const QList<QAction *> runtimeActions = collectRuntimeUiActions(window);
+    for (QAction *action : runtimeActions) {
+        if (!isUiDockToggleAction(action)) {
+            continue;
+        }
+        if (dockNameFromAction(action) == dockName) {
+            return action;
+        }
+    }
+    return nullptr;
+}
