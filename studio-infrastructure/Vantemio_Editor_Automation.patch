+QString GatewayService::gw_checkpointDir() const
+{
+    return QStandardPaths::writableLocation(QStandardPaths::AppConfigLocation) + QStringLiteral("/vidra_checkpoints");
+}
+
+// checkpoint — сохранить снимок проекта (можно попробовать, потом откатить).
+QString GatewayService::handleCheckpoint(const QString &requestId, const QJsonObject &params)
+{
+    if (m_core == nullptr || m_core->projectManager() == nullptr) {
+        return GatewayProtocol::errorResponse(QStringLiteral("checkpoint"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("project_manager_unavailable"), QStringLiteral("ProjectManager is not available."));
+    }
+    QString name = params.value(QStringLiteral("name")).toString().trimmed();
+    if (name.isEmpty()) name = QStringLiteral("cp_%1").arg(timelineRevision());
+    QDir().mkpath(gw_checkpointDir());
+    const QString path = gw_checkpointDir() + QLatin1Char('/') + name + QStringLiteral(".kdenlive");
+    const bool ok = m_core->projectManager()->saveFileAs(path, true, true); // saveACopy=true: не переключаем текущий проект
+    if (!ok) {
+        return GatewayProtocol::errorResponse(QStringLiteral("checkpoint"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("checkpoint_failed"), QStringLiteral("Не удалось сохранить чекпоинт."));
+    }
+    return GatewayProtocol::successResponse(QStringLiteral("checkpoint"), requestId, projectId(), timelineRevision(),
+        QJsonObject{{QStringLiteral("name"), name}, {QStringLiteral("path"), path}});
+}
+
+// restore — откатиться к ранее сохранённому чекпоинту. АСИНХРОННО: открытие проекта —
+// тяжёлая перезагрузка документа, синхронный ответ не доживает. Сразу pending →
+// перезагрузка в основном потоке → push checkpoint.restored.
+QString GatewayService::handleRestoreCheckpoint(const QString &requestId, const QJsonObject &params)
+{
+    const QString name = params.value(QStringLiteral("name")).toString().trimmed();
+    const QString path = gw_checkpointDir() + QLatin1Char('/') + name + QStringLiteral(".kdenlive");
+    if (name.isEmpty() || !QFileInfo::exists(path)) {
+        return GatewayProtocol::errorResponse(QStringLiteral("restore_checkpoint"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("checkpoint_not_found"), QStringLiteral("Нет чекпоинта с таким name (см. checkpoint_list)."));
+    }
+    const QString rid = requestId;
+    const QString cpName = name;
+    enqueueJob([this, path, rid, cpName]() {
+        if (m_core->currentDoc() != nullptr) {
+            m_core->currentDoc()->setModified(false);
+        }
+        m_core->projectManager()->openFile(QUrl::fromLocalFile(path));
+        // Дождаться ГОТОВНОСТИ таймлайна (как в create_project), иначе observe сразу
+        // после checkpoint.restored видит 0 клипов (гонка). ExcludeSocketNotifiers —
+        // чтобы тяжёлая загрузка не пускала повторную обработку команд (анти-обрыв).
+        QElapsedTimer tt; tt.start();
+        while (tt.elapsed() < 10000) {
+            auto m = currentTimelineModel();
+            if (m && m->getTracksCount() > 0 && m_core->currentDoc() != nullptr) break;
+            QCoreApplication::processEvents(QEventLoop::ExcludeSocketNotifiers, 50);
+        }
+        // Небольшая доводка, чтобы клипы/продюсеры точно встали.
+        QElapsedTimer st; st.start();
+        while (st.elapsed() < 400) QCoreApplication::processEvents(QEventLoop::ExcludeSocketNotifiers, 60);
+        ++m_timelineRevision;
+        QJsonObject ev{
+            {QStringLiteral("kind"), QStringLiteral("event")},
+            {QStringLiteral("request_id"), rid},
+            {QStringLiteral("event"), QStringLiteral("checkpoint.restored")},
+            {QStringLiteral("name"), cpName},
+            {QStringLiteral("path"), path},
+        };
+        pushEvent(ev);
+    });
+    return GatewayProtocol::successResponse(QStringLiteral("restore_checkpoint"), requestId, projectId(), timelineRevision(),
+        QJsonObject{{QStringLiteral("status_detail"), QStringLiteral("pending")}, {QStringLiteral("name"), name},
+                    {QStringLiteral("note"), QStringLiteral("Перезагрузка проекта асинхронна. subscribe_events → жди checkpoint.restored.")}});
+}
+
+QString GatewayService::handleCheckpointList(const QString &requestId) const
+{
+    QJsonArray arr;
+    QDir d(gw_checkpointDir());
+    const QFileInfoList files = d.entryInfoList(QStringList{QStringLiteral("*.kdenlive")}, QDir::Files, QDir::Time);
+    for (const QFileInfo &fi : files) {
+        arr.append(QJsonObject{{QStringLiteral("name"), fi.completeBaseName()}, {QStringLiteral("path"), fi.absoluteFilePath()}});
+    }
+    return GatewayProtocol::successResponse(QStringLiteral("checkpoint_list"), requestId, projectId(), timelineRevision(),
+        QJsonObject{{QStringLiteral("count"), arr.size()}, {QStringLiteral("checkpoints"), arr}});
+}
+
+// ============================================================================
+// ПОЗИЦИОННЫЕ / ЗОННЫЕ КОМАНДЫ: ставить эффект/переход в конкретные места видео.
+// ДОБАВЛЕНЫ как новые функции — apply_effect (на весь клип) и всё остальное
+// остаётся доступным. Позиция принимается в кадрах (position) или секундах (seconds).
+// ============================================================================
+
+// find_clip_at — какой клип на дорожке в данной точке времени.
+QString GatewayService::handleFindClipAt(const QString &requestId, const QJsonObject &params)
+{
+    auto tl = currentTimelineModel();
+    if (!tl) {
+        return GatewayProtocol::errorResponse(QStringLiteral("find_clip_at"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("timeline_unavailable"), QStringLiteral("Active timeline is not available."));
+    }
+    const int trackId = params.value(QStringLiteral("track_id")).toInt(-1);
+    const double fps = m_core ? m_core->getCurrentFps() : 25.0;
+    const int pos = params.contains(QStringLiteral("position"))
+        ? params.value(QStringLiteral("position")).toInt()
+        : int(params.value(QStringLiteral("seconds")).toDouble() * fps);
+    if (!tl->isTrack(trackId)) {
+        return GatewayProtocol::errorResponse(QStringLiteral("find_clip_at"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("track_not_found"), QStringLiteral("find_clip_at требует валидный track_id."));
+    }
+    const int clipId = tl->getClipByPosition(trackId, pos);
+    if (clipId < 0) {
+        return GatewayProtocol::successResponse(QStringLiteral("find_clip_at"), requestId, projectId(), timelineRevision(),
+            QJsonObject{{QStringLiteral("found"), false}, {QStringLiteral("track_id"), trackId}, {QStringLiteral("position"), pos}});
+    }
+    const int start = tl->getClipPosition(clipId);
+    return GatewayProtocol::successResponse(QStringLiteral("find_clip_at"), requestId, projectId(), timelineRevision(),
+        QJsonObject{{QStringLiteral("found"), true}, {QStringLiteral("clip_id"), clipId}, {QStringLiteral("bin_id"), tl->getClipBinId(clipId)},
+                    {QStringLiteral("track_id"), trackId}, {QStringLiteral("clip_start"), start}, {QStringLiteral("clip_duration"), tl->getClipPlaytime(clipId)},
+                    {QStringLiteral("offset_in_clip"), pos - start}});
+}
+
+// apply_effect_at — найти клип в точке времени и наложить эффект (на весь клип).
+QString GatewayService::handleApplyEffectAt(const QString &requestId, const QJsonObject &params)
+{
+    auto tl = currentTimelineModel();
+    if (!tl) {
+        return GatewayProtocol::errorResponse(QStringLiteral("apply_effect_at"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("timeline_unavailable"), QStringLiteral("Active timeline is not available."));
+    }
+    const int trackId = params.value(QStringLiteral("track_id")).toInt(-1);
+    const double fps = m_core ? m_core->getCurrentFps() : 25.0;
+    const int pos = params.contains(QStringLiteral("position"))
+        ? params.value(QStringLiteral("position")).toInt()
+        : int(params.value(QStringLiteral("seconds")).toDouble() * fps);
+    const int clipId = tl->isTrack(trackId) ? tl->getClipByPosition(trackId, pos) : -1;
+    if (clipId < 0) {
+        return GatewayProtocol::errorResponse(QStringLiteral("apply_effect_at"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("no_clip_at_position"), QStringLiteral("Нет клипа в этой точке (track_id+position/seconds)."));
+    }
+    return handleApplyEffect(requestId, clipId, params.value(QStringLiteral("effect_name")).toString(),
+        QString::fromUtf8(QJsonDocument(params.value(QStringLiteral("params")).toObject()).toJson(QJsonDocument::Compact)));
+}
+
+// apply_effect_zones — НОВАЯ ФУНКЦИЯ: наложить эффект ТОЛЬКО на выбранные участки
+// клипа (можно несколько сразу). zones: [{in,out} в кадрах ИЛИ {start_sec,end_sec}].
+// Эффект появляется именно в этих местах, не на весь клип. apply_effect (на весь) остаётся.
+QString GatewayService::handleApplyEffectZones(const QString &requestId, const QJsonObject &params)
+{
+    auto tl = currentTimelineModel();
+    auto controller = currentController();
+    const int clipId = params.value(QStringLiteral("clip_id")).toInt(-1);
+    const QString effectName = params.value(QStringLiteral("effect_name")).toString();
+    if (!tl || controller == nullptr || !tl->isClip(clipId)) {
+        return GatewayProtocol::errorResponse(QStringLiteral("apply_effect_zones"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("clip_not_found"), QStringLiteral("Нет клипа с таким clip_id."));
+    }
+    if (!EffectsRepository::get()->exists(effectName)) {
+        return GatewayProtocol::errorResponse(QStringLiteral("apply_effect_zones"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("effect_not_found"), QStringLiteral("Нет эффекта с таким effect_name (см. list_all_effects)."));
+    }
+    const QJsonArray zones = params.value(QStringLiteral("zones")).toArray();
+    if (zones.isEmpty()) {
+        return GatewayProtocol::errorResponse(QStringLiteral("apply_effect_zones"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("empty_zones"), QStringLiteral("zones:[{in,out}|{start_sec,end_sec}] — хотя бы один участок."));
+    }
+    const double fps = m_core ? m_core->getCurrentFps() : 25.0;
+    const QJsonObject pobj = params.value(QStringLiteral("params")).toObject();
+    QList<QPair<QString, QString>> kv;
+    for (auto it = pobj.constBegin(); it != pobj.constEnd(); ++it) {
+        kv.append({it.key(), it.value().isString() ? it.value().toString() : QString::number(it.value().toDouble())});
+    }
+    QJsonArray applied;
+    for (const QJsonValue &zv : zones) {
+        const QJsonObject z = zv.toObject();
+        const int in = z.contains(QStringLiteral("in")) ? z.value(QStringLiteral("in")).toInt()
+                                                        : int(z.value(QStringLiteral("start_sec")).toDouble() * fps);
+        const int out = z.contains(QStringLiteral("out")) ? z.value(QStringLiteral("out")).toInt()
+                                                         : int(z.value(QStringLiteral("end_sec")).toDouble() * fps);
+        controller->addEffectToClip(effectName, clipId);
+        std::shared_ptr<EffectStackModel> stack = tl->getClipEffectStackModel(clipId);
+        if (!stack || stack->rowCount() == 0) {
+            continue;
+        }
+        const int row = stack->rowCount() - 1;
+        std::shared_ptr<EffectItemModel> eff = gw_safeEffectRow(stack, row);
+        if (!eff) {
+            continue;
+        }
+        for (const auto &p : kv) {
+            eff->setParameter(p.first, p.second, true);
+        }
+        // ограничить эффект зоной [in,out] — он действует ТОЛЬКО на этом участке
+        eff->setInOut(effectName, qMakePair(in, out), true, true);
+        applied.append(QJsonObject{{QStringLiteral("effect_row"), row}, {QStringLiteral("in"), in}, {QStringLiteral("out"), out}});
+    }
+    // Если НИ ОДНА зона не наложилась (эффект несовместим с клипом, стек пуст и т.п.) —
+    // это провал, а не успех с zones_applied:0. Иначе мозг считает эффект наложенным.
+    if (applied.isEmpty()) {
+        return GatewayProtocol::errorResponse(QStringLiteral("apply_effect_zones"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("apply_effect_zones_failed"),
+            QStringLiteral("Ни одна зона не наложена (эффект несовместим с клипом или стек пуст)."));
+    }
+    ++m_timelineRevision;
+    return GatewayProtocol::successResponse(QStringLiteral("apply_effect_zones"), requestId, projectId(), timelineRevision(),
+        QJsonObject{{QStringLiteral("clip_id"), clipId}, {QStringLiteral("effect_name"), effectName},
+                    {QStringLiteral("zones_applied"), applied.size()}, {QStringLiteral("applied"), applied}});
+}
+
+// set_effect_zone — изменить участок, на котором действует УЖЕ наложенный эффект
+// (двигать/растягивать зону). zone в кадрах {in,out} или секундах {start_sec,end_sec}.
+QString GatewayService::handleSetEffectZone(const QString &requestId, const QJsonObject &params)
+{
+    auto tl = currentTimelineModel();
+    const int clipId = params.value(QStringLiteral("clip_id")).toInt(-1);
+    if (!tl || !tl->isClip(clipId)) {
+        return GatewayProtocol::errorResponse(QStringLiteral("set_effect_zone"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("clip_not_found"), QStringLiteral("Нет клипа с таким clip_id."));
+    }
+    std::shared_ptr<EffectStackModel> stack = tl->getClipEffectStackModel(clipId);
+    const int row = params.value(QStringLiteral("effect_row")).toInt(-1);
+    std::shared_ptr<EffectItemModel> eff = gw_safeEffectRow(stack, row);
+    if (!eff) {
+        return GatewayProtocol::errorResponse(QStringLiteral("set_effect_zone"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("effect_not_found"), QStringLiteral("Нет эффекта в этой строке (см. list_effects)."));
+    }
+    const double fps = m_core ? m_core->getCurrentFps() : 25.0;
+    const bool enabled = params.value(QStringLiteral("enabled")).toBool(true); // false = снять ограничение (на весь клип)
+    const int in = params.contains(QStringLiteral("in")) ? params.value(QStringLiteral("in")).toInt()
+                                                         : int(params.value(QStringLiteral("start_sec")).toDouble() * fps);
+    const int out = params.contains(QStringLiteral("out")) ? params.value(QStringLiteral("out")).toInt()
+                                                          : int(params.value(QStringLiteral("end_sec")).toDouble() * fps);
+    eff->setInOut(eff->getAssetId(), qMakePair(in, out), enabled, true);
+    ++m_timelineRevision;
+    return GatewayProtocol::successResponse(QStringLiteral("set_effect_zone"), requestId, projectId(), timelineRevision(),
+        QJsonObject{{QStringLiteral("clip_id"), clipId}, {QStringLiteral("effect_row"), row},
+                    {QStringLiteral("in"), in}, {QStringLiteral("out"), out}, {QStringLiteral("zoned"), enabled}});
+}
+
+// set_effect_enabled — включить/выключить отдельный эффект (не удаляя).
+QString GatewayService::handleSetEffectEnabled(const QString &requestId, const QJsonObject &params)
+{
+    auto tl = currentTimelineModel();
+    const int clipId = params.value(QStringLiteral("clip_id")).toInt(-1);
+    if (!tl || !tl->isClip(clipId)) {
+        return GatewayProtocol::errorResponse(QStringLiteral("set_effect_enabled"), requestId, projectId(), timelineRevision(),
