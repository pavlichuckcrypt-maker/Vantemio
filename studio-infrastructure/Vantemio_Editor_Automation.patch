+QString GatewayService::handleMltSet(const QString &requestId, const QJsonObject &params)
+{
+    auto tl = currentTimelineModel();
+    Mlt::Tractor *tractor = tl ? tl->tractor() : nullptr;
+    const QString path = params.value(QStringLiteral("path")).toString();
+    const QString prop = params.value(QStringLiteral("property")).toString();
+    const QJsonValue jv = params.value(QStringLiteral("value"));
+    if (prop.isEmpty()) {
+        return GatewayProtocol::errorResponse(QStringLiteral("mlt_set"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("invalid_parameters"), QStringLiteral("mlt_set requires a property."));
+    }
+    // value обязан быть скаляром. Раньше объект/массив/null молча превращались в ""
+    // и ЗАТИРАЛИ свойство MLT пустотой с ответом status:ok (тихая порча грейда/перехода).
+    if (!(jv.isString() || jv.isDouble() || jv.isBool())) {
+        return GatewayProtocol::errorResponse(QStringLiteral("mlt_set"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("invalid_parameters"), QStringLiteral("mlt_set требует скалярный value (строка/число/булево)."));
+    }
+    const QString value = jv.isString() ? jv.toString() : (jv.isDouble() ? QString::number(jv.toDouble()) : (jv.toBool() ? QStringLiteral("1") : QStringLiteral("0")));
+    const bool ok = gw_withMltService(tractor, path, [&](Mlt::Properties &p) {
+        p.set(prop.toUtf8().constData(), value.toUtf8().constData());
+    });
+    if (!ok) {
+        return GatewayProtocol::errorResponse(QStringLiteral("mlt_set"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("path_not_found"), QStringLiteral("No MLT service matched the requested path."));
+    }
+    ++m_timelineRevision;
+    return GatewayProtocol::successResponse(QStringLiteral("mlt_set"), requestId, projectId(), timelineRevision(),
+        QJsonObject{{QStringLiteral("path"), path}, {QStringLiteral("property"), prop}, {QStringLiteral("value"), value}});
+}
+
+// ============================================================================
+// Современный слой автоматизации: batch, макросы/шаблоны (с подстановкой
+// переменных {{var}} и сохранением на диск), справка.
+// ============================================================================
+namespace {
+
+QJsonValue gw_substituteVars(const QJsonValue &value, const QJsonObject &vars)
+{
+    if (value.isString()) {
+        QString s = value.toString();
+        // Если значение целиком "{{key}}" — подставляем с сохранением типа.
+        if (s.startsWith(QStringLiteral("{{")) && s.endsWith(QStringLiteral("}}"))) {
+            const QString key = s.mid(2, s.size() - 4).trimmed();
+            if (vars.contains(key)) {
+                return vars.value(key);
+            }
+        }
+        // Иначе — текстовая замена всех вхождений {{key}}.
+        for (auto it = vars.constBegin(); it != vars.constEnd(); ++it) {
+            const QString token = QStringLiteral("{{") + it.key() + QStringLiteral("}}");
+            if (s.contains(token)) {
+                const QJsonValue v = it.value();
+                const QString repl = v.isString() ? v.toString()
+                    : (v.isDouble() ? QString::number(v.toDouble())
+                    : (v.isBool() ? (v.toBool() ? QStringLiteral("true") : QStringLiteral("false")) : QString()));
+                s.replace(token, repl);
+            }
+        }
+        return s;
+    }
+    if (value.isObject()) {
+        QJsonObject obj = value.toObject();
+        QJsonObject out;
+        for (auto it = obj.constBegin(); it != obj.constEnd(); ++it) {
+            out.insert(it.key(), gw_substituteVars(it.value(), vars));
+        }
+        return out;
+    }
+    if (value.isArray()) {
+        const QJsonArray arr = value.toArray();
+        QJsonArray out;
+        for (const QJsonValue &v : arr) {
+            out.append(gw_substituteVars(v, vars));
+        }
+        return out;
+    }
+    return value;
+}
+
+} // namespace
