+// explain_error — код ошибки → объяснение + предложенная команда-исправление.
+QString GatewayService::handleExplainError(const QString &requestId, const QJsonObject &params) const
+{
+    const QString code = params.value(QStringLiteral("code")).toString();
+    static const QHash<QString, QPair<QString, QString>> kb{
+        {QStringLiteral("clip_not_found"), {QStringLiteral("Нет клипа таймлайна с таким clip_id."), QStringLiteral("get_full_state / list_tracks → возьми актуальный clip_id.")}},
+        {QStringLiteral("track_not_found"), {QStringLiteral("Нет дорожки с таким track_id."), QStringLiteral("list_tracks → выбери track_id; add_track если нужна новая.")}},
+        {QStringLiteral("effect_not_found"), {QStringLiteral("Нет эффекта с таким именем."), QStringLiteral("list_all_effects / describe_effect{effect_name} — точное id (напр. brightness, не frei0r.brightness).")}},
+        {QStringLiteral("transition_not_found"), {QStringLiteral("Нет перехода с таким именем."), QStringLiteral("list_all_transitions → точное id.")}},
+        {QStringLiteral("file_not_found"), {QStringLiteral("Файл не существует/недоступен."), QStringLiteral("Проверь путь; probe_media для свойств.")}},
+        {QStringLiteral("clip_insertion_failed"), {QStringLiteral("Не удалось вставить клип (перекрытие/позиция?)."), QStringLiteral("Освободи позицию или get_timeline_summary для свободного места.")}},
+        {QStringLiteral("license_required"), {QStringLiteral("Функция требует активации."), QStringLiteral("activate{key} (онлайн-активация).")}},
+        {QStringLiteral("resize_failed"), {QStringLiteral("Не удалось изменить длительность (упор в сосед/границу)."), QStringLiteral("delete_range/освободи место рядом или меняй from_right.")}},
+        {QStringLiteral("crossfade_failed"), {QStringLiteral("Нет соседнего клипа впритык для перехода."), QStringLiteral("Поставь клипы встык (insert_sequence) затем crossfade.")}},
+        {QStringLiteral("speed_failed"), {QStringLiteral("Не удалось изменить скорость."), QStringLiteral("Проверь, что клип не упирается в соседа; освободи место.")}},
+    };
+    if (!kb.contains(code)) {
+        return GatewayProtocol::successResponse(QStringLiteral("explain_error"), requestId, projectId(), timelineRevision(),
+            QJsonObject{{QStringLiteral("code"), code}, {QStringLiteral("known"), false},
+                        {QStringLiteral("explanation"), QStringLiteral("Нет описания для этого кода — см. errors[].message в ответе команды.")}});
+    }
+    return GatewayProtocol::successResponse(QStringLiteral("explain_error"), requestId, projectId(), timelineRevision(),
+        QJsonObject{{QStringLiteral("code"), code}, {QStringLiteral("known"), true},
+                    {QStringLiteral("explanation"), kb.value(code).first}, {QStringLiteral("suggestion"), kb.value(code).second}});
+}
