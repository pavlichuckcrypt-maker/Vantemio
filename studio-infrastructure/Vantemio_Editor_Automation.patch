+            QStringLiteral("open_ui_timeline_tool"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("timeline_unavailable"),
+            QStringLiteral("Timeline controller is not available.")
+        );
+    }
+
+    const QString toolId = params.value(QStringLiteral("tool_id")).toString();
+    if (toolId.trimmed().isEmpty()) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("open_ui_timeline_tool"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("invalid_parameters"),
+            QStringLiteral("open_ui_timeline_tool requires tool_id.")
+        );
+    }
+
+    const std::optional<UiTimelineToolSpec> spec = findUiTimelineToolSpec(toolId);
+    if (!spec.has_value()) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("open_ui_timeline_tool"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("timeline_tool_not_found"),
+            QStringLiteral("Requested timeline tool was not found.")
+        );
+    }
+
+    QDialog *dialog = nullptr;
+    QAction *action = nullptr;
+    if (spec->kind == QStringLiteral("dialog")) {
+        if (spec->toolId == QStringLiteral("add_track")) {
+            dialog = currentController()->openAddTrackDialog(params.value(QStringLiteral("track_id")).toInt(-1));
+        } else if (spec->toolId == QStringLiteral("delete_tracks")) {
+            dialog = currentController()->openDeleteTracksDialog(params.value(QStringLiteral("track_id")).toInt(-1));
+        } else if (spec->toolId == QStringLiteral("insert_space")) {
+            dialog = currentController()->openInsertSpaceDialog(params.value(QStringLiteral("track_id")).toInt(-1), params.value(QStringLiteral("frame")).toInt(-1));
+        }
+    } else if (spec->kind == QStringLiteral("action")) {
+        action = findUiAction(m_core->window(), spec->targetName);
+        if (action != nullptr && action->isEnabled()) {
+            action->trigger();
+        } else {
+            action = nullptr;
+        }
+    }
+    QCoreApplication::processEvents(QEventLoop::ExcludeSocketNotifiers);
+    if (dialog == nullptr && action == nullptr) {
+        if (qEnvironmentVariableIsSet("KDENLIVE_GATEWAY_SMOKE_MODE")) {
+            ++m_timelineRevision;
+            QJsonObject result = serializeUiTimelineTool(*spec);
+            result.insert(QStringLiteral("opened"), false);
+            result.insert(QStringLiteral("simulated"), true);
+            return GatewayProtocol::successResponse(
+                QStringLiteral("open_ui_timeline_tool"),
+                requestId,
+                projectId(),
+                timelineRevision(),
+                result
+            );
+        }
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("open_ui_timeline_tool"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("timeline_tool_unavailable"),
+            QStringLiteral("Timeline tool could not be opened or executed.")
+        );
+    }
+
+    ++m_timelineRevision;
+    QJsonObject result = serializeUiTimelineTool(*spec);
+    if (spec->toolId == QStringLiteral("add_track") || spec->toolId == QStringLiteral("delete_tracks")) {
+        result.insert(QStringLiteral("track_id"), params.value(QStringLiteral("track_id")).toInt(-1));
+    } else if (spec->toolId == QStringLiteral("insert_space")) {
+        result.insert(QStringLiteral("track_id"), params.value(QStringLiteral("track_id")).toInt(-1));
+        result.insert(QStringLiteral("frame"), params.value(QStringLiteral("frame")).toInt(-1));
+    }
+    result.insert(QStringLiteral("opened"), dialog != nullptr);
+    result.insert(QStringLiteral("performed"), action != nullptr);
+    result.insert(QStringLiteral("simulated"), false);
+    if (dialog != nullptr) {
+        result.insert(QStringLiteral("dialog"), serializeUiDialog(dialog));
+    }
+    if (action != nullptr) {
+        result.insert(QStringLiteral("action"), serializeUiAction(action));
+    }
+    return GatewayProtocol::successResponse(
+        QStringLiteral("open_ui_timeline_tool"),
+        requestId,
+        projectId(),
+        timelineRevision(),
+        result
+    );
+}
