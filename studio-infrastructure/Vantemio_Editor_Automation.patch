+// list_bin — что уже импортировано в проект (bin-клипы).
+QString GatewayService::handleListBin(const QString &requestId) const
+{
+    if (m_core == nullptr || m_core->projectItemModel() == nullptr) {
+        return GatewayProtocol::errorResponse(QStringLiteral("list_bin"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("no_project"), QStringLiteral("No project."));
+    }
+    QJsonArray arr;
+    for (const QString &binId : m_core->projectItemModel()->getAllClipIds()) {
+        std::shared_ptr<ProjectClip> clip = m_core->projectItemModel()->getClipByBinID(binId);
+        if (!clip) continue;
+        // НЕ звать frameDuration() на неготовом продюсере — он блокирует (дедлок).
+        const bool ready = clip->statusReady();
+        arr.append(QJsonObject{
+            {QStringLiteral("bin_id"), binId},
+            {QStringLiteral("name"), clip->clipName()},
+            {QStringLiteral("url"), clip->url()},
+            {QStringLiteral("ready"), ready},
+            {QStringLiteral("duration_frames"), ready ? int(clip->frameDuration()) : -1},
+        });
+    }
+    return GatewayProtocol::successResponse(QStringLiteral("list_bin"), requestId, projectId(), timelineRevision(),
+        QJsonObject{{QStringLiteral("count"), arr.size()}, {QStringLiteral("clips"), arr}});
+}
