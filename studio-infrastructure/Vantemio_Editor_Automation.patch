+// split_clip — разрезать клип в точке (position в кадрах/секундах; clip_id или track_id).
+QString GatewayService::handleSplitClip(const QString &requestId, const QJsonObject &params)
+{
+    auto tl = currentTimelineModel();
+    if (!tl) {
+        return GatewayProtocol::errorResponse(QStringLiteral("split_clip"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("timeline_unavailable"), QStringLiteral("Active timeline is not available."));
+    }
+    const double fps = m_core ? m_core->getCurrentFps() : 25.0;
+    const int pos = params.contains(QStringLiteral("position")) ? params.value(QStringLiteral("position")).toInt()
+                                                               : int(params.value(QStringLiteral("seconds")).toDouble() * fps);
+    int clipId = params.value(QStringLiteral("clip_id")).toInt(-1);
+    if (!tl->isClip(clipId)) {
+        const int trackId = params.value(QStringLiteral("track_id")).toInt(-1);
+        clipId = tl->isTrack(trackId) ? tl->getClipByPosition(trackId, pos) : -1;
+    }
+    if (clipId < 0) {
+        return GatewayProtocol::errorResponse(QStringLiteral("split_clip"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("clip_not_found"), QStringLiteral("Нет клипа (дай clip_id или track_id+position)."));
+    }
+    const bool ok = TimelineFunctions::requestClipCut(tl, clipId, pos);
+    if (!ok) {
+        return GatewayProtocol::errorResponse(QStringLiteral("split_clip"), requestId, projectId(), timelineRevision(),
+            QStringLiteral("split_failed"), QStringLiteral("Не удалось разрезать (позиция вне клипа?)."));
+    }
+    ++m_timelineRevision;
+    return GatewayProtocol::successResponse(QStringLiteral("split_clip"), requestId, projectId(), timelineRevision(),
+        QJsonObject{{QStringLiteral("clip_id"), clipId}, {QStringLiteral("position"), pos}});
+}
