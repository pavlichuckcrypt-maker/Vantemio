+QString GatewayService::handleSetUiWorkspaceState(const QString &requestId, const QJsonObject &params)
+{
+    if (m_core == nullptr || m_core->window() == nullptr) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("set_ui_workspace_state"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("ui_root_unavailable"),
+            QStringLiteral("MainWindow is not available.")
+        );
+    }
+
+    bool changed = false;
+    if (params.contains(QStringLiteral("show_title_bars"))) {
+        const bool showTitleBars = params.value(QStringLiteral("show_title_bars")).toBool(KdenliveSettings::showtitlebars());
+        if (KdenliveSettings::showtitlebars() != showTitleBars) {
+            KdenliveSettings::setShowtitlebars(showTitleBars);
+            Q_EMIT m_core->hideBars(!showTitleBars);
+            changed = true;
+        }
+    }
+
+    if (params.contains(QStringLiteral("tabs_at_bottom"))) {
+        const bool tabsAtBottom = params.value(QStringLiteral("tabs_at_bottom")).toBool(KDDockWidgets::Config::self().tabsAtBottom());
+        if (KDDockWidgets::Config::self().tabsAtBottom() != tabsAtBottom) {
+            KDDockWidgets::Config::self().setTabsAtBottom(tabsAtBottom);
+            KdenliveSettings::setTabposition(tabsAtBottom ? 1 : 0);
+            changed = true;
+        }
+    }
+
+    if (params.contains(QStringLiteral("main_window_full_screen"))) {
+        QAction *fullscreenAction = m_core->window()->actionCollection() != nullptr ? m_core->window()->actionCollection()->action(QStringLiteral("fullscreen")) : nullptr;
+        if (fullscreenAction == nullptr || !fullscreenAction->isCheckable()) {
+            return GatewayProtocol::errorResponse(
+                QStringLiteral("set_ui_workspace_state"),
+                requestId,
+                projectId(),
+                timelineRevision(),
+                QStringLiteral("fullscreen_action_unavailable"),
+                QStringLiteral("Main window fullscreen action is not available.")
+            );
+        }
+        const bool requestedFullScreen = params.value(QStringLiteral("main_window_full_screen")).toBool(m_core->window()->isFullScreen());
+        if (fullscreenAction->isChecked() != requestedFullScreen) {
+            fullscreenAction->trigger();
+            changed = true;
+        }
+    }
+
+    if (changed) {
+        ++m_timelineRevision;
+    }
+
+    return GatewayProtocol::successResponse(
+        QStringLiteral("set_ui_workspace_state"),
+        requestId,
+        projectId(),
+        timelineRevision(),
+        serializeUiWorkspaceState(m_core)
+    );
+}
