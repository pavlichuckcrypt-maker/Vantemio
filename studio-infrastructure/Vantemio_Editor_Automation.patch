+QJsonObject serializeUndoHistoryState(const std::shared_ptr<DocUndoStack> &stack, const QUndoView *view, const KDDockWidgets::QtWidgets::DockWidget *dock)
+{
+    QJsonArray entries;
+    const int count = stack ? stack->count() : 0;
+    const int index = stack ? stack->index() : 0;
+    for (int i = 0; i < count; ++i) {
+        const QUndoCommand *command = stack->command(i);
+        entries.push_back(QJsonObject{
+            {QStringLiteral("command_index"), i + 1},
+            {QStringLiteral("text"), command != nullptr ? command->text() : QString()},
+            {QStringLiteral("is_current"), i + 1 == index}
+        });
+    }
+
+    return QJsonObject{
+        {QStringLiteral("undo_history_open"), dock != nullptr ? dock->isOpen() : false},
+        {QStringLiteral("undo_history_view_visible"), view != nullptr ? view->isVisible() : false},
+        {QStringLiteral("undo_count"), count},
+        {QStringLiteral("undo_index"), index},
+        {QStringLiteral("current_command_index"), index > 0 ? index - 1 : -1},
+        {QStringLiteral("can_undo"), stack ? stack->canUndo() : false},
+        {QStringLiteral("can_redo"), stack ? stack->canRedo() : false},
+        {QStringLiteral("is_clean"), stack ? stack->isClean() : true},
+        {QStringLiteral("clean_index"), stack ? stack->cleanIndex() : 0},
+        {QStringLiteral("undo_text"), stack ? stack->undoText() : QString()},
+        {QStringLiteral("redo_text"), stack ? stack->redoText() : QString()},
+        {QStringLiteral("entries"), entries}
+    };
+}
