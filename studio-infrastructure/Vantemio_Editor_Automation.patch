+QString GatewayService::handleTriggerUiAction(const QString &requestId, const QString &actionName, bool hasCheckedState, bool checkedState)
+{
+    if (actionName.trimmed().isEmpty() || m_core == nullptr || m_core->window() == nullptr) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("trigger_ui_action"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("invalid_parameters"),
+            QStringLiteral("trigger_ui_action requires action_name and an available MainWindow.")
+        );
+    }
+
+    QAction *action = findUiAction(m_core->window(), actionName);
+    if (action == nullptr) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("trigger_ui_action"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("action_not_found"),
+            QStringLiteral("Requested UI action was not found.")
+        );
+    }
+    if (!action->isEnabled()) {
+        return GatewayProtocol::errorResponse(
+            QStringLiteral("trigger_ui_action"),
+            requestId,
+            projectId(),
+            timelineRevision(),
+            QStringLiteral("action_disabled"),
+            QStringLiteral("Requested UI action is currently disabled.")
+        );
+    }
+
+    if (action->isCheckable() && hasCheckedState) {
+        if (action->isChecked() != checkedState) {
+            action->trigger();
+        }
+    } else {
+        action->trigger();
+    }
+
+    ++m_timelineRevision;
+    return GatewayProtocol::successResponse(
+        QStringLiteral("trigger_ui_action"),
+        requestId,
+        projectId(),
+        timelineRevision(),
+        QJsonObject{
+            {QStringLiteral("action_name"), automationIdForObject(action)},
+            {QStringLiteral("object_name"), action->objectName()},
+            {QStringLiteral("checked"), action->isChecked()},
+            {QStringLiteral("enabled"), action->isEnabled()}
+        }
+    );
+}
